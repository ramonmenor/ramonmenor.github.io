---
import BaseHead from "../../components/BaseHead.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { SITE_TITLE } from "../../consts";
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead
      title={`Convertidor de Colores & Contraste — ${SITE_TITLE}`}
      description="Convierte instantáneamente entre HEX, RGB y HSL, calcula ratios de contraste WCAG y genera paletas armonizadas."
    />
  </head>
  <body class="bg-white text-slate-900 min-h-screen flex flex-col font-sans">
    <Navbar currentPath="/tools/colores" />

    <main class="w-full max-w-5xl mx-auto px-4 sm:px-6 py-10 flex-1">
      {/* Header */}
      <div class="mb-8">
        <a href="/" class="inline-flex items-center gap-1.5 text-xs font-mono text-slate-500 hover:text-blue-600 transition-colors mb-4">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
          Volver a Herramientas
        </a>
        <div class="flex items-center gap-3">
          <span class="w-10 h-10 rounded-xl bg-pink-50 text-pink-600 flex items-center justify-center text-lg font-mono font-bold border border-pink-100">
            🎨
          </span>
          <div>
            <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">Convertidor de Colores & Contraste</h1>
            <p class="text-sm text-slate-500">Conversión bidireccional entre formatos HEX, RGB, HSL y verificación de accesibilidad.</p>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        {/* Left: Interactive Picker & Preview */}
        <div class="clean-card p-6 bg-slate-50/50 flex flex-col items-center text-center">
          <div id="colorPreviewBox" class="w-full h-44 rounded-2xl shadow-inner mb-4 border border-slate-300 flex items-center justify-center transition-colors duration-200" style="background-color: #2563eb;">
            <span id="previewText" class="text-white font-mono font-bold text-lg drop-shadow-sm">#2563eb</span>
          </div>

          <div class="w-full flex items-center gap-3 mb-6">
            <input type="color" id="nativeColorPicker" value="#2563eb" class="w-12 h-12 rounded-xl cursor-pointer border border-slate-300 p-1 bg-white" />
            <input
              type="text"
              id="hexInput"
              value="#2563eb"
              class="w-full px-3 py-2 bg-white border border-slate-300 rounded-xl font-mono text-sm uppercase font-bold text-slate-900 focus:outline-none focus:border-blue-500"
            />
          </div>

          {/* Quick Preset Colors */}
          <div class="w-full text-left">
            <span class="block text-xs font-mono text-slate-500 mb-2">Colores rápidos:</span>
            <div class="flex flex-wrap gap-2">
              <button type="button" class="preset-color w-7 h-7 rounded-lg border border-slate-300" style="background: #2563eb;" data-color="#2563eb"></button>
              <button type="button" class="preset-color w-7 h-7 rounded-lg border border-slate-300" style="background: #0ea5e9;" data-color="#0ea5e9"></button>
              <button type="button" class="preset-color w-7 h-7 rounded-lg border border-slate-300" style="background: #10b981;" data-color="#10b981"></button>
              <button type="button" class="preset-color w-7 h-7 rounded-lg border border-slate-300" style="background: #8b5cf6;" data-color="#8b5cf6"></button>
              <button type="button" class="preset-color w-7 h-7 rounded-lg border border-slate-300" style="background: #f43f5e;" data-color="#f43f5e"></button>
              <button type="button" class="preset-color w-7 h-7 rounded-lg border border-slate-300" style="background: #f59e0b;" data-color="#f59e0b"></button>
              <button type="button" class="preset-color w-7 h-7 rounded-lg border border-slate-300" style="background: #0f172a;" data-color="#0f172a"></button>
            </div>
          </div>
        </div>

        {/* Right 2 cols: Values & Contrast */}
        <div class="lg:col-span-2 space-y-6">
          {/* Format values */}
          <div class="clean-card p-6 bg-slate-50/50">
            <h2 class="text-sm font-mono font-bold uppercase text-slate-500 mb-4 pb-2 border-b border-slate-200">
              Formatos de Color
            </h2>

            <div class="space-y-3 font-mono text-xs">
              <div class="p-3 bg-white border border-slate-200 rounded-xl flex items-center justify-between">
                <div>
                  <span class="text-slate-500 block text-[10px]">HEXADECIMAL</span>
                  <span id="valHex" class="font-bold text-slate-900 text-sm">#2563EB</span>
                </div>
                <button type="button" class="copy-val-btn px-2.5 py-1 rounded bg-slate-100 hover:bg-slate-200 text-slate-700 font-sans text-xs" data-target="valHex">Copiar</button>
              </div>

              <div class="p-3 bg-white border border-slate-200 rounded-xl flex items-center justify-between">
                <div>
                  <span class="text-slate-500 block text-[10px]">RGB</span>
                  <span id="valRgb" class="font-bold text-slate-900 text-sm">rgb(37, 99, 235)</span>
                </div>
                <button type="button" class="copy-val-btn px-2.5 py-1 rounded bg-slate-100 hover:bg-slate-200 text-slate-700 font-sans text-xs" data-target="valRgb">Copiar</button>
              </div>

              <div class="p-3 bg-white border border-slate-200 rounded-xl flex items-center justify-between">
                <div>
                  <span class="text-slate-500 block text-[10px]">HSL</span>
                  <span id="valHsl" class="font-bold text-slate-900 text-sm">hsl(221, 83%, 53%)</span>
                </div>
                <button type="button" class="copy-val-btn px-2.5 py-1 rounded bg-slate-100 hover:bg-slate-200 text-slate-700 font-sans text-xs" data-target="valHsl">Copiar</button>
              </div>

              <div class="p-3 bg-white border border-slate-200 rounded-xl flex items-center justify-between">
                <div>
                  <span class="text-slate-500 block text-[10px]">CSS VARIABLE</span>
                  <span id="valCss" class="font-bold text-slate-900 text-sm">--color-primary: #2563eb;</span>
                </div>
                <button type="button" class="copy-val-btn px-2.5 py-1 rounded bg-slate-100 hover:bg-slate-200 text-slate-700 font-sans text-xs" data-target="valCss">Copiar</button>
              </div>
            </div>
          </div>

          {/* Contrast & Accessibility */}
          <div class="clean-card p-6 bg-slate-50/50">
            <h2 class="text-sm font-mono font-bold uppercase text-slate-500 mb-4 pb-2 border-b border-slate-200">
              Accesibilidad & Contraste (WCAG)
            </h2>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div id="whiteContrastBox" class="p-4 rounded-xl text-center border transition-colors" style="background-color: #2563eb; color: #ffffff;">
                <span class="text-sm font-bold block mb-1">Texto Blanco</span>
                <span id="ratioWhite" class="text-xs font-mono font-bold block">Ratio: 4.8:1</span>
                <span id="badgeWhite" class="inline-block mt-2 px-2 py-0.5 rounded text-[10px] font-mono bg-white/20 text-white font-bold">Pasa AA</span>
              </div>

              <div id="blackContrastBox" class="p-4 rounded-xl text-center border transition-colors" style="background-color: #2563eb; color: #000000;">
                <span class="text-sm font-bold block mb-1">Texto Negro</span>
                <span id="ratioBlack" class="text-xs font-mono font-bold block">Ratio: 4.3:1</span>
                <span id="badgeBlack" class="inline-block mt-2 px-2 py-0.5 rounded text-[10px] font-mono bg-black/20 text-black font-bold">Pasa AA Grande</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>

    <Footer />

    <script>
      const nativeColorPicker = document.getElementById('nativeColorPicker') as HTMLInputElement;
      const hexInput = document.getElementById('hexInput') as HTMLInputElement;
      const colorPreviewBox = document.getElementById('colorPreviewBox');
      const previewText = document.getElementById('previewText');

      const valHex = document.getElementById('valHex');
      const valRgb = document.getElementById('valRgb');
      const valHsl = document.getElementById('valHsl');
      const valCss = document.getElementById('valCss');

      const whiteContrastBox = document.getElementById('whiteContrastBox');
      const blackContrastBox = document.getElementById('blackContrastBox');
      const ratioWhite = document.getElementById('ratioWhite');
      const ratioBlack = document.getElementById('ratioBlack');
      const badgeWhite = document.getElementById('badgeWhite');
      const badgeBlack = document.getElementById('badgeBlack');

      function hexToRgb(hex: string) {
        let c = hex.replace('#', '');
        if (c.length === 3) {
          c = c.split('').map(char => char + char).join('');
        }
        const num = parseInt(c, 16);
        return {
          r: (num >> 16) & 255,
          g: (num >> 8) & 255,
          b: num & 255
        };
      }

      function rgbToHsl(r: number, g: number, b: number) {
        r /= 255; g /= 255; b /= 255;
        const max = Math.max(r, g, b), min = Math.min(r, g, b);
        let h = 0, s = 0, l = (max + min) / 2;

        if (max !== min) {
          const d = max - min;
          s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
          switch (max) {
            case r: h = (g - b) / d + (g < b ? 6 : 0); break;
            case g: h = (b - r) / d + 2; break;
            case b: h = (r - g) / d + 4; break;
          }
          h /= 6;
        }
        return {
          h: Math.round(h * 360),
          s: Math.round(s * 100),
          l: Math.round(l * 100)
        };
      }

      function getLuminance(r: number, g: number, b: number) {
        const a = [r, g, b].map(v => {
          v /= 255;
          return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
        });
        return a[0] * 0.2126 + a[1] * 0.7152 + a[2] * 0.0722;
      }

      function getContrastRatio(lum1: number, lum2: number) {
        const brighter = Math.max(lum1, lum2);
        const darker = Math.min(lum1, lum2);
        return (brighter + 0.05) / (darker + 0.05);
      }

      function updateColor(hex: string) {
        if (!hex.startsWith('#')) hex = '#' + hex;
        if (!/^#([0-9A-Fa-f]{3}){1,2}$/.test(hex)) return;

        const rgb = hexToRgb(hex);
        const hsl = rgbToHsl(rgb.r, rgb.g, rgb.b);

        if (colorPreviewBox) colorPreviewBox.style.backgroundColor = hex;
        if (previewText) previewText.textContent = hex.toLowerCase();
        if (nativeColorPicker) nativeColorPicker.value = hex;
        if (hexInput && hexInput !== document.activeElement) hexInput.value = hex;

        if (valHex) valHex.textContent = hex.toUpperCase();
        if (valRgb) valRgb.textContent = `rgb(${rgb.r}, ${rgb.g}, ${rgb.b})`;
        if (valHsl) valHsl.textContent = `hsl(${hsl.h}, ${hsl.s}%, ${hsl.l}%)`;
        if (valCss) valCss.textContent = `--color-brand: ${hex.toLowerCase()};`;

        // Contrast calculation
        const lum = getLuminance(rgb.r, rgb.g, rgb.b);
        const lumWhite = getLuminance(255, 255, 255);
        const lumBlack = getLuminance(0, 0, 0);

        const cWhite = getContrastRatio(lum, lumWhite);
        const cBlack = getContrastRatio(lum, lumBlack);

        if (whiteContrastBox) whiteContrastBox.style.backgroundColor = hex;
        if (blackContrastBox) blackContrastBox.style.backgroundColor = hex;

        if (ratioWhite) ratioWhite.textContent = `Ratio: ${cWhite.toFixed(2)}:1`;
        if (ratioBlack) ratioBlack.textContent = `Ratio: ${cBlack.toFixed(2)}:1`;

        if (badgeWhite) {
          badgeWhite.textContent = cWhite >= 7 ? 'Pasa AAA' : cWhite >= 4.5 ? 'Pasa AA' : cWhite >= 3 ? 'Pasa AA Grande' : 'Falla WCAG';
          badgeWhite.className = `inline-block mt-2 px-2 py-0.5 rounded text-[10px] font-mono font-bold ${cWhite >= 4.5 ? 'bg-emerald-500 text-white' : 'bg-red-500/80 text-white'}`;
        }

        if (badgeBlack) {
          badgeBlack.textContent = cBlack >= 7 ? 'Pasa AAA' : cBlack >= 4.5 ? 'Pasa AA' : cBlack >= 3 ? 'Pasa AA Grande' : 'Falla WCAG';
          badgeBlack.className = `inline-block mt-2 px-2 py-0.5 rounded text-[10px] font-mono font-bold ${cBlack >= 4.5 ? 'bg-emerald-500 text-white' : 'bg-red-500/80 text-white'}`;
        }
      }

      nativeColorPicker?.addEventListener('input', (e: any) => updateColor(e.target.value));
      hexInput?.addEventListener('input', (e: any) => updateColor(e.target.value));

      document.querySelectorAll('.preset-color').forEach(btn => {
        btn.addEventListener('click', () => {
          const col = btn.getAttribute('data-color');
          if (col) updateColor(col);
        });
      });

      document.querySelectorAll('.copy-val-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const targetId = btn.getAttribute('data-target');
          if (targetId) {
            const el = document.getElementById(targetId);
            if (el?.textContent) {
              navigator.clipboard.writeText(el.textContent);
              btn.textContent = '¡Copiado!';
              setTimeout(() => { btn.textContent = 'Copiar'; }, 1500);
            }
          }
        });
      });

      updateColor('#2563eb');
    </script>
  </body>
</html>
