---
import BaseHead from "../../components/BaseHead.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { SITE_TITLE } from "../../consts";
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead
      title={`Formateador SQL — ${SITE_TITLE}`}
      description="Herramienta rápida para formatear, indentar y embellecer consultas SQL."
    />
  </head>
  <body class="bg-white text-slate-900 min-h-screen flex flex-col font-sans">
    <Navbar currentPath="/tools/sql" />

    <main class="w-full max-w-5xl mx-auto px-4 sm:px-6 py-10 flex-1">
      {/* Header */}
      <div class="mb-8">
        <a href="/" class="inline-flex items-center gap-1.5 text-xs font-mono text-slate-500 hover:text-blue-600 transition-colors mb-4">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
          Volver a Herramientas
        </a>
        <div class="flex items-center gap-3">
          <span class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-lg font-mono font-bold border border-blue-100">
            SQL
          </span>
          <div>
            <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">Formateador SQL</h1>
            <p class="text-sm text-slate-500">Convierte consultas desordenadas en SQL limpio, estructurado y con mayúsculas estándar.</p>
          </div>
        </div>
      </div>

      {/* Toolbar */}
      <div class="flex flex-wrap items-center justify-between gap-3 mb-4 p-3 bg-slate-50 border border-slate-200 rounded-xl">
        <div class="flex flex-wrap items-center gap-2">
          <button id="formatBtn" type="button" class="px-3.5 py-1.5 rounded-lg bg-blue-600 text-white font-medium text-xs hover:bg-blue-700 transition-colors shadow-sm flex items-center gap-1.5">
            <span>✨ Formatear SQL</span>
          </button>
          <button id="uppercaseBtn" type="button" class="px-3 py-1.5 rounded-lg bg-white border border-slate-300 text-slate-700 font-medium text-xs hover:border-slate-400 transition-colors">
            Palabras Clave MAYÚSCULAS
          </button>
          <button id="minifyBtn" type="button" class="px-3 py-1.5 rounded-lg bg-white border border-slate-300 text-slate-700 font-medium text-xs hover:border-slate-400 transition-colors">
            Una sola línea (Minify)
          </button>
          <button id="sampleBtn" type="button" class="px-3 py-1.5 rounded-lg bg-white border border-slate-300 text-slate-700 font-medium text-xs hover:border-slate-400 transition-colors">
            Cargar ejemplo
          </button>
          <button id="clearBtn" type="button" class="px-3 py-1.5 rounded-lg bg-white border border-slate-300 text-slate-600 font-medium text-xs hover:text-red-600 hover:border-red-300 transition-colors">
            Limpiar
          </button>
        </div>

        <button id="copyBtn" type="button" class="px-3.5 py-1.5 rounded-lg bg-slate-900 text-white font-medium text-xs hover:bg-slate-800 transition-colors flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
          <span id="copyBtnText">Copiar</span>
        </button>
      </div>

      {/* Editor & Viewer */}
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
        {/* Input */}
        <div class="flex flex-col">
          <div class="flex items-center justify-between text-xs text-slate-500 font-mono mb-1.5 px-1">
            <span>Consulta SQL Original</span>
            <span id="inputStats">0 caracteres</span>
          </div>
          <textarea
            id="sqlInput"
            placeholder="Pega aquí tu consulta SQL (SELECT, INSERT, UPDATE, CREATE TABLE...)..."
            class="w-full h-[450px] p-4 font-mono text-xs text-slate-800 bg-slate-50/50 border border-slate-200 rounded-xl focus:outline-none focus:bg-white focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all resize-y"
            spellcheck="false"
          ></textarea>
        </div>

        {/* Output */}
        <div class="flex flex-col">
          <div class="flex items-center justify-between text-xs text-slate-500 font-mono mb-1.5 px-1">
            <span>SQL Formateado</span>
            <span class="font-mono text-emerald-600 text-xs">Formato Estándar</span>
          </div>
          <div class="relative w-full h-[450px] bg-slate-900 text-slate-100 rounded-xl p-4 overflow-auto border border-slate-800 font-mono text-xs">
            <pre id="sqlOutput" class="whitespace-pre-wrap break-all leading-relaxed text-slate-200">// El SQL formateado aparecerá aquí...</pre>
          </div>
        </div>
      </div>
    </main>

    <Footer />

    <script>
      const sqlInput = document.getElementById('sqlInput') as HTMLTextAreaElement;
      const sqlOutput = document.getElementById('sqlOutput') as HTMLPreElement;
      const formatBtn = document.getElementById('formatBtn');
      const uppercaseBtn = document.getElementById('uppercaseBtn');
      const minifyBtn = document.getElementById('minifyBtn');
      const sampleBtn = document.getElementById('sampleBtn');
      const clearBtn = document.getElementById('clearBtn');
      const copyBtn = document.getElementById('copyBtn');
      const copyBtnText = document.getElementById('copyBtnText');
      const inputStats = document.getElementById('inputStats');

      const sampleSql = `select u.id, u.nombre, u.email, count(p.id) as total_pedidos, sum(p.total) as importe_total from usuarios u left join pedidos p on u.id = p.usuario_id where u.activo = 1 and p.fecha >= '2026-01-01' group by u.id, u.nombre, u.email having total_pedidos > 0 order by importe_total desc limit 20;`;

      const keywords = [
        'SELECT', 'FROM', 'WHERE', 'AND', 'OR', 'LEFT JOIN', 'RIGHT JOIN', 'INNER JOIN', 'FULL JOIN', 'JOIN',
        'ON', 'GROUP BY', 'HAVING', 'ORDER BY', 'LIMIT', 'OFFSET', 'UNION ALL', 'UNION',
        'INSERT INTO', 'VALUES', 'UPDATE', 'SET', 'DELETE FROM', 'CREATE TABLE', 'ALTER TABLE',
        'DROP TABLE', 'AS', 'IN', 'NOT IN', 'BETWEEN', 'LIKE', 'IS NULL', 'IS NOT NULL',
        'COUNT', 'SUM', 'AVG', 'MIN', 'MAX', 'CASE', 'WHEN', 'THEN', 'ELSE', 'END', 'DESC', 'ASC',
        'PRIMARY KEY', 'FOREIGN KEY', 'REFERENCES', 'DEFAULT', 'NOT NULL'
      ];

      function updateStats() {
        if (inputStats && sqlInput) {
          inputStats.textContent = `${sqlInput.value.length.toLocaleString()} caracteres`;
        }
      }

      function formatSql(forceUppercase = true) {
        let text = sqlInput.value.trim();
        if (!text) {
          if (sqlOutput) sqlOutput.textContent = '// El SQL formateado aparecerá aquí...';
          return;
        }

        // Clean extra whitespace
        text = text.replace(/\s+/g, ' ');

        // Capitalize keywords
        keywords.forEach(kw => {
          const regex = new RegExp(`\\b${kw}\\b`, 'gi');
          text = text.replace(regex, kw);
        });

        // Add line breaks before major query clauses
        const majorClauses = [
          'SELECT', 'FROM', 'WHERE', 'AND', 'OR', 'LEFT JOIN', 'RIGHT JOIN', 'INNER JOIN', 'FULL JOIN',
          'JOIN', 'GROUP BY', 'HAVING', 'ORDER BY', 'LIMIT', 'OFFSET', 'UNION', 'INSERT INTO', 'VALUES',
          'UPDATE', 'SET', 'DELETE FROM'
        ];

        majorClauses.forEach(clause => {
          const regex = new RegExp(`\\s+(${clause})\\s+`, 'g');
          text = text.replace(regex, `\n$1 `);
        });

        // Format commas in SELECT list
        text = text.replace(/,\s*/g, ',\n  ');

        if (sqlOutput) sqlOutput.textContent = text;
      }

      function minifySql() {
        let text = sqlInput.value.trim();
        if (!text) return;
        text = text.replace(/\s+/g, ' ');
        if (sqlOutput) sqlOutput.textContent = text;
      }

      sqlInput?.addEventListener('input', () => {
        updateStats();
        formatSql();
      });

      formatBtn?.addEventListener('click', () => formatSql(true));
      uppercaseBtn?.addEventListener('click', () => formatSql(true));
      minifyBtn?.addEventListener('click', minifySql);

      sampleBtn?.addEventListener('click', () => {
        sqlInput.value = sampleSql;
        updateStats();
        formatSql();
      });

      clearBtn?.addEventListener('click', () => {
        sqlInput.value = '';
        updateStats();
        formatSql();
      });

      copyBtn?.addEventListener('click', () => {
        const text = sqlOutput?.textContent || '';
        if (text && !text.startsWith('//')) {
          navigator.clipboard.writeText(text).then(() => {
            if (copyBtnText) copyBtnText.textContent = '¡Copiado!';
            setTimeout(() => {
              if (copyBtnText) copyBtnText.textContent = 'Copiar';
            }, 1500);
          });
        }
      });
    </script>
  </body>
</html>
