---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="es">
<head>
  <BaseHead title={`Sobre mí | ${SITE_TITLE}`} description="Sobre Ramón Menor — desarrollador Full Stack con más de 10 años de experiencia." />
</head>
  <body class="bg-background text-foreground min-h-screen flex flex-col">
  <Header title={SITE_TITLE} currentPath="/about" />
  <main class="flex-1 w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 relative">
    <div class="fixed top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-neon-cyan/10 rounded-full blur-[150px] -z-10 pointer-events-none" aria-hidden="true"></div>

    <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-8 text-center animate-on-scroll">
      Sobre <span class="text-neon-cyan">mí</span>
    </h1>

    <section class="mb-10 animate-on-scroll">
      <h2 class="text-2xl font-bold mb-4 flex items-center gap-3">
        <span class="w-8 h-1 bg-neon-cyan rounded-full"></span>
        Experiencia Profesional
      </h2>
      <p class="text-muted-foreground leading-relaxed">
        Desde el año 2006 trabajo en el sector del desarrollo de software, con paso por diversas empresas y proyectos. Mi trayectoria profesional me ha permitido sumergirme en diferentes desafíos, contribuyendo al crecimiento y éxito de cada equipo en el que he participado.
      </p>
    </section>

    <section class="mb-10 animate-on-scroll">
      <h2 class="text-2xl font-bold mb-4 flex items-center gap-3">
        <span class="w-8 h-1 bg-neon-magenta rounded-full"></span>
        Perfil Técnico
      </h2>
      <p class="text-muted-foreground mb-4 leading-relaxed">
        Soy un apasionado desarrollador de software especializado en varias tecnologías clave:
      </p>
      <ul class="space-y-4">
          <li class="bg-card border border-border rounded-xl p-4">
            <strong class="text-neon-cyan">Lenguajes de Programación:</strong>
            <ul class="mt-2 ml-4 space-y-1 text-sm text-muted-foreground">
              <li>• <strong>PHP:</strong> Aplicaciones web robustas y eficientes</li>
              <li>• <strong>JavaScript:</strong> Aplicaciones interactivas y dinámicas</li>
            </ul>
          </li>
          <li class="bg-card border border-border rounded-xl p-4">
            <strong class="text-neon-cyan">Tecnologías Web:</strong>
            <ul class="mt-2 ml-4 space-y-1 text-sm text-muted-foreground">
              <li>• <strong>HTML5:</strong> Estructuras sólidas para páginas web</li>
              <li>• <strong>CSS3:</strong> Diseño y estilización visual atractiva</li>
            </ul>
          </li>
          <li class="bg-card border border-border rounded-xl p-4">
            <strong class="text-neon-cyan">Administración de Servidores:</strong>
            <ul class="mt-2 ml-4 space-y-1 text-sm text-muted-foreground">
              <li>• Servidores Linux: Creación y mantenimiento</li>
              <li>• Máquinas Virtuales: Configuración y gestión</li>
              <li>• Docker: Implementación y mantenimiento</li>
            </ul>
          </li>
          <li class="bg-card border border-border rounded-xl p-4">
            <strong class="text-neon-cyan">Dominios y Alojamiento Web:</strong>
            <ul class="mt-2 ml-4 space-y-1 text-sm text-muted-foreground">
              <li>• Registro y gestión de dominios</li>
              <li>• Alojamiento web: Configuración y mantenimiento</li>
            </ul>
          </li>
        </ul>
      </section>
    </main>
  <Footer />

  <script>
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) entry.target.classList.add("is-visible");
        });
      },
      { threshold: 0.1, rootMargin: "0px 0px -50px 0px" }
    );
    document.querySelectorAll(".animate-on-scroll").forEach((el) => observer.observe(el));
  </script>
</body>
</html>
