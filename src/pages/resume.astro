---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE } from "../consts";

const experiences = [
  {
    company: "The Red Kiwi S.L.",
    location: "Valencia",
    period: "Julio de 2016 - Actualidad",
    description:
      "Trabajo en el desarrollo de plataforma web para las gestión de clínicas de estética y medicina (con HTML5, CSS, PHP y JavaScript).\nLlevo la administración de los servidores (Debian) en un cloud.\nPara la creación de la plataforma hemos utilizado el framework Yii2, y servidores MySQL.\nInterconexión de centros mediante VPN.\nVirtualización de servidores VMware mediante vSphere.",
  },
  {
    company: "Publitooth Comunicaciones",
    location: "Gandia",
    period: "2012 - Junio de 2016",
    description:
      "Trabajo de responsable de desarrollo de páginas web (con HTML5, CSS, PHP y JavaScript) así como del mantenimiento de los equipos informáticos tanto clientes como servidores.\nTambién desarrollamos aplicaciones front-end y back-end para diferentes sistemas de gestión, utilizando el framework Yii y Yii2.",
  },
  {
    company: "Infocaudete",
    location: "Caudete – Albacete",
    period: "Durante cinco años",
    description:
      "He dirigido mi propia empresa dedicada a la venta y soporte de material informático para particulares y empresas.",
  },
  {
    company: "Varias Empresas",
    location: "Alcoy – Alicante",
    period: "Durante 2 años",
    description:
      "Trabajos varios como limpieza de locales y transporte de mercancías.",
  },
  {
    company: "Atecor",
    location: "Alicante",
    period: "Un año",
    description:
      "Técnico en reparación de equipos informáticos, servicios a empresas.",
  },
];
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead
      title={`Currículum | ${SITE_TITLE}`}
      description="Currículum Vitae de Ramón Menor"
    />
  </head>
  <body class="bg-white text-gray-900 dark:bg-[#0a0a0a] dark:text-gray-100 min-h-screen flex flex-col">
    <Header title={SITE_TITLE} currentPath="/resume" />
    <main
      class="flex-1 w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 relative"
    >
      {/* Background glowing effect */}
      <div
        class="fixed top-0 left-0 w-full h-full overflow-hidden -z-10 pointer-events-none"
      >
        <div
          class="absolute top-[-10%] right-[-5%] w-[500px] h-[500px] bg-indigo-100 dark:bg-indigo-900/20 rounded-full blur-[120px]"
        >
        </div>
      </div>

      <div class="flex flex-col md:flex-row gap-12 items-start">
        {/* Sidebar Profile */}
        <aside
          class="w-full md:w-1/3 bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 rounded-2xl p-6 backdrop-blur-sm sticky top-24 shadow-sm dark:shadow-none"
        >
          <div
            class="aspect-square w-48 mx-auto rounded-2xl overflow-hidden mb-6 border border-gray-200 dark:border-white/20 shadow-md"
          >
            <div
              class="w-full h-full bg-gradient-to-tr from-indigo-500 to-purple-500 flex items-center justify-center text-4xl font-bold"
            >
              RM
            </div>
          </div>

          <h1 class="text-2xl font-bold text-center mb-1">
            Ramón Menor Molina
          </h1>
          <p class="text-center text-indigo-600 dark:text-indigo-400 font-medium mb-6">
            Desarrollador Full Stack
          </p>

          <div class="space-y-4 text-sm text-gray-600 dark:text-gray-300">
            <div class="flex flex-col">
              <span
                class="text-gray-400 dark:text-gray-500 uppercase tracking-wider text-xs font-semibold mb-1"
                >Email</span
              >
              <a
                href="mailto:ramonmenor@gmail.com"
                class="text-indigo-600 dark:text-indigo-400 hover:text-indigo-500 transition-colors"
                >ramonmenor@gmail.com</a
              >
            </div>
            <div class="flex flex-col">
              <span
                class="text-gray-400 dark:text-gray-500 uppercase tracking-wider text-xs font-semibold mb-1"
                >Web</span
              >
              <a
                href="https://www.ramonmenor.es"
                class="text-indigo-600 dark:text-indigo-400 hover:text-indigo-500 transition-colors">www.ramonmenor.es</a
              >
            </div>
            <div class="flex flex-col">
              <span
                class="text-gray-400 dark:text-gray-500 uppercase tracking-wider text-xs font-semibold mb-1"
                >Nacimiento</span
              >
              <span>25 Enero 1977</span>
            </div>
          </div>
        </aside>

        {/* Main Content */}
        <div class="w-full md:w-2/3 space-y-12">
          <section>
            <h2 class="text-3xl font-bold mb-8 flex items-center gap-3">
              <span class="w-8 h-1 bg-indigo-500 rounded-full"></span>
              Experiencia Laboral
            </h2>

            <div class="space-y-10 border-l border-gray-200 dark:border-white/10 ml-3 pl-6">
              {
                experiences.map((exp) => (
                  <div class="relative">
                    <span class="absolute -left-[31px] bg-white dark:bg-[#0a0a0a] p-1">
                      <span class="flex w-3 h-3 bg-indigo-500 rounded-full shadow-[0_0_10px_rgba(99,102,241,0.5)]" />
                    </span>

                    <div class="flex flex-col sm:flex-row sm:items-baseline justify-between mb-2 gap-2">
                      <h3 class="text-xl font-bold text-gray-900 dark:text-white">
                        {exp.company}
                      </h3>
                      <span class="text-sm font-medium px-3 py-1 bg-gray-100 dark:bg-white/10 text-indigo-600 dark:text-indigo-300 rounded-full inline-flex w-fit">
                        {exp.period}
                      </span>
                    </div>
                    <p class="text-indigo-600 dark:text-indigo-400 text-sm mb-3">{exp.location}</p>

                    <div class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed space-y-2">
                      {exp.description.split("\n").map((paragraph) => (
                        <p>{paragraph}</p>
                      ))}
                    </div>
                  </div>
                ))
              }
            </div>
          </section>

          <section>
            <h2 class="text-3xl font-bold mb-8 flex items-center gap-3">
              <span class="w-8 h-1 bg-purple-500 rounded-full"></span>
              Formación
            </h2>

            <div
              class="bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 rounded-2xl p-6 hover:bg-gray-100 dark:hover:bg-white/[0.07] transition-colors"
            >
              <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">
                Técnico en desarrollo de aplicaciones informáticas
              </h3>
              <p class="text-purple-600 dark:text-purple-400 text-sm mb-4">
                Módulo de grado superior
              </p>

              <ul
                class="list-disc list-inside text-gray-600 dark:text-gray-400 text-sm leading-relaxed space-y-2"
              >
                <li>
                  Comprende dos años de estudios relacionados con sistemas
                  informáticos.
                </li>
                <li>Programación (Pascal, Basic, C, C++, ...)</li>
              </ul>
            </div>
          </section>
        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>
