---
import BaseHead from "../components/BaseHead.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE } from "../consts";

const experiences = [
  {
    period: "2018 — Presente",
    role: "Desarrollador Web Senior & Consultor de IA",
    company: "Freelance / Proyectos Propios",
    desc: "Desarrollo de aplicaciones web de alto rendimiento con Astro, TypeScript, PHP (Yii2), MySQL y Docker. Integración de modelos de Inteligencia Artificial (Gemini API, Claude Sonnet, OpenAI, Ollama), sistemas RAG y agentes de automatización."
  },
  {
    period: "2012 — 2018",
    role: "Desarrollador Backend & Administrador de Sistemas",
    company: "Desarrollo Web & Servicios TI",
    desc: "Construcción de backends robustos en PHP y MySQL, arquitectura de bases de datos relacionales, administración de servidores Linux Debian, virtualización con VMware/Proxmox y configuración de infraestructuras seguras."
  },
  {
    period: "2006 — 2012",
    role: "Técnico de Infraestructura y Sistemas",
    company: "Servicios Informáticos",
    desc: "Gestión de servidores, redes, mantenimiento de sistemas informáticos empresariales y soporte técnico especializado."
  }
];
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <BaseHead title={`CV — Ramón Menor | ${SITE_TITLE}`} description="Currículum Vitae de Ramón Menor — Desarrollador Web Full Stack & IA" />
  </head>
  <body class="tech-grid min-h-screen text-foreground selection:bg-cyan-500/20 selection:text-cyan-400">
    <Navbar />

    <main class="w-[92%] max-w-4xl mx-auto pt-32 pb-20">
      {/* Header */}
      <div class="glass-panel glass-panel-glow p-8 sm:p-10 rounded-3xl mb-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div>
          <span class="font-mono text-xs text-cyan-400 uppercase tracking-widest">Currículum Vitae</span>
          <h1 class="text-4xl sm:text-5xl font-black text-foreground mt-1">Ramón Menor</h1>
          <p class="text-base sm:text-lg text-emerald-400 font-mono mt-1">Desarrollador Web Full Stack & Especialista en IA</p>
        </div>

        <div class="flex flex-col gap-2 font-mono text-xs text-muted-foreground">
          <div><strong class="text-foreground">Email:</strong> ramonmenor@gmail.com</div>
          <div><strong class="text-foreground">Web:</strong> ramonmenor.es</div>
          <div><strong class="text-foreground">Ubicación:</strong> España</div>
        </div>
      </div>

      {/* Experience Timeline */}
      <div class="glass-panel p-8 sm:p-10 rounded-3xl space-y-8">
        <h2 class="text-2xl font-bold text-foreground flex items-center gap-3 border-b border-border/40 pb-4">
          <span class="w-3 h-3 rounded-full bg-cyan-400"></span>
          Experiencia Profesional
        </h2>

        <div class="space-y-8">
          {experiences.map((exp) => (
            <div class="relative pl-6 border-l border-cyan-500/30">
              <span class="absolute -left-[5px] top-1.5 w-2 h-2 rounded-full bg-cyan-400"></span>
              <span class="font-mono text-xs text-cyan-400 font-bold">{exp.period}</span>
              <h3 class="text-xl font-bold text-foreground mt-1">{exp.role}</h3>
              <p class="text-xs font-mono text-muted-foreground mb-3">{exp.company}</p>
              <p class="text-sm text-muted-foreground leading-relaxed">{exp.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </main>

    <Footer />
  </body>
</html>
