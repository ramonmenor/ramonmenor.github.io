---
import BaseHead from "../components/BaseHead.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE } from "../consts";

const experiences = [
  {
    period: "2018 — Presente",
    role: "Desarrollador Web Senior & Consultor de IA",
    company: "Freelance / Proyectos Propios",
    desc: "Desarrollo de aplicaciones web de alto rendimiento con Astro, TypeScript, PHP (Yii2), MySQL y Docker. Integración de modelos de Inteligencia Artificial (Gemini API, Claude Sonnet, OpenAI, Ollama), sistemas RAG y agentes de automatización."
  },
  {
    period: "2012 — 2018",
    role: "Desarrollador Backend & Administrador de Sistemas",
    company: "Desarrollo Web & Servicios TI",
    desc: "Construcción de backends robustos en PHP y MySQL, arquitectura de bases de datos relacionales, administración de servidores Linux Debian, virtualización con VMware/Proxmox y configuración de infraestructuras seguras."
  },
  {
    period: "2006 — 2012",
    role: "Técnico de Infraestructura y Sistemas",
    company: "Servicios Informáticos",
    desc: "Gestión de servidores, redes, mantenimiento de sistemas informáticos empresariales y soporte técnico especializado."
  }
];

const skills = [
  { category: "Lenguajes & Frameworks", items: ["PHP (Yii2)", "Astro 5", "TypeScript", "JavaScript (ESNext)", "HTML5 / CSS3", "Tailwind CSS"] },
  { category: "Inteligencia Artificial", items: ["Gemini API", "Claude Sonnet", "OpenAI GPT-4o", "Ollama Local", "RAG & Vector DB", "Cursor / Copilot"] },
  { category: "Bases de Datos", items: ["MySQL", "PostgreSQL", "Turso / LibSQL", "SQLite"] },
  { category: "Infraestructura & DevOps", items: ["Linux Debian", "Docker Contenedores", "Nginx", "Git / GitHub", "Proxmox / VMware"] }
];
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead title={`Trayectoria & CV — Ramón Menor | ${SITE_TITLE}`} description="Currículum Vitae y trayectoria profesional de Ramón Menor — Desarrollador Web Full Stack" />
  </head>
  <body class="bg-white text-slate-900 min-h-screen flex flex-col font-sans">
    <Navbar currentPath="/cv" />

    <main class="w-full max-w-4xl mx-auto px-4 sm:px-6 py-10 flex-1">
      {/* Header */}
      <div class="mb-8">
        <a href="/" class="inline-flex items-center gap-1.5 text-xs font-mono text-slate-500 hover:text-blue-600 transition-colors mb-4">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
          Volver a Herramientas
        </a>

        <div class="clean-card p-6 sm:p-8 bg-slate-50/50 flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div>
            <span class="text-xs font-mono text-blue-600 font-bold uppercase tracking-wider">Currículum Vitae</span>
            <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight mt-1">Ramón Menor</h1>
            <p class="text-sm font-medium text-slate-600 mt-1">Desarrollador Web Full Stack (+15 años de experiencia)</p>
          </div>

          <div class="space-y-1.5 text-xs font-mono text-slate-600">
            <div><strong class="text-slate-900">Email:</strong> <a href="mailto:minombre@ramonmenor.es" class="text-blue-600 hover:underline">minombre@ramonmenor.es</a></div>
            <div><strong class="text-slate-900">Web:</strong> ramonmenor.es</div>
            <div><strong class="text-slate-900">Ubicación:</strong> España</div>
          </div>
        </div>
      </div>

      {/* Experience Timeline */}
      <div class="clean-card p-6 sm:p-8 mb-8">
        <h2 class="text-xl font-bold text-slate-900 mb-6 pb-3 border-b border-slate-200">
          Experiencia Profesional
        </h2>

        <div class="space-y-8">
          {experiences.map((exp) => (
            <div class="relative pl-6 border-l-2 border-slate-200">
              <span class="absolute -left-[5px] top-1.5 w-2 h-2 rounded-full bg-blue-600"></span>
              <span class="font-mono text-xs text-blue-600 font-bold">{exp.period}</span>
              <h3 class="text-lg font-bold text-slate-900 mt-0.5">{exp.role}</h3>
              <p class="text-xs font-mono text-slate-500 mb-2">{exp.company}</p>
              <p class="text-sm text-slate-600 leading-relaxed">{exp.desc}</p>
            </div>
          ))}
        </div>
      </div>

      {/* Skills Matrix */}
      <div class="clean-card p-6 sm:p-8">
        <h2 class="text-xl font-bold text-slate-900 mb-6 pb-3 border-b border-slate-200">
          Habilidades Técnicas
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {skills.map((s) => (
            <div>
              <h3 class="text-xs font-mono font-bold uppercase text-slate-500 mb-3">{s.category}</h3>
              <div class="flex flex-wrap gap-1.5 font-mono text-xs">
                {s.items.map((item) => (
                  <span class="px-2.5 py-1 rounded-lg bg-slate-100 border border-slate-200 text-slate-700">
                    {item}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </main>

    <Footer />
  </body>
</html>
