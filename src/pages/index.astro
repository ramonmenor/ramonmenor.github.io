---
import BaseHead from "../components/BaseHead.astro";
import Navbar from "../components/Navbar.astro";
import AiTerminal from "../components/AiTerminal.astro";
import TechMatrix from "../components/TechMatrix.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <BaseHead title={`${SITE_TITLE} — Desarrollador Web Full Stack & IA`} description={SITE_DESCRIPTION} />
  </head>
  <body class="tech-grid min-h-screen text-foreground selection:bg-cyan-500/20 selection:text-cyan-400">
    <Navbar />

    <main class="w-[92%] max-w-6xl mx-auto pt-28 sm:pt-36">
      {/* HERO SECTION */}
      <section id="hero" class="py-12 sm:py-20 relative">
        {/* Glow Spheres */}
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[350px] bg-gradient-to-b from-cyan-500/15 via-indigo-500/10 to-transparent blur-3xl rounded-full pointer-events-none"></div>

        <div class="relative z-10 text-center max-w-4xl mx-auto">
          {/* Active Status Badge */}
          <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full glass-panel text-emerald-400 font-mono text-xs mb-8 shadow-lg shadow-emerald-500/5 border border-emerald-500/30">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
            <span>Desarrollador Web Activo en Inteligencia Artificial</span>
          </div>

          {/* Main Name */}
          <h1 class="text-6xl sm:text-7xl md:text-8xl lg:text-9xl font-black tracking-tight leading-none mb-6">
            <span class="gradient-text-cyan block">RAMÓN</span>
            <span class="text-foreground block">MENOR</span>
          </h1>

          {/* Subtitle */}
          <p class="text-xl sm:text-2xl md:text-3xl font-extrabold text-foreground mb-6">
            Full Stack Web Developer & AI Architect
          </p>

          {/* Core Pitch */}
          <p class="text-base sm:text-lg md:text-xl text-muted-foreground leading-relaxed max-w-2xl mx-auto mb-10">
            Ingeniero de software con más de 15 años de trayectoria web (PHP, TypeScript, Astro, SQL, Docker) especializado en la integración real de <strong class="text-foreground">Inteligencia Artificial</strong> (Gemini, Claude, OpenAI, Ollama, RAG y Agentes autónomos).
          </p>

          {/* Hero Action Buttons */}
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4 font-mono text-xs">
            <a
              href="#ai-shell"
              class="w-full sm:w-auto px-8 py-4 rounded-full bg-gradient-to-r from-cyan-500 to-indigo-600 text-white font-bold text-sm shadow-xl shadow-cyan-500/20 hover:opacity-90 transition-opacity flex items-center justify-center gap-2"
            >
              <span>⚡ Probar Demo IA Interactivo</span>
            </a>
            <a
              href="#tech-matrix"
              class="w-full sm:w-auto px-6 py-4 rounded-full glass-panel border border-border/60 text-foreground font-semibold hover:bg-white/10 transition-all flex items-center justify-center gap-2"
            >
              <span>⚙️ Ver Stack & IA</span>
            </a>
            <a
              href="/cv"
              class="w-full sm:w-auto px-6 py-4 rounded-full glass-panel border border-border/40 text-muted-foreground hover:text-foreground transition-all flex items-center justify-center gap-2"
            >
              <span>📄 Ver CV</span>
            </a>
          </div>
        </div>
      </section>

      {/* AI TERMINAL CENTERPIECE */}
      <section class="py-12">
        <AiTerminal />
      </section>

      {/* TECH MATRIX */}
      <section>
        <TechMatrix />
      </section>

      {/* PROJECTS SHOWCASE */}
      <section>
        <ProjectGrid />
      </section>
    </main>

    <Footer />
  </body>
</html>
