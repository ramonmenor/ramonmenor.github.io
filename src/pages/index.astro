---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AiPlayground from "../components/AiPlayground.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";

const aiCapabilities = [
  {
    icon: `🤖`,
    title: "Integración de IA & LLMs",
    badge: "AI.CORE",
    desc: "Conexión de modelos de lenguaje (Gemini, Claude Sonnet, OpenAI, Ollama local), embeddings vectoriales y RAG sobre datos privados para potenciar aplicaciones web realistas.",
    color: "cyan" as const,
  },
  {
    icon: `⚡`,
    title: "Desarrollo Web Full Stack",
    badge: "DEV.CORE",
    desc: "Aplicaciones web completas y de alta velocidad con Astro, TypeScript, PHP (Yii2), Tailwind CSS y bases de datos relacionales/serverless (MySQL, Turso).",
    color: "green" as const,
  },
  {
    icon: `🧩`,
    title: "Agentes & Automatización",
    badge: "AGENT.CORE",
    desc: "Diseño de flujos de trabajo con agentes autónomos, Function Calling y herramientas MCP que ejecutan consultas SQL, llamadas a APIs y tareas repetitivas sin intervención humana.",
    color: "magenta" as const,
  },
  {
    icon: `🛡️`,
    title: "Infraestructura & DevOps",
    badge: "SYS.CORE",
    desc: "Servidores Linux Debian, contenedores Docker, despliegues continuos y seguridad en la nube para garantizar que tus aplicaciones funcionen 24/7 sin caídas.",
    color: "amber" as const,
  },
];

const featuredProjects = [
  {
    title: "ramonmenor.es",
    subtitle: "PORTFOLIO CON IA",
    description: "Sitio web oficial desarrollado con Astro 5, TypeScript, Tailwind CSS y módulo interactivo de IA en vivo para simular arquitecturas y prompts de producción.",
    href: "/ejemplo-ia",
    tags: ["Astro 5", "TypeScript", "AI Playground", "Tailwind"],
    highlight: true,
  },
  {
    title: "Mis Perlas — RAG & Turso",
    subtitle: "BÚSQUEDA SEMÁNTICA",
    description: "Aplicación de consulta semántica de sabiduría conectada a base de datos serverless Turso (@libsql/client) y procesamiento de lenguaje natural.",
    href: "/stack",
    tags: ["Astro", "Turso DB", "Embeddings", "TypeScript"],
    highlight: false,
  },
  {
    title: "Orquestador de Agentes LLM",
    subtitle: "IA AUTÓNOMA",
    description: "Pipeline de agentes de IA con Function Calling para ejecución de scripts, consultas de base de datos y generación de reportes estructurados.",
    href: "/skills",
    tags: ["Gemini API", "Claude 3.5", "Docker", "Node.js"],
    highlight: false,
  },
];

const techStack = [
  { category: "IA & Modelos", items: ["Gemini API", "Claude Sonnet", "OpenAI GPT-4o", "Ollama Local", "RAG & Vector DB", "Cursor", "Copilot"] },
  { category: "Frontend Web", items: ["Astro 5", "TypeScript", "JavaScript", "Tailwind CSS", "HTML5 Semántico", "UI Reactiva"] },
  { category: "Backend & DB", items: ["PHP", "Yii2 Framework", "Node.js", "MySQL", "Turso / LibSQL", "APIs RESTful"] },
  { category: "Infra & DevOps", items: ["Linux Debian", "Docker", "Nginx", "Git / GitHub", "Cloudflare", "Serverless"] },
];
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body class="min-h-screen flex flex-col bg-background text-foreground selection:bg-neon-cyan/20 selection:text-neon-cyan">
    <Header title={SITE_TITLE} currentPath="/" />

    <main class="flex-1 relative">
      {/* Hero Section */}
      <section class="relative min-h-[90vh] flex flex-col justify-center pt-24 pb-16 px-4 sm:px-6 lg:px-8 overflow-hidden">
        {/* Subtle grid background */}
        <div class="absolute inset-0 grid-bg opacity-30 pointer-events-none" aria-hidden="true"></div>

        <div class="relative z-10 max-w-6xl mx-auto w-full">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
            {/* Main Info (Left 7 cols) */}
            <div class="lg:col-span-7">
              {/* Active Badge */}
              <div class="inline-flex items-center gap-2.5 px-3 py-1.5 rounded-full border border-neon-green/30 bg-neon-green/10 text-neon-green text-xs font-mono mb-6 shadow-[0_0_12px_rgba(0,255,65,0.1)]">
                <span class="w-2 h-2 rounded-full bg-neon-green animate-pulse"></span>
                <span>Desarrollador Web Activo con Inteligencia Artificial</span>
              </div>

              {/* Headline */}
              <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-black tracking-tight leading-[0.95] mb-4" aria-label="Ramón Menor">
                <span class="block bg-gradient-to-r from-cyan-600 via-indigo-600 to-purple-600 dark:from-cyan-400 dark:via-cyan-200 dark:to-fuchsia-400 bg-clip-text text-transparent">RAMÓN</span>
                <span class="block text-foreground">MENOR</span>
              </h1>

              <p class="text-xl sm:text-2xl font-bold text-neon-cyan mb-6">
                Full Stack Web Developer & AI Integration Architect
              </p>

              <p class="text-base sm:text-lg text-muted-foreground leading-relaxed max-w-2xl mb-8">
                Combino más de 15 años de ingeniería de software web (PHP, TypeScript, Astro, SQL, Docker) con la aplicación práctica de <strong class="text-foreground">Inteligencia Artificial</strong> (Gemini, Claude, OpenAI, Ollama, RAG y Agentes) para construir productos rápidos, inteligentes y rentables.
              </p>

              {/* Action Buttons */}
              <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
                <a
                  href="/ejemplo-ia"
                  class="px-6 py-3.5 rounded-xl bg-neon-cyan text-void font-bold text-sm text-center shadow-lg shadow-neon-cyan/20 hover:opacity-90 transition-all flex items-center justify-center gap-2 font-mono"
                >
                  <span>⚡ Probar Ejemplo IA en Vivo</span>
                </a>
                <a
                  href="/contact"
                  class="px-6 py-3.5 rounded-xl bg-secondary/80 border border-border/80 text-foreground font-semibold text-sm text-center hover:bg-secondary transition-all flex items-center justify-center gap-2"
                >
                  <span>Hablemos de tu proyecto</span>
                </a>
                <a
                  href="/resume"
                  class="px-5 py-3.5 rounded-xl border border-border/40 text-muted-foreground font-mono text-xs text-center hover:text-foreground transition-all"
                >
                  <span>Ver CV</span>
                </a>
              </div>
            </div>

            {/* Quick Feature Stats Card (Right 5 cols) */}
            <div class="lg:col-span-5">
              <div class="p-6 sm:p-8 rounded-2xl border border-border/60 bg-card/80 backdrop-blur-xl shadow-2xl space-y-6">
                <div class="flex items-center justify-between pb-4 border-b border-border/40">
                  <div class="flex items-center gap-2">
                    <span class="w-3 h-3 rounded-full bg-neon-cyan"></span>
                    <span class="font-mono text-xs font-bold text-foreground">PERFIL TÉCNICO</span>
                  </div>
                  <span class="font-mono text-[11px] text-neon-green">Status: Online</span>
                </div>

                <div class="space-y-4">
                  <div class="p-3.5 rounded-lg bg-secondary/50 border border-border/40 flex items-start gap-3">
                    <span class="text-xl">🚀</span>
                    <div>
                      <h4 class="text-xs font-bold text-foreground">Webs de Alto Rendimiento</h4>
                      <p class="text-xs text-muted-foreground mt-0.5">Astro 5, SSG/SSR, TypeScript y carga instantánea.</p>
                    </div>
                  </div>

                  <div class="p-3.5 rounded-lg bg-secondary/50 border border-border/40 flex items-start gap-3">
                    <span class="text-xl">🧠</span>
                    <div>
                      <h4 class="text-xs font-bold text-foreground">Sistemas Potenciados por IA</h4>
                      <p class="text-xs text-muted-foreground mt-0.5">Integración de LLMs, RAG, Prompt Engineering y Agentes.</p>
                    </div>
                  </div>

                  <div class="p-3.5 rounded-lg bg-secondary/50 border border-border/40 flex items-start gap-3">
                    <span class="text-xl">⚙️</span>
                    <div>
                      <h4 class="text-xs font-bold text-foreground">Backend & Infraestructura</h4>
                      <p class="text-xs text-muted-foreground mt-0.5">PHP, Yii2, Node.js, SQL, Docker y servidores Linux.</p>
                    </div>
                  </div>
                </div>

                <div class="pt-2 flex items-center justify-between text-xs font-mono text-muted-foreground">
                  <span>Exp: +15 Años</span>
                  <span>Stack: Full Stack + IA</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* Embedded Live AI Demo Section */}
      <section class="py-16 sm:py-24 px-4 sm:px-6 lg:px-8 border-t border-border/40 bg-secondary/20">
        <div class="max-w-6xl mx-auto w-full">
          <div class="mb-10 text-center max-w-2xl mx-auto">
            <span class="text-xs font-mono uppercase tracking-widest text-neon-cyan">Demostración interactiva</span>
            <h2 class="text-3xl sm:text-4xl font-black text-foreground mt-2 mb-3">
              Inteligencia Artificial <span class="text-neon-cyan">en Acción</span>
            </h2>
            <p class="text-sm sm:text-base text-muted-foreground">
              Prueba este generador interactivo en tiempo real para explorar cómo estructuro soluciones de IA para aplicaciones web.
            </p>
          </div>

          <AiPlayground />
        </div>
      </section>

      {/* Capabilities Section */}
      <section class="py-16 sm:py-24 px-4 sm:px-6 lg:px-8 border-t border-border/40">
        <div class="max-w-6xl mx-auto w-full">
          <div class="mb-12">
            <span class="text-xs font-mono uppercase tracking-widest text-neon-cyan">Especialidades</span>
            <h2 class="text-3xl sm:text-4xl font-black text-foreground mt-2 mb-3">
              ¿Qué puedo aportar a tu proyecto?
            </h2>
            <p class="text-sm sm:text-base text-muted-foreground max-w-2xl">
              Soluciones integrales de desarrollo web potenciadas por las herramientas y modelos de Inteligencia Artificial más avanzados.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {aiCapabilities.map((cap) => (
              <div class="p-6 sm:p-8 rounded-2xl border border-border/60 bg-card/60 backdrop-blur-md hover:border-neon-cyan/40 transition-all duration-300 group">
                <div class="flex items-center justify-between mb-4">
                  <span class="text-3xl">{cap.icon}</span>
                  <span class="font-mono text-xs text-neon-cyan px-2.5 py-1 rounded bg-neon-cyan/10 border border-neon-cyan/20">
                    {cap.badge}
                  </span>
                </div>
                <h3 class="text-xl font-bold text-foreground mb-2 group-hover:text-neon-cyan transition-colors">
                  {cap.title}
                </h3>
                <p class="text-sm text-muted-foreground leading-relaxed">
                  {cap.desc}
                </p>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* Projects Showcase */}
      <section class="py-16 sm:py-24 px-4 sm:px-6 lg:px-8 border-t border-border/40 bg-secondary/20">
        <div class="max-w-6xl mx-auto w-full">
          <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-4 mb-12">
            <div>
              <span class="text-xs font-mono uppercase tracking-widest text-neon-cyan">Proyectos Destacados</span>
              <h2 class="text-3xl sm:text-4xl font-black text-foreground mt-2">
                Casos de Uso & Desarrollos
              </h2>
            </div>
            <a href="/ejemplo-ia" class="font-mono text-xs text-neon-cyan hover:underline flex items-center gap-1">
              <span>Ver demostración en vivo</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {featuredProjects.map((proj) => (
              <div class={`p-6 rounded-2xl border transition-all duration-300 flex flex-col justify-between ${
                proj.highlight
                  ? 'border-neon-cyan/40 bg-neon-cyan/5 shadow-[0_0_20px_rgba(0,240,255,0.08)]'
                  : 'border-border/60 bg-card/60'
              }`}>
                <div>
                  <div class="flex items-center justify-between mb-3 font-mono text-xs">
                    <span class="text-neon-cyan font-bold">{proj.subtitle}</span>
                    {proj.highlight && <span class="px-2 py-0.5 rounded bg-neon-cyan text-void text-[10px] font-bold">Destacado</span>}
                  </div>
                  <h3 class="text-xl font-bold text-foreground mb-2">{proj.title}</h3>
                  <p class="text-xs text-muted-foreground leading-relaxed mb-6">{proj.description}</p>
                </div>

                <div>
                  <div class="flex flex-wrap gap-1.5 mb-4 font-mono text-[11px]">
                    {proj.tags.map((tag) => (
                      <span class="px-2 py-0.5 rounded bg-secondary border border-border text-muted-foreground">{tag}</span>
                    ))}
                  </div>
                  <a
                    href={proj.href}
                    class="inline-flex items-center gap-1.5 text-xs font-mono font-bold text-neon-cyan hover:underline"
                  >
                    <span>Ver proyecto</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                  </a>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* Tech Stack Matrix */}
      <section class="py-16 sm:py-24 px-4 sm:px-6 lg:px-8 border-t border-border/40">
        <div class="max-w-6xl mx-auto w-full">
          <div class="mb-12">
            <span class="text-xs font-mono uppercase tracking-widest text-neon-cyan">Stack Tecnológico</span>
            <h2 class="text-3xl sm:text-4xl font-black text-foreground mt-2 mb-3">
              Herramientas & Ecosistema
            </h2>
            <p class="text-sm text-muted-foreground max-w-xl">
              Tecnologías que utilizo activamente para construir, desplegar y mantener soluciones web con IA.
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {techStack.map((group) => (
              <div class="p-5 rounded-xl border border-border/60 bg-card/40">
                <h3 class="text-xs font-mono uppercase tracking-wider text-neon-cyan font-bold mb-4 pb-2 border-b border-border/40">
                  {group.category}
                </h3>
                <ul class="space-y-2 font-mono text-xs text-foreground">
                  {group.items.map((item) => (
                    <li class="flex items-center gap-2">
                      <span class="text-neon-green">›</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>

          <div class="mt-8 text-center">
            <a href="/stack" class="inline-flex items-center gap-2 font-mono text-xs text-neon-cyan hover:underline">
              <span>Ver desglose completo de Stack & Habilidades</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
          </div>
        </div>
      </section>

      {/* Bottom CTA Banner */}
      <section class="py-20 px-4 sm:px-6 lg:px-8 border-t border-border/40 bg-gradient-to-b from-transparent via-neon-cyan/[0.03] to-transparent">
        <div class="max-w-4xl mx-auto text-center">
          <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-foreground tracking-tight mb-4">
            ¿Tienes una idea o proyecto web con IA?
          </h2>
          <p class="text-base sm:text-lg text-muted-foreground mb-8 max-w-2xl mx-auto">
            Hablemos sobre cómo podemos desarrollarlo con una arquitectura moderna, segura y orientada a resultados reales.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a
              href="/contact"
              class="w-full sm:w-auto px-8 py-4 rounded-xl bg-neon-cyan text-void font-bold text-sm text-center shadow-lg shadow-neon-cyan/20 hover:opacity-90 transition-all font-mono"
            >
              <span>Contactar con Ramón</span>
            </a>
            <a
              href="/ejemplo-ia"
              class="w-full sm:w-auto px-8 py-4 rounded-xl bg-secondary border border-border text-foreground font-semibold text-sm text-center hover:bg-secondary/80 transition-all font-mono"
            >
              <span>Ver Demo IA Interactivo</span>
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>
