---
import BaseHead from "../components/BaseHead.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";

const apps = [
  {
    id: "dividir-cuenta",
    href: "/apps/dividir-cuenta/",
    title: "Dividir Cuenta & Ticket",
    category: "FINANZAS",
    accent: "€ Tickets & OCR",
    icon: "🧾",
    colorStyle: "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/20",
    isPrivate: false,
    group: "gestion",
    desc: "Calcula qué paga cada comensal según consumiciones. Escáner de tickets con cámara/OCR y reparto directo para Bizum.",
    tags: ["Restaurante", "Bizum", "OCR", "Calculadora"]
  },
  {
    id: "notas-privadas",
    href: "/apps/notas-privadas/",
    title: "Cuaderno Privado",
    category: "NOTAS",
    accent: "🔒 Cifrado Local",
    icon: "📝",
    colorStyle: "bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/20",
    isPrivate: true,
    group: "gestion",
    desc: "Bloc de notas rápido y persistente en almacenamiento local. Ideal para borradores, snippets temporales y tareas.",
    tags: ["Privada", "Notas", "LocalStorage", "Borradores"]
  },
  {
    id: "habitos",
    href: "/apps/habitos/",
    title: "Hábitos & Rutinas",
    category: "HÁBITOS",
    accent: "Racha Diaria",
    icon: "🎯",
    colorStyle: "bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border-cyan-500/20",
    isPrivate: false,
    group: "gestion",
    desc: "Seguimiento diario de hábitos y rachas semanales para mantener la constancia en tus rutinas personales.",
    tags: ["Hábitos", "Rutinas", "Productividad", "Objetivos"]
  },
  {
    id: "json",
    href: "/apps/json-formatter/",
    title: "JSON Formatter & Validator",
    category: "DEV TOOLS",
    accent: "Validador & Minify",
    icon: "{ }",
    colorStyle: "bg-blue-500/10 text-blue-600 dark:text-blue-400 border-blue-500/20",
    isPrivate: false,
    group: "utilidades",
    desc: "Valida sintaxis, embellece con sangría configurable y compacta datos JSON en tiempo real en tu navegador.",
    tags: ["JSON", "Formateador", "Validador", "Minify"]
  },
  {
    id: "sql",
    href: "/apps/sql-formatter/",
    title: "SQL Formatter",
    category: "DEV TOOLS",
    accent: "Query Beautifier",
    icon: "SQL",
    colorStyle: "bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 border-indigo-500/20",
    isPrivate: false,
    group: "utilidades",
    desc: "Convierte consultas SQL complejas o desordenadas en código limpio, estructurado y con palabras clave resaltadas.",
    tags: ["SQL", "Consultas", "Bases de datos", "Limpieza"]
  },
  {
    id: "hash-uuid",
    href: "/apps/hash-uuid/",
    title: "Hashes & UUIDs",
    category: "SEGURIDAD",
    accent: "WebCrypto SHA",
    icon: "#",
    colorStyle: "bg-purple-500/10 text-purple-600 dark:text-purple-400 border-purple-500/20",
    isPrivate: false,
    group: "utilidades",
    desc: "Genera UUIDs v4 en lote, passwords criptográficas y calcula hashes SHA-256, SHA-512 y SHA-1 al vuelo.",
    tags: ["UUID v4", "SHA-256", "Contraseñas", "WebCrypto"]
  },
  {
    id: "color",
    href: "/apps/color-converter/",
    title: "Colores & Contraste WCAG",
    category: "DISEÑO",
    accent: "HEX / RGB / WCAG",
    icon: "🎨",
    colorStyle: "bg-pink-500/10 text-pink-600 dark:text-pink-400 border-pink-500/20",
    isPrivate: false,
    group: "utilidades",
    desc: "Conversión bidireccional entre HEX, RGB y HSL con calculadora en vivo de ratios de contraste y accesibilidad WCAG.",
    tags: ["HEX", "RGB", "HSL", "WCAG Contrast"]
  },
  {
    id: "pomodoro",
    href: "/apps/pomodoro/",
    title: "Temporizador Pomodoro",
    category: "TIEMPO",
    accent: "Enfoque & Pausas",
    icon: "⏱️",
    colorStyle: "bg-orange-500/10 text-orange-600 dark:text-orange-400 border-orange-500/20",
    isPrivate: false,
    group: "utilidades",
    desc: "Bloques de trabajo enfocado y descansos configurables con contador de ciclos y avisos sonoros integrados.",
    tags: ["Productividad", "Pomodoro", "Enfoque", "Tiempo"]
  },
  {
    id: "base64",
    href: "/apps/base64-converter/",
    title: "Base64 & URL Encoder",
    category: "CONVERTIDOR",
    accent: "UTF-8 / URL Safe",
    icon: "64",
    colorStyle: "bg-teal-500/10 text-teal-600 dark:text-teal-400 border-teal-500/20",
    isPrivate: false,
    group: "sistema",
    desc: "Codifica y decodifica texto con soporte UTF-8 completo, además de utilidades directas para URL encoding.",
    tags: ["Base64", "URL Encode", "UTF-8", "String Tools"]
  },
  {
    id: "mis-servidores",
    href: "/apps/mis-servidores/",
    title: "Servidores & Accesos",
    category: "SISTEMAS",
    accent: "🔒 SSH / DevOps",
    icon: "⚡",
    colorStyle: "bg-rose-500/10 text-rose-600 dark:text-rose-400 border-rose-500/20",
    isPrivate: true,
    group: "sistema",
    desc: "Fichero privado de servidores, IPs, accesos SSH habituales y gestor del PIN maestro de acceso.",
    tags: ["Privada", "DevOps", "Servidores", "Seguridad"]
  },
  {
    id: "herramientas-externas",
    href: "/apps/herramientas-externas/",
    title: "Herramientas Externas",
    category: "EXTERNO",
    accent: "Accesos Directos ↗",
    icon: "↗",
    colorStyle: "bg-sky-500/10 text-sky-600 dark:text-sky-400 border-sky-500/20",
    isPrivate: false,
    group: "externas",
    desc: "Gestor de accesos directos personalizables a herramientas y servicios web externos con enlaces directos.",
    tags: ["Accesos", "Enlaces", "Herramientas", "Dashboard"]
  }
];

const categories = [
  { id: "all", label: "Todas las herramientas" },
  { id: "gestion", label: "Finanzas & Personal" },
  { id: "utilidades", label: "Dev & Utilidades" },
  { id: "sistema", label: "Sistema & Servidores" },
  { id: "externas", label: "Externas" }
];
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead title={`${SITE_TITLE} — Suite Personal`} description={SITE_DESCRIPTION} />
    <!-- Dynamic App Permissions & Auth Guard -->
    <script is:inline src="/apps/shared/auth-guard.js"></script>
  </head>
  <body class="bg-slate-50 dark:bg-[#090d16] text-slate-900 dark:text-slate-100 min-h-screen flex flex-col font-sans transition-colors duration-200">
    
    <!-- Top Navigation Bar -->
    <Navbar currentPath="/" />

    <main class="w-full max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12 flex-1">
      
      <!-- Hero Presentation Section -->
      <section class="mb-10 sm:mb-12">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-8 border-b border-slate-200/80 dark:border-slate-800/80">
          <div class="max-w-2xl">
            <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md bg-sky-500/10 border border-sky-500/20 text-sky-600 dark:text-sky-400 text-xs font-mono font-semibold uppercase tracking-wider mb-3">
              <span class="w-1.5 h-1.5 rounded-full bg-sky-500 animate-pulse"></span>
              SUITE DE HERRAMIENTAS
            </div>

            <h1 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight mb-3">
              Tu banco de trabajo personal.
            </h1>

            <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 leading-relaxed">
              Colección de micro-aplicaciones independientes, rápidas y privadas. Sin servidores externos para tus datos: todo se procesa de forma 100% local en tu navegador.
            </p>
          </div>

          <!-- Quick Metrics & PWA Action -->
          <div class="flex flex-col sm:flex-row md:flex-col items-start md:items-end gap-3 shrink-0">
            <button
              id="pwa-install-btn"
              type="button"
              class="hidden px-4 py-2 rounded-xl bg-slate-900 dark:bg-white text-white dark:text-slate-950 text-xs font-mono font-bold items-center gap-2 hover:bg-slate-800 dark:hover:bg-slate-100 transition-all shadow-sm cursor-pointer"
            >
              <span>📲</span>
              <span>Instalar como App</span>
            </button>

            <div class="flex items-center gap-2 text-xs font-mono text-slate-500 dark:text-slate-400 bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-1.5 shadow-sm">
              <span class="font-bold text-slate-900 dark:text-white" id="stat-total-apps">{apps.length}</span> apps listas
              <span>•</span>
              <span class="text-emerald-600 dark:text-emerald-400">100% local</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Search & Filters Toolbar -->
      <section class="mb-8 space-y-4">
        <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4">
          
          <!-- Live Search Input -->
          <div class="relative flex-1 max-w-md">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 dark:text-slate-500">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
            <input
              type="text"
              id="tool-search-input"
              placeholder="Buscar herramienta por nombre, descripción o tag..."
              class="w-full pl-10 pr-9 py-2 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/70 text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-500 text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-sky-500/40 focus:border-sky-500/50 transition-all shadow-sm"
              autocomplete="off"
            />
            <button
              id="clear-search-btn"
              type="button"
              class="absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hidden cursor-pointer"
              title="Limpiar búsqueda"
            >
              ✕
            </button>
          </div>

          <!-- Privacy & Status Controls -->
          <div class="flex items-center gap-2 self-start md:self-auto">
            <button
              id="auth-toggle-btn"
              type="button"
              class="inline-flex items-center gap-2 px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/70 text-xs font-mono text-slate-600 dark:text-slate-400 hover:border-slate-300 dark:hover:border-slate-700 hover:text-slate-900 dark:hover:text-white transition-all shadow-sm cursor-pointer"
              title="Estado del acceso privado"
            >
              <span id="auth-status-dot" class="w-2 h-2 rounded-full bg-slate-400"></span>
              <span id="auth-status-text">Comprobando...</span>
            </button>
          </div>

        </div>

        <!-- Filter Pills Bar -->
        <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar pb-1 text-xs font-mono">
          <button
            type="button"
            id="filter-all-btn"
            class="filter-btn active px-3 py-1.5 rounded-lg border border-slate-900 dark:border-white bg-slate-900 dark:bg-white text-white dark:text-slate-950 font-bold whitespace-nowrap transition-all shadow-sm cursor-pointer"
            data-filter="all"
          >
            Todas ({apps.length})
          </button>
          <button
            type="button"
            id="filter-public-btn"
            class="filter-btn px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/60 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:border-slate-300 dark:hover:border-slate-700 whitespace-nowrap transition-all shadow-sm cursor-pointer"
            data-filter="public"
          >
            Públicas ({apps.filter(a => !a.isPrivate).length})
          </button>
          <button
            type="button"
            id="filter-private-btn"
            class="filter-btn px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/60 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:border-slate-300 dark:hover:border-slate-700 whitespace-nowrap transition-all shadow-sm cursor-pointer"
            data-filter="private"
          >
            🔒 Privadas ({apps.filter(a => a.isPrivate).length})
          </button>
          
          <div class="h-4 w-px bg-slate-200 dark:bg-slate-800 mx-1 shrink-0"></div>

          <button
            type="button"
            class="group-filter-btn px-3 py-1.5 rounded-lg border border-transparent text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-200/50 dark:hover:bg-slate-800/50 whitespace-nowrap transition-all cursor-pointer"
            data-group="gestion"
          >
            Finanzas
          </button>
          <button
            type="button"
            class="group-filter-btn px-3 py-1.5 rounded-lg border border-transparent text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-200/50 dark:hover:bg-slate-800/50 whitespace-nowrap transition-all cursor-pointer"
            data-group="utilidades"
          >
            Dev & Utilidades
          </button>
          <button
            type="button"
            class="group-filter-btn px-3 py-1.5 rounded-lg border border-transparent text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-200/50 dark:hover:bg-slate-800/50 whitespace-nowrap transition-all cursor-pointer"
            data-group="sistema"
          >
            Sistemas
          </button>
        </div>
      </section>

      <!-- Tool Cards Grid -->
      <section id="herramientas" class="mb-14">
        <div id="no-results-msg" class="hidden text-center py-16 bg-white dark:bg-slate-900/40 rounded-2xl border border-dashed border-slate-300 dark:border-slate-800">
          <p class="text-sm font-mono text-slate-500 dark:text-slate-400">No se encontraron herramientas con ese criterio de búsqueda.</p>
          <button id="reset-search-btn" class="mt-3 text-xs font-mono text-sky-600 dark:text-sky-400 hover:underline">Mostrar todas</button>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" id="tools-grid">
          {apps.map((app) => (
            <a
              href={app.href}
              data-app-id={app.id}
              data-type={app.isPrivate ? "private" : "public"}
              data-group={app.group}
              data-title={app.title.toLowerCase()}
              data-desc={app.desc.toLowerCase()}
              data-tags={app.tags.join(" ").toLowerCase()}
              class="app-card tool-card-surface group rounded-2xl p-5 flex flex-col justify-between relative overflow-hidden"
            >
              <div>
                <!-- Top Row: Icon + Category + Privacy Badge -->
                <div class="flex items-center justify-between gap-2 mb-3">
                  <div class="flex items-center gap-2.5">
                    <div class={`w-9 h-9 rounded-xl border flex items-center justify-center font-bold text-sm ${app.colorStyle}`}>
                      {app.icon}
                    </div>
                    <span class="text-[11px] font-mono font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
                      {app.category}
                    </span>
                  </div>

                  {app.isPrivate ? (
                    <span class="inline-flex items-center gap-1 text-[10px] font-mono px-2 py-0.5 rounded-md bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20">
                      🔒 Privada
                    </span>
                  ) : (
                    <span class="inline-flex items-center gap-1 text-[10px] font-mono px-2 py-0.5 rounded-md bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                      Pública
                    </span>
                  )}
                </div>

                <!-- Title & Description -->
                <h2 class="text-base font-bold text-slate-900 dark:text-white group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors mb-1.5">
                  {app.title}
                </h2>
                <p class="text-xs text-slate-600 dark:text-slate-400 line-clamp-2 leading-relaxed mb-4">
                  {app.desc}
                </p>

                <!-- Tags list -->
                <div class="flex flex-wrap gap-1 mb-4">
                  {app.tags.map((tag) => (
                    <span class="text-[10px] font-mono px-2 py-0.5 rounded-md bg-slate-100 dark:bg-slate-800/80 text-slate-600 dark:text-slate-400 border border-slate-200/60 dark:border-slate-700/60">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>

              <!-- Card Footer -->
              <div class="pt-3 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs font-mono">
                <span class="text-sky-600 dark:text-sky-400 font-medium">{app.accent}</span>
                <span class="text-slate-400 dark:text-slate-500 group-hover:text-sky-500 group-hover:translate-x-1 transition-all">
                  →
                </span>
              </div>
            </a>
          ))}
        </div>
      </section>

      <!-- External Tools Section -->
      <section id="externas" class="mb-12">
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-3">
            <h3 class="text-xs font-mono font-bold tracking-widest text-slate-500 dark:text-slate-400 uppercase">
              HERRAMIENTAS EXTERNAS
            </h3>
            <a href="/apps/herramientas-externas/" class="text-xs font-mono text-sky-600 dark:text-sky-400 hover:underline">
              Editar lista ↗
            </a>
          </div>

          <!-- Slider Navigation Arrows -->
          <div class="flex items-center gap-1.5">
            <button
              type="button"
              id="slider-prev-btn"
              class="w-8 h-8 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:border-slate-300 dark:hover:border-slate-700 flex items-center justify-center transition-all text-sm font-mono cursor-pointer shadow-sm"
              title="Anterior"
            >
              ‹
            </button>
            <button
              type="button"
              id="slider-next-btn"
              class="w-8 h-8 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:border-slate-300 dark:hover:border-slate-700 flex items-center justify-center transition-all text-sm font-mono cursor-pointer shadow-sm"
              title="Siguiente"
            >
              ›
            </button>
          </div>
        </div>

        <div class="relative overflow-hidden">
          <div
            class="flex gap-4 overflow-x-auto scroll-smooth snap-x snap-mandatory no-scrollbar py-1"
            id="home-external-tools"
          >
            <!-- Rendered dynamically by script -->
          </div>
        </div>
      </section>

    </main>

    <!-- Unified Footer -->
    <Footer />

    {/* Client script for filtering, live search, permissions sync & session status */}
    <script>
      const STORAGE_KEY = 'rm_private_access_session';
      let currentFilter = 'all';
      let currentGroup = 'all';
      let searchQuery = '';

      function isUnlocked() {
        return sessionStorage.getItem(STORAGE_KEY) === 'unlocked' || localStorage.getItem(STORAGE_KEY) === 'unlocked';
      }

      function updateAuthUI() {
        const dot = document.getElementById('auth-status-dot');
        const text = document.getElementById('auth-status-text');
        const btn = document.getElementById('auth-toggle-btn');
        if (!dot || !text || !btn) return;

        if (isUnlocked()) {
          dot.className = 'w-2 h-2 rounded-full bg-emerald-500 shadow-sm';
          text.textContent = '🔒 Privadas: Desbloqueadas';
          btn.title = 'Haz clic para bloquear el acceso privado';
        } else {
          dot.className = 'w-2 h-2 rounded-full bg-rose-500 shadow-sm';
          text.textContent = '🔒 Privadas: Bloqueadas';
          btn.title = 'Las aplicaciones privadas pedirán PIN al entrar';
        }
      }

      function applyFilters() {
        const cards = document.querySelectorAll('.app-card');
        const noResults = document.getElementById('no-results-msg');
        let visibleCount = 0;

        cards.forEach(cardEl => {
          const card = cardEl as HTMLElement;
          const type = card.getAttribute('data-type');
          const group = card.getAttribute('data-group');
          const isConfigVisible = card.getAttribute('data-visible') !== 'false';
          const title = card.getAttribute('data-title') || '';
          const desc = card.getAttribute('data-desc') || '';
          const tags = card.getAttribute('data-tags') || '';

          if (!isConfigVisible) {
            card.style.display = 'none';
            return;
          }

          // Type filter (all / public / private)
          const matchesType = currentFilter === 'all' || currentFilter === type;

          // Group filter (all / gestion / utilidades / sistema)
          const matchesGroup = currentGroup === 'all' || currentGroup === group;

          // Search query filter
          const matchesSearch = !searchQuery || 
            title.includes(searchQuery) || 
            desc.includes(searchQuery) || 
            tags.includes(searchQuery);

          if (matchesType && matchesGroup && matchesSearch) {
            card.style.display = 'flex';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (noResults) {
          if (visibleCount === 0) {
            noResults.classList.remove('hidden');
          } else {
            noResults.classList.add('hidden');
          }
        }
      }

      function syncWithPermissions() {
        const rmApps = (window as any).RMApps;
        if (!rmApps) return;

        const appsConfig = rmApps.getAll();
        const cards = document.querySelectorAll('.app-card');

        let publicCount = 0;
        let privateCount = 0;
        let visibleTotal = 0;

        cards.forEach(cardEl => {
          const card = cardEl as HTMLElement;
          const appId = card.getAttribute('data-app-id');
          const config = appsConfig.find((a: any) => a.id === appId);
          if (!config) return;

          const isPrivate = config.isPrivate;
          const isVisible = config.visible !== false;

          card.setAttribute('data-type', isPrivate ? 'private' : 'public');
          card.setAttribute('data-visible', isVisible ? 'true' : 'false');

          if (isVisible) {
            visibleTotal++;
            if (isPrivate) privateCount++;
            else publicCount++;
          }
        });

        // Update filter buttons text
        const allBtn = document.getElementById('filter-all-btn');
        const pubBtn = document.getElementById('filter-public-btn');
        const privBtn = document.getElementById('filter-private-btn');

        if (allBtn) allBtn.textContent = `Todas (${visibleTotal})`;
        if (pubBtn) pubBtn.textContent = `Públicas (${publicCount})`;
        if (privBtn) privBtn.textContent = `🔒 Privadas (${privateCount})`;

        applyFilters();
      }

      // Handle Type Filter Buttons
      const filterBtns = document.querySelectorAll('.filter-btn');
      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          filterBtns.forEach(b => {
            b.classList.remove('active', 'bg-slate-900', 'text-white', 'dark:bg-white', 'dark:text-slate-950', 'border-slate-900', 'dark:border-white');
            b.classList.add('bg-white', 'text-slate-600', 'dark:bg-slate-900/60', 'dark:text-slate-400', 'border-slate-200', 'dark:border-slate-800');
          });
          btn.classList.add('active', 'bg-slate-900', 'text-white', 'dark:bg-white', 'dark:text-slate-950', 'border-slate-900', 'dark:border-white');
          btn.classList.remove('bg-white', 'text-slate-600', 'dark:bg-slate-900/60', 'dark:text-slate-400', 'border-slate-200', 'dark:border-slate-800');

          currentFilter = btn.getAttribute('data-filter') || 'all';
          applyFilters();
        });
      });

      // Handle Group Filter Buttons
      const groupBtns = document.querySelectorAll('.group-filter-btn');
      groupBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const selectedGroup = btn.getAttribute('data-group') || 'all';
          if (currentGroup === selectedGroup) {
            currentGroup = 'all';
            btn.classList.remove('bg-slate-200', 'dark:bg-slate-800', 'font-bold', 'text-slate-900', 'dark:text-white');
          } else {
            groupBtns.forEach(b => b.classList.remove('bg-slate-200', 'dark:bg-slate-800', 'font-bold', 'text-slate-900', 'dark:text-white'));
            btn.classList.add('bg-slate-200', 'dark:bg-slate-800', 'font-bold', 'text-slate-900', 'dark:text-white');
            currentGroup = selectedGroup;
          }
          applyFilters();
        });
      });

      // Handle Search Input
      const searchInput = document.getElementById('tool-search-input') as HTMLInputElement | null;
      const clearSearchBtn = document.getElementById('clear-search-btn');
      const resetSearchBtn = document.getElementById('reset-search-btn');

      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          searchQuery = (searchInput.value || '').trim().toLowerCase();
          if (clearSearchBtn) {
            if (searchQuery) clearSearchBtn.classList.remove('hidden');
            else clearSearchBtn.classList.add('hidden');
          }
          applyFilters();
        });
      }

      function clearSearch() {
        if (searchInput) {
          searchInput.value = '';
          searchQuery = '';
          if (clearSearchBtn) clearSearchBtn.classList.add('hidden');
          applyFilters();
          searchInput.focus();
        }
      }

      if (clearSearchBtn) clearSearchBtn.addEventListener('click', clearSearch);
      if (resetSearchBtn) resetSearchBtn.addEventListener('click', clearSearch);

      // Handle Lock / Unlock toggle
      const toggleBtn = document.getElementById('auth-toggle-btn');
      if (toggleBtn) {
        toggleBtn.addEventListener('click', () => {
          if (isUnlocked()) {
            if (confirm('¿Deseas bloquear el acceso a las aplicaciones privadas?')) {
              sessionStorage.removeItem(STORAGE_KEY);
              localStorage.removeItem(STORAGE_KEY);
              updateAuthUI();
            }
          } else {
            window.location.href = '/apps/panel-control/';
          }
        });
      }

      // Listen for permissions changes from the control panel
      window.addEventListener('rm_apps_config_changed', syncWithPermissions);
      window.addEventListener('storage', (e) => {
        if (e.key === 'rm_apps_permissions_override') syncWithPermissions();
        if (e.key === STORAGE_KEY) updateAuthUI();
      });

      // PWA Install prompt handling
      let deferredInstallPrompt: any = null;
      const installBtn = document.getElementById('pwa-install-btn');

      window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        deferredInstallPrompt = e;
        if (installBtn) {
          installBtn.classList.remove('hidden');
          installBtn.classList.add('inline-flex');
        }
      });

      const isStandalone = window.matchMedia('(display-mode: standalone)').matches || (navigator as any).standalone;
      if (!isStandalone && installBtn && /iPhone|iPad|iPod|Android/i.test(navigator.userAgent)) {
        installBtn.classList.remove('hidden');
        installBtn.classList.add('inline-flex');
      }

      if (installBtn) {
        installBtn.addEventListener('click', async () => {
          if (deferredInstallPrompt) {
            deferredInstallPrompt.prompt();
            const { outcome } = await deferredInstallPrompt.userChoice;
            if (outcome === 'accepted') {
              installBtn.classList.add('hidden');
            }
            deferredInstallPrompt = null;
          } else {
            alert('Para instalar esta app en tu pantalla de inicio:\n\n• En Safari (iOS): Pulsa Compartir y "Añadir a pantalla de inicio".\n• En Chrome (Android/PC): Pulsa en ⋮ y "Instalar aplicación".');
          }
        });
      }

      let autoSlideTimer: any = null;

      function setupSliderControls() {
        const slider = document.getElementById('home-external-tools');
        const prevBtn = document.getElementById('slider-prev-btn');
        const nextBtn = document.getElementById('slider-next-btn');
        if (!slider) return;

        function slideNext() {
          if (!slider) return;
          const maxScroll = slider.scrollWidth - slider.clientWidth;
          if (slider.scrollLeft >= maxScroll - 15) {
            slider.scrollTo({ left: 0, behavior: 'smooth' });
          } else {
            slider.scrollBy({ left: 290, behavior: 'smooth' });
          }
        }

        function slidePrev() {
          if (!slider) return;
          if (slider.scrollLeft <= 15) {
            const maxScroll = slider.scrollWidth - slider.clientWidth;
            slider.scrollTo({ left: maxScroll, behavior: 'smooth' });
          } else {
            slider.scrollBy({ left: -290, behavior: 'smooth' });
          }
        }

        if (prevBtn) {
          prevBtn.onclick = () => {
            slidePrev();
            resetAutoSlide();
          };
        }
        if (nextBtn) {
          nextBtn.onclick = () => {
            slideNext();
            resetAutoSlide();
          };
        }

        function startAutoSlide() {
          clearInterval(autoSlideTimer);
          autoSlideTimer = setInterval(() => {
            slideNext();
          }, 4500);
        }

        function resetAutoSlide() {
          clearInterval(autoSlideTimer);
          startAutoSlide();
        }

        slider.onmouseenter = () => clearInterval(autoSlideTimer);
        slider.onmouseleave = () => startAutoSlide();
        slider.ontouchstart = () => clearInterval(autoSlideTimer);
        slider.ontouchend = () => startAutoSlide();

        startAutoSlide();
      }

      function renderHomeExternalTools() {
        const container = document.getElementById('home-external-tools');
        if (!container) return;

        let tools = [
          { title: 'Nube de archivos', desc: 'Documentos y backup', url: 'https://drive.google.com' },
          { title: 'Calendario', desc: 'Agenda semanal', url: 'https://calendar.google.com' },
          { title: 'Lector de notas', desc: 'Notas y listas', url: 'https://keep.google.com' }
        ];

        try {
          const saved = localStorage.getItem('rm_external_tools_state');
          if (saved) tools = JSON.parse(saved);
        } catch (e) {}

        container.innerHTML = '';
        tools.forEach((t: any) => {
          let u = (t.url || '').trim();
          if (!u.startsWith('http://') && !u.startsWith('https://')) u = 'https://' + u;

          const card = document.createElement('a');
          card.href = u;
          card.target = '_blank';
          card.rel = 'noopener noreferrer';
          card.className = 'w-[260px] sm:w-[280px] shrink-0 snap-start tool-card-surface group rounded-2xl p-5 transition-all duration-200 flex flex-col justify-between';
          card.innerHTML = `
            <div>
              <div class="text-[11px] font-mono text-slate-500 dark:text-slate-400 group-hover:text-sky-500 transition-colors uppercase tracking-wider mb-2">EXTERNO</div>
              <h4 class="font-bold text-slate-900 dark:text-white text-base group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors mb-1 truncate">${t.title}</h4>
              <p class="text-xs text-slate-600 dark:text-slate-400 line-clamp-2 leading-relaxed mb-4">${t.desc || 'Acceso directo externo'}</p>
            </div>
            <div class="pt-3 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs font-mono text-sky-600 dark:text-sky-400 font-semibold">
              <span>Abrir</span>
              <span class="group-hover:translate-x-1 transition-transform">↗</span>
            </div>
          `;
          container.appendChild(card);
        });

        setupSliderControls();
      }

      window.addEventListener('rm_external_tools_updated', renderHomeExternalTools);
      window.addEventListener('storage', (e) => {
        if (e.key === 'rm_external_tools_state') renderHomeExternalTools();
      });

      document.addEventListener('DOMContentLoaded', () => {
        updateAuthUI();
        syncWithPermissions();
        renderHomeExternalTools();
      });
      updateAuthUI();
      syncWithPermissions();
      renderHomeExternalTools();
    </script>
  </body>
</html>
