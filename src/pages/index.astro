---
import BaseHead from "../components/BaseHead.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";

const apps = [
  {
    id: "dividir-cuenta",
    href: "/apps/dividir-cuenta/",
    title: "Dividir Cuenta & Ticket",
    category: "FINANZAS",
    accent: "€ Tickets & OCR",
    icon: "🧾",
    colorStyle: "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/20 group-hover:border-emerald-500/50",
    isPrivate: false,
    group: "gestion",
    desc: "Calcula qué paga cada comensal según consumiciones. Escáner de tickets con cámara/OCR y reparto directo para Bizum.",
    tags: ["Restaurante", "Bizum", "OCR", "Calculadora"]
  },
  {
    id: "notas-privadas",
    href: "/apps/notas-privadas/",
    title: "Cuaderno Privado",
    category: "NOTAS",
    accent: "🔒 Cifrado Local",
    icon: "📝",
    colorStyle: "bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/20 group-hover:border-amber-500/50",
    isPrivate: true,
    group: "gestion",
    desc: "Bloc de notas rápido y persistente en almacenamiento local. Ideal para borradores, snippets temporales y tareas.",
    tags: ["Privada", "Notas", "LocalStorage", "Borradores"]
  },
  {
    id: "habitos",
    href: "/apps/habitos/",
    title: "Hábitos & Rutinas",
    category: "HÁBITOS",
    accent: "Racha Diaria",
    icon: "🎯",
    colorStyle: "bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border-cyan-500/20 group-hover:border-cyan-500/50",
    isPrivate: false,
    group: "gestion",
    desc: "Seguimiento diario de hábitos y rachas semanales para mantener la constancia en tus rutinas personales.",
    tags: ["Hábitos", "Rutinas", "Productividad", "Objetivos"]
  },
  {
    id: "json",
    href: "/apps/json-formatter/",
    title: "JSON Formatter & Validator",
    category: "DEV TOOLS",
    accent: "Validador & Minify",
    icon: "{ }",
    colorStyle: "bg-blue-500/10 text-blue-600 dark:text-blue-400 border-blue-500/20 group-hover:border-blue-500/50",
    isPrivate: false,
    group: "utilidades",
    desc: "Valida sintaxis, embellece con sangría configurable y compacta datos JSON en tiempo real en tu navegador.",
    tags: ["JSON", "Formateador", "Validador", "Minify"]
  },
  {
    id: "sql",
    href: "/apps/sql-formatter/",
    title: "SQL Formatter",
    category: "DEV TOOLS",
    accent: "Query Beautifier",
    icon: "SQL",
    colorStyle: "bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 border-indigo-500/20 group-hover:border-indigo-500/50",
    isPrivate: false,
    group: "utilidades",
    desc: "Convierte consultas SQL complejas o desordenadas en código limpio, estructurado y con palabras clave en mayúsculas.",
    tags: ["SQL", "Consultas", "Bases de datos", "Limpieza"]
  },
  {
    id: "hash-uuid",
    href: "/apps/hash-uuid/",
    title: "Hashes & UUIDs",
    category: "SEGURIDAD",
    accent: "WebCrypto SHA",
    icon: "#",
    colorStyle: "bg-purple-500/10 text-purple-600 dark:text-purple-400 border-purple-500/20 group-hover:border-purple-500/50",
    isPrivate: false,
    group: "utilidades",
    desc: "Genera UUIDs v4 en lote, passwords criptográficas y calcula hashes SHA-256, SHA-512 y SHA-1 al vuelo.",
    tags: ["UUID v4", "SHA-256", "Contraseñas", "WebCrypto"]
  },
  {
    id: "color",
    href: "/apps/color-converter/",
    title: "Colores & Contraste WCAG",
    category: "DISEÑO",
    accent: "HEX / RGB / WCAG",
    icon: "🎨",
    colorStyle: "bg-pink-500/10 text-pink-600 dark:text-pink-400 border-pink-500/20 group-hover:border-pink-500/50",
    isPrivate: false,
    group: "utilidades",
    desc: "Conversión bidireccional entre HEX, RGB y HSL con calculadora en vivo de ratios de contraste y accesibilidad WCAG.",
    tags: ["HEX", "RGB", "HSL", "WCAG Contrast"]
  },
  {
    id: "pomodoro",
    href: "/apps/pomodoro/",
    title: "Temporizador Pomodoro",
    category: "TIEMPO",
    accent: "Enfoque & Pausas",
    icon: "⏱️",
    colorStyle: "bg-orange-500/10 text-orange-600 dark:text-orange-400 border-orange-500/20 group-hover:border-orange-500/50",
    isPrivate: false,
    group: "utilidades",
    desc: "Bloques de trabajo enfocado y descansos configurables con contador de ciclos y avisos sonoros integrados.",
    tags: ["Productividad", "Pomodoro", "Enfoque", "Tiempo"]
  },
  {
    id: "base64",
    href: "/apps/base64-converter/",
    title: "Base64 & URL Encoder",
    category: "CONVERTIDOR",
    accent: "UTF-8 / URL Safe",
    icon: "64",
    colorStyle: "bg-teal-500/10 text-teal-600 dark:text-teal-400 border-teal-500/20 group-hover:border-teal-500/50",
    isPrivate: false,
    group: "sistema",
    desc: "Codifica y decodifica texto con soporte UTF-8 completo, además de utilidades directas para URL encoding.",
    tags: ["Base64", "URL Encode", "UTF-8", "String Tools"]
  },
  {
    id: "mis-servidores",
    href: "/apps/mis-servidores/",
    title: "Servidores & Accesos",
    category: "SISTEMAS",
    accent: "🔒 SSH / DevOps",
    icon: "⚡",
    colorStyle: "bg-rose-500/10 text-rose-600 dark:text-rose-400 border-rose-500/20 group-hover:border-rose-500/50",
    isPrivate: true,
    group: "sistema",
    desc: "Fichero privado de servidores, IPs, accesos SSH habituales y gestor del PIN maestro de acceso.",
    tags: ["Privada", "DevOps", "Servidores", "Seguridad"]
  },
  {
    id: "herramientas-externas",
    href: "/apps/herramientas-externas/",
    title: "Herramientas Externas",
    category: "EXTERNO",
    accent: "Accesos Directos ↗",
    icon: "↗",
    colorStyle: "bg-sky-500/10 text-sky-600 dark:text-sky-400 border-sky-500/20 group-hover:border-sky-500/50",
    isPrivate: false,
    group: "externas",
    desc: "Gestor de accesos directos personalizables a herramientas y servicios web externos con enlaces directos.",
    tags: ["Accesos", "Enlaces", "Herramientas", "Dashboard"]
  }
];
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <BaseHead title={`${SITE_TITLE} — Suite Personal de Herramientas`} description={SITE_DESCRIPTION} />
    <!-- Dynamic App Permissions & Auth Guard -->
    <script is:inline src="/apps/shared/auth-guard.js"></script>
  </head>
  <body class="bg-slate-50 dark:bg-[#08090d] text-slate-900 dark:text-slate-100 min-h-screen flex flex-col font-sans transition-colors duration-250 relative overflow-x-hidden bg-dot-grid">
    
    <!-- Ambient Gradient Mesh (Decorative) -->
    <div class="absolute top-[-80px] left-1/2 -translate-x-1/2 w-[700px] sm:w-[900px] h-[350px] bg-gradient-to-tr from-sky-500/15 via-indigo-500/10 to-purple-500/15 rounded-full blur-3xl pointer-events-none -z-10 animate-float"></div>
    <div class="absolute top-[35%] right-[-100px] w-[450px] h-[450px] bg-gradient-to-br from-emerald-500/10 to-cyan-500/15 rounded-full blur-3xl pointer-events-none -z-10 animate-float-slow"></div>

    <!-- Floating Dock Navbar -->
    <Navbar currentPath="/" />

    <main class="w-full max-w-6xl mx-auto px-4 sm:px-6 pt-10 sm:pt-14 pb-16 flex-1">
      
      <!-- Kinetic Hero Section -->
      <section class="mb-10 sm:mb-14 text-center max-w-3xl mx-auto">
        
        <!-- Live Telemetry Pill -->
        <div class="inline-flex items-center gap-2.5 px-3 py-1.5 rounded-full bg-white/80 dark:bg-slate-900/80 border border-slate-200/90 dark:border-slate-800/90 text-xs font-mono text-slate-600 dark:text-slate-400 shadow-xs mb-5 backdrop-blur-md">
          <span class="flex h-2 w-2 relative">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span class="font-bold text-slate-900 dark:text-white" id="stat-total-apps">{apps.length} herramientas</span>
          <span class="text-slate-300 dark:text-slate-700">|</span>
          <span class="text-emerald-600 dark:text-emerald-400 font-semibold">100% Local</span>
          <span class="text-slate-300 dark:text-slate-700">|</span>
          <span id="hero-date">OCT 2026</span>
        </div>

        <!-- Headline with Shimmer -->
        <h1 class="text-4xl sm:text-6xl font-black text-slate-900 dark:text-white tracking-tight leading-[1.08] mb-4">
          Banco de herramientas <br class="hidden sm:inline" />
          <span class="text-shimmer">listo para fluir.</span>
        </h1>

        <!-- Subtitle -->
        <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 max-w-xl mx-auto leading-relaxed mb-6 font-normal">
          Micro-aplicaciones autónomas diseñadas para el trabajo diario. Sin cookies, sin tracking externo y con almacenamiento local en tu navegador.
        </p>

        <!-- PWA install action (revealed when supported) -->
        <div class="flex items-center justify-center gap-3">
          <button
            id="pwa-install-btn"
            type="button"
            class="hidden px-5 py-2.5 rounded-xl bg-slate-900 dark:bg-white text-white dark:text-slate-950 text-xs font-mono font-bold items-center gap-2 hover:scale-105 active:scale-95 transition-all shadow-md cursor-pointer"
          >
            <span>📲 Instalar Aplicación</span>
          </button>
        </div>

      </section>

      <!-- Command Palette Style Search & Filter Deck -->
      <section class="mb-10 max-w-3xl mx-auto">
        
        <!-- Interactive Search Bar -->
        <div class="relative group mb-4">
          <div class="absolute -inset-0.5 bg-gradient-to-r from-sky-500/20 via-indigo-500/20 to-purple-500/20 rounded-2xl blur-sm opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
          
          <div class="relative flex items-center bg-white dark:bg-slate-900/90 rounded-2xl border border-slate-200/90 dark:border-slate-800/90 shadow-sm transition-all">
            <div class="pl-4 pr-2 text-slate-400 dark:text-slate-500 pointer-events-none">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>

            <input
              type="text"
              id="tool-search-input"
              placeholder="Buscar por nombre, tag o función (p. ej. JSON, OCR, SHA, Hash)..."
              class="w-full py-3.5 pr-20 bg-transparent text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-500 text-sm focus:outline-none font-medium"
              autocomplete="off"
            />

            <!-- Keyboard shortcut indicator & Clear button -->
            <div class="pr-3 flex items-center gap-1.5">
              <button
                id="clear-search-btn"
                type="button"
                class="hidden w-6 h-6 rounded-lg text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 items-center justify-center text-xs font-mono transition-colors cursor-pointer"
                title="Limpiar búsqueda"
              >
                ✕
              </button>
              <kbd class="hidden sm:inline-flex items-center gap-0.5 px-2 py-1 rounded-md text-[10px] font-mono font-medium text-slate-400 dark:text-slate-500 bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/60 shadow-2xs">
                /
              </kbd>
            </div>
          </div>
        </div>

        <!-- Filter Pills Bar & Security Quick Toggle -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-3">
          
          <!-- Category Filters -->
          <div class="flex items-center gap-1 overflow-x-auto no-scrollbar max-w-full p-1 rounded-xl bg-slate-200/50 dark:bg-slate-900/60 border border-slate-200/70 dark:border-slate-800/70 text-xs font-mono">
            <button
              type="button"
              id="filter-all-btn"
              class="filter-btn active px-3 py-1.5 rounded-lg bg-white dark:bg-slate-800 text-slate-900 dark:text-white font-bold shadow-2xs whitespace-nowrap transition-all cursor-pointer"
              data-filter="all"
            >
              Todas ({apps.length})
            </button>
            <button
              type="button"
              id="filter-public-btn"
              class="filter-btn px-3 py-1.5 rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white whitespace-nowrap transition-all cursor-pointer"
              data-filter="public"
            >
              Públicas ({apps.filter(a => !a.isPrivate).length})
            </button>
            <button
              type="button"
              id="filter-private-btn"
              class="filter-btn px-3 py-1.5 rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white whitespace-nowrap transition-all cursor-pointer"
              data-filter="private"
            >
              🔒 Privadas ({apps.filter(a => a.isPrivate).length})
            </button>
          </div>

          <!-- Private Apps Lock / Unlock Toggle -->
          <button
            id="auth-toggle-btn"
            type="button"
            class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/80 text-xs font-mono text-slate-600 dark:text-slate-400 hover:border-slate-300 dark:hover:border-slate-700 hover:text-slate-900 dark:hover:text-white transition-all shadow-2xs cursor-pointer self-end sm:self-auto"
            title="Estado del acceso privado"
          >
            <span id="auth-status-dot" class="w-2 h-2 rounded-full bg-slate-400"></span>
            <span id="auth-status-text">Comprobando...</span>
          </button>

        </div>

      </section>

      <!-- Tool Cards Grid with Cursor Spotlight Effect -->
      <section id="herramientas" class="mb-16">
        
        <!-- Empty state message -->
        <div id="no-results-msg" class="hidden text-center py-16 bg-white dark:bg-slate-900/50 rounded-3xl border border-dashed border-slate-300 dark:border-slate-800">
          <div class="text-3xl mb-2">🔍</div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white mb-1">Sin resultados</h3>
          <p class="text-xs font-mono text-slate-500 dark:text-slate-400 mb-4">No se encontró ninguna herramienta que coincida con tu búsqueda.</p>
          <button id="reset-search-btn" class="px-4 py-2 rounded-xl bg-sky-500 text-white font-mono text-xs font-bold hover:bg-sky-600 transition-colors cursor-pointer">
            Limpiar filtros
          </button>
        </div>

        <!-- 3-Column Modern Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5" id="tools-grid">
          {apps.map((app, index) => (
            <a
              href={app.href}
              data-app-id={app.id}
              data-type={app.isPrivate ? "private" : "public"}
              data-group={app.group}
              data-title={app.title.toLowerCase()}
              data-desc={app.desc.toLowerCase()}
              data-tags={app.tags.join(" ").toLowerCase()}
              class="app-card spotlight-card card-stagger-enter group rounded-3xl p-6 flex flex-col justify-between"
              style={`animation-delay: ${index * 35}ms;`}
            >
              <div>
                <!-- Top Badge Row -->
                <div class="flex items-center justify-between gap-3 mb-4">
                  <div class="flex items-center gap-3">
                    <div class={`w-11 h-11 rounded-2xl border flex items-center justify-center font-bold text-base transition-transform duration-300 group-hover:scale-110 group-hover:-rotate-3 shadow-xs ${app.colorStyle}`}>
                      {app.icon}
                    </div>
                    <div class="flex flex-col">
                      <span class="text-[10px] font-mono font-bold tracking-widest uppercase text-slate-400 dark:text-slate-500">
                        {app.category}
                      </span>
                      <span class="text-xs font-mono text-sky-600 dark:text-sky-400 font-semibold">
                        {app.accent}
                      </span>
                    </div>
                  </div>

                  {app.isPrivate ? (
                    <span class="inline-flex items-center gap-1 text-[10px] font-mono px-2.5 py-1 rounded-full bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20 font-semibold">
                      🔒 Privada
                    </span>
                  ) : (
                    <span class="inline-flex items-center gap-1 text-[10px] font-mono px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 font-semibold">
                      Pública
                    </span>
                  )}
                </div>

                <!-- Title & Description -->
                <h2 class="text-lg font-bold text-slate-900 dark:text-white group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors tracking-tight mb-2">
                  {app.title}
                </h2>
                <p class="text-xs sm:text-[13px] text-slate-600 dark:text-slate-400 line-clamp-2 leading-relaxed mb-4">
                  {app.desc}
                </p>

                <!-- Tags list -->
                <div class="flex flex-wrap gap-1.5 mb-4">
                  {app.tags.map((tag) => (
                    <span class="text-[10px] font-mono px-2 py-0.5 rounded-lg bg-slate-100 dark:bg-slate-800/80 text-slate-600 dark:text-slate-400 border border-slate-200/60 dark:border-slate-700/60">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>

              <!-- Card Action Bar -->
              <div class="pt-3 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs font-mono">
                <span class="text-slate-400 dark:text-slate-500 group-hover:text-slate-600 dark:group-hover:text-slate-300 transition-colors">
                  Abrir herramienta
                </span>
                <span class="w-6 h-6 rounded-lg bg-slate-100 dark:bg-slate-800/60 text-slate-500 dark:text-slate-400 flex items-center justify-center group-hover:bg-sky-500 group-hover:text-white dark:group-hover:text-slate-950 transition-all group-hover:translate-x-1">
                  →
                </span>
              </div>
            </a>
          ))}
        </div>
      </section>

      <!-- External Tools Deck Section -->
      <section id="externas" class="mb-12">
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-3">
            <h3 class="text-xs font-mono font-bold tracking-widest text-slate-500 dark:text-slate-400 uppercase">
              HERRAMIENTAS EXTERNAS
            </h3>
            <a href="/apps/herramientas-externas/" class="text-xs font-mono text-sky-600 dark:text-sky-400 hover:underline">
              Editar lista ↗
            </a>
          </div>

          <!-- Slider Navigation Arrows -->
          <div class="flex items-center gap-1.5">
            <button
              type="button"
              id="slider-prev-btn"
              class="w-8 h-8 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:border-slate-300 dark:hover:border-slate-700 flex items-center justify-center transition-all text-sm font-mono cursor-pointer shadow-2xs"
              title="Anterior"
            >
              ‹
            </button>
            <button
              type="button"
              id="slider-next-btn"
              class="w-8 h-8 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:border-slate-300 dark:hover:border-slate-700 flex items-center justify-center transition-all text-sm font-mono cursor-pointer shadow-2xs"
              title="Siguiente"
            >
              ›
            </button>
          </div>
        </div>

        <div class="relative overflow-hidden">
          <div
            class="flex gap-4 overflow-x-auto scroll-smooth snap-x snap-mandatory no-scrollbar py-2"
            id="home-external-tools"
          >
            <!-- Rendered dynamically by script -->
          </div>
        </div>
      </section>

    </main>

    <!-- Footer -->
    <Footer />

    {/* Client script for spotlight physics, real-time filtering, auth guard & slider */}
    <script>
      const STORAGE_KEY = 'rm_private_access_session';
      let currentFilter = 'all';
      let searchQuery = '';

      // Set formatted date in hero
      const heroDateEl = document.getElementById('hero-date');
      if (heroDateEl) {
        const now = new Date();
        const months = ['ENE', 'FEB', 'MAR', 'ABR', 'MAY', 'JUN', 'JUL', 'AGO', 'SEP', 'OCT', 'NOV', 'DIC'];
        heroDateEl.textContent = `${now.getDate()} ${months[now.getMonth()]} ${now.getFullYear()}`;
      }

      // Spotlight cursor tracking physics
      function setupSpotlightEffect() {
        const cards = document.querySelectorAll('.spotlight-card');
        cards.forEach((card) => {
          card.addEventListener('mousemove', (e) => {
            const rect = (card as HTMLElement).getBoundingClientRect();
            const x = (e as MouseEvent).clientX - rect.left;
            const y = (e as MouseEvent).clientY - rect.top;
            (card as HTMLElement).style.setProperty('--mouse-x', `${x}px`);
            (card as HTMLElement).style.setProperty('--mouse-y', `${y}px`);
          });
        });
      }

      function isUnlocked() {
        return sessionStorage.getItem(STORAGE_KEY) === 'unlocked' || localStorage.getItem(STORAGE_KEY) === 'unlocked';
      }

      function updateAuthUI() {
        const dot = document.getElementById('auth-status-dot');
        const text = document.getElementById('auth-status-text');
        const btn = document.getElementById('auth-toggle-btn');
        if (!dot || !text || !btn) return;

        if (isUnlocked()) {
          dot.className = 'w-2 h-2 rounded-full bg-emerald-500 shadow-xs';
          text.textContent = '🔒 Privadas: Desbloqueadas';
          btn.title = 'Haz clic para bloquear el acceso privado';
        } else {
          dot.className = 'w-2 h-2 rounded-full bg-rose-500 shadow-xs';
          text.textContent = '🔒 Privadas: Bloqueadas';
          btn.title = 'Las aplicaciones privadas pedirán PIN al entrar';
        }
      }

      function applyFilters() {
        const cards = document.querySelectorAll('.app-card');
        const noResults = document.getElementById('no-results-msg');
        let visibleCount = 0;

        cards.forEach(cardEl => {
          const card = cardEl as HTMLElement;
          const type = card.getAttribute('data-type');
          const isConfigVisible = card.getAttribute('data-visible') !== 'false';
          const title = card.getAttribute('data-title') || '';
          const desc = card.getAttribute('data-desc') || '';
          const tags = card.getAttribute('data-tags') || '';

          if (!isConfigVisible) {
            card.style.display = 'none';
            return;
          }

          const matchesType = currentFilter === 'all' || currentFilter === type;
          const matchesSearch = !searchQuery || 
            title.includes(searchQuery) || 
            desc.includes(searchQuery) || 
            tags.includes(searchQuery);

          if (matchesType && matchesSearch) {
            card.style.display = 'flex';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (noResults) {
          if (visibleCount === 0) noResults.classList.remove('hidden');
          else noResults.classList.add('hidden');
        }
      }

      function syncWithPermissions() {
        const rmApps = (window as any).RMApps;
        if (!rmApps) return;

        const appsConfig = rmApps.getAll();
        const cards = document.querySelectorAll('.app-card');

        let publicCount = 0;
        let privateCount = 0;
        let visibleTotal = 0;

        cards.forEach(cardEl => {
          const card = cardEl as HTMLElement;
          const appId = card.getAttribute('data-app-id');
          const config = appsConfig.find((a: any) => a.id === appId);
          if (!config) return;

          const isPrivate = config.isPrivate;
          const isVisible = config.visible !== false;

          card.setAttribute('data-type', isPrivate ? 'private' : 'public');
          card.setAttribute('data-visible', isVisible ? 'true' : 'false');

          if (isVisible) {
            visibleTotal++;
            if (isPrivate) privateCount++;
            else publicCount++;
          }
        });

        // Update filter buttons text
        const allBtn = document.getElementById('filter-all-btn');
        const pubBtn = document.getElementById('filter-public-btn');
        const privBtn = document.getElementById('filter-private-btn');

        if (allBtn) allBtn.textContent = `Todas (${visibleTotal})`;
        if (pubBtn) pubBtn.textContent = `Públicas (${publicCount})`;
        if (privBtn) privBtn.textContent = `🔒 Privadas (${privateCount})`;

        applyFilters();
      }

      // Handle Type Filter Buttons
      const filterBtns = document.querySelectorAll('.filter-btn');
      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          filterBtns.forEach(b => {
            b.classList.remove('active', 'bg-white', 'dark:bg-slate-800', 'text-slate-900', 'dark:text-white', 'font-bold', 'shadow-2xs');
            b.classList.add('text-slate-600', 'dark:text-slate-400');
          });
          btn.classList.add('active', 'bg-white', 'dark:bg-slate-800', 'text-slate-900', 'dark:text-white', 'font-bold', 'shadow-2xs');
          btn.classList.remove('text-slate-600', 'dark:text-slate-400');

          currentFilter = btn.getAttribute('data-filter') || 'all';
          applyFilters();
        });
      });

      // Handle Search Input & Keyboard shortcuts
      const searchInput = document.getElementById('tool-search-input') as HTMLInputElement | null;
      const clearSearchBtn = document.getElementById('clear-search-btn');
      const resetSearchBtn = document.getElementById('reset-search-btn');

      if (searchInput) {
        searchInput.addEventListener('input', () => {
          searchQuery = (searchInput.value || '').trim().toLowerCase();
          if (clearSearchBtn) {
            if (searchQuery) clearSearchBtn.classList.remove('hidden');
            else clearSearchBtn.classList.add('hidden');
          }
          applyFilters();
        });

        // Keyboard navigation: / to focus, Escape to clear
        window.addEventListener('keydown', (e) => {
          if (e.key === '/' && document.activeElement !== searchInput) {
            e.preventDefault();
            searchInput.focus();
          } else if (e.key === 'Escape' && document.activeElement === searchInput) {
            clearSearch();
            searchInput.blur();
          }
        });
      }

      function clearSearch() {
        if (searchInput) {
          searchInput.value = '';
          searchQuery = '';
          if (clearSearchBtn) clearSearchBtn.classList.add('hidden');
          applyFilters();
        }
      }

      if (clearSearchBtn) clearSearchBtn.addEventListener('click', clearSearch);
      if (resetSearchBtn) resetSearchBtn.addEventListener('click', () => {
        clearSearch();
        // Reset to all
        const allBtn = document.getElementById('filter-all-btn');
        if (allBtn) allBtn.click();
      });

      // Handle Lock / Unlock toggle
      const toggleBtn = document.getElementById('auth-toggle-btn');
      if (toggleBtn) {
        toggleBtn.addEventListener('click', () => {
          if (isUnlocked()) {
            if (confirm('¿Deseas bloquear el acceso a las aplicaciones privadas?')) {
              sessionStorage.removeItem(STORAGE_KEY);
              localStorage.removeItem(STORAGE_KEY);
              updateAuthUI();
            }
          } else {
            window.location.href = '/apps/panel-control/';
          }
        });
      }

      // Listen for permissions changes from the control panel
      window.addEventListener('rm_apps_config_changed', syncWithPermissions);
      window.addEventListener('storage', (e) => {
        if (e.key === 'rm_apps_permissions_override') syncWithPermissions();
        if (e.key === STORAGE_KEY) updateAuthUI();
      });

      // PWA Install prompt handling
      let deferredInstallPrompt: any = null;
      const installBtn = document.getElementById('pwa-install-btn');

      window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        deferredInstallPrompt = e;
        if (installBtn) {
          installBtn.classList.remove('hidden');
          installBtn.classList.add('inline-flex');
        }
      });

      const isStandalone = window.matchMedia('(display-mode: standalone)').matches || (navigator as any).standalone;
      if (!isStandalone && installBtn && /iPhone|iPad|iPod|Android/i.test(navigator.userAgent)) {
        installBtn.classList.remove('hidden');
        installBtn.classList.add('inline-flex');
      }

      if (installBtn) {
        installBtn.addEventListener('click', async () => {
          if (deferredInstallPrompt) {
            deferredInstallPrompt.prompt();
            const { outcome } = await deferredInstallPrompt.userChoice;
            if (outcome === 'accepted') {
              installBtn.classList.add('hidden');
            }
            deferredInstallPrompt = null;
          } else {
            alert('Para instalar esta app en tu pantalla de inicio:\n\n• En Safari (iOS): Pulsa Compartir y "Añadir a pantalla de inicio".\n• En Chrome (Android/PC): Pulsa en ⋮ y "Instalar aplicación".');
          }
        });
      }

      let autoSlideTimer: any = null;

      function setupSliderControls() {
        const slider = document.getElementById('home-external-tools');
        const prevBtn = document.getElementById('slider-prev-btn');
        const nextBtn = document.getElementById('slider-next-btn');
        if (!slider) return;

        function slideNext() {
          if (!slider) return;
          const maxScroll = slider.scrollWidth - slider.clientWidth;
          if (slider.scrollLeft >= maxScroll - 15) {
            slider.scrollTo({ left: 0, behavior: 'smooth' });
          } else {
            slider.scrollBy({ left: 290, behavior: 'smooth' });
          }
        }

        function slidePrev() {
          if (!slider) return;
          if (slider.scrollLeft <= 15) {
            const maxScroll = slider.scrollWidth - slider.clientWidth;
            slider.scrollTo({ left: maxScroll, behavior: 'smooth' });
          } else {
            slider.scrollBy({ left: -290, behavior: 'smooth' });
          }
        }

        if (prevBtn) {
          prevBtn.onclick = () => {
            slidePrev();
            resetAutoSlide();
          };
        }
        if (nextBtn) {
          nextBtn.onclick = () => {
            slideNext();
            resetAutoSlide();
          };
        }

        function startAutoSlide() {
          clearInterval(autoSlideTimer);
          autoSlideTimer = setInterval(() => {
            slideNext();
          }, 4500);
        }

        function resetAutoSlide() {
          clearInterval(autoSlideTimer);
          startAutoSlide();
        }

        slider.onmouseenter = () => clearInterval(autoSlideTimer);
        slider.onmouseleave = () => startAutoSlide();
        slider.ontouchstart = () => clearInterval(autoSlideTimer);
        slider.ontouchend = () => startAutoSlide();

        startAutoSlide();
      }

      function renderHomeExternalTools() {
        const container = document.getElementById('home-external-tools');
        if (!container) return;

        let tools = [
          { title: 'Nube de archivos', desc: 'Documentos y backup', url: 'https://drive.google.com' },
          { title: 'Calendario', desc: 'Agenda semanal', url: 'https://calendar.google.com' },
          { title: 'Lector de notas', desc: 'Notas y listas', url: 'https://keep.google.com' }
        ];

        try {
          const saved = localStorage.getItem('rm_external_tools_state');
          if (saved) tools = JSON.parse(saved);
        } catch (e) {}

        container.innerHTML = '';
        tools.forEach((t: any) => {
          let u = (t.url || '').trim();
          if (!u.startsWith('http://') && !u.startsWith('https://')) u = 'https://' + u;

          const card = document.createElement('a');
          card.href = u;
          card.target = '_blank';
          card.rel = 'noopener noreferrer';
          card.className = 'w-[260px] sm:w-[280px] shrink-0 snap-start spotlight-card group rounded-2xl p-5 transition-all duration-200 flex flex-col justify-between';
          card.innerHTML = `
            <div>
              <div class="text-[10px] font-mono text-slate-400 dark:text-slate-500 group-hover:text-sky-500 transition-colors uppercase tracking-wider mb-2 font-bold">EXTERNO</div>
              <h4 class="font-bold text-slate-900 dark:text-white text-base group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors mb-1 truncate">${t.title}</h4>
              <p class="text-xs text-slate-600 dark:text-slate-400 line-clamp-2 leading-relaxed mb-4">${t.desc || 'Acceso directo externo'}</p>
            </div>
            <div class="pt-3 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs font-mono text-sky-600 dark:text-sky-400 font-semibold">
              <span>Abrir</span>
              <span class="group-hover:translate-x-1 transition-transform">↗</span>
            </div>
          `;
          container.appendChild(card);
        });

        setupSliderControls();
        setupSpotlightEffect();
      }

      window.addEventListener('rm_external_tools_updated', renderHomeExternalTools);
      window.addEventListener('storage', (e) => {
        if (e.key === 'rm_external_tools_state') renderHomeExternalTools();
      });

      document.addEventListener('DOMContentLoaded', () => {
        updateAuthUI();
        syncWithPermissions();
        renderHomeExternalTools();
        setupSpotlightEffect();
      });

      updateAuthUI();
      syncWithPermissions();
      renderHomeExternalTools();
      setupSpotlightEffect();
    </script>
  </body>
</html>
