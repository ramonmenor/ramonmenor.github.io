---
import BaseHead from "../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";

const apps = [
  {
    id: "dividir-cuenta",
    href: "/apps/dividir-cuenta/",
    title: "Dividir Cuenta & Ticket",
    category: "FINANZAS",
    accent: "€ Tickets & Grupos",
    icon: "🧾",
    color: "border-teal-500/30 text-teal-400 bg-teal-500/10",
    isPrivate: false,
    group: "gestion",
    desc: "Calcula qué paga cada uno según lo que ha pedido o compartido. Incluye escaneo de tickets por cámara/OCR y reparto para Bizum.",
    tags: ["Restaurante", "Bizum", "OCR", "Calculadora"]
  },
  {
    id: "notas-privadas",
    href: "/apps/notas-privadas/",
    title: "Cuaderno Privado",
    category: "NOTAS",
    accent: "🔒 LocalStorage",
    icon: "📝",
    color: "border-amber-500/30 text-amber-400 bg-amber-500/10",
    isPrivate: true,
    group: "gestion",
    desc: "Bloc de notas rápido y persistente en almacenamiento local. Ideal para borradores, snippets temporales y tareas.",
    tags: ["Privada", "Notas", "LocalStorage", "Borradores"]
  },
  {
    id: "habitos",
    href: "/apps/habitos/",
    title: "Hábitos & Rutinas",
    category: "HÁBITOS",
    accent: "Rutina Diaria",
    icon: "🎯",
    color: "border-cyan-500/30 text-cyan-400 bg-cyan-500/10",
    isPrivate: false,
    group: "gestion",
    desc: "Seguimiento diario de hábitos y rachas semanales para mantener la constancia en tus rutinas.",
    tags: ["Hábitos", "Rutinas", "Productividad", "Objetivos"]
  },
  {
    id: "json",
    href: "/apps/json-formatter/",
    title: "JSON Formatter & Validator",
    category: "FORMATO",
    accent: "Validador & Minify",
    icon: "{ }",
    color: "border-cyan-500/30 text-cyan-400 bg-cyan-500/10",
    isPrivate: false,
    group: "utilidades",
    desc: "Valida sintaxis, embellece con sangría configurable y compacta datos JSON en tiempo real sin salir del navegador.",
    tags: ["JSON", "Formateador", "Validador", "Minify"]
  },
  {
    id: "sql",
    href: "/apps/sql-formatter/",
    title: "SQL Formatter",
    category: "CONSULTAS",
    accent: "Limpieza de queries",
    icon: "SQL",
    color: "border-blue-500/30 text-blue-400 bg-blue-500/10",
    isPrivate: false,
    group: "utilidades",
    desc: "Convierte consultas SQL complejas o desordenadas en código limpio, formateado y con palabras clave en mayúsculas.",
    tags: ["SQL", "Consultas", "Bases de datos", "Limpieza"]
  },
  {
    id: "hash-uuid",
    href: "/apps/hash-uuid/",
    title: "Hashes & UUIDs",
    category: "SEGURIDAD",
    accent: "SHA-256 / UUID v4",
    icon: "#",
    color: "border-purple-500/30 text-purple-400 bg-purple-500/10",
    isPrivate: false,
    group: "utilidades",
    desc: "Genera UUIDs v4 en lote, contraseñas criptográficamente seguras y calcula hashes SHA-256, SHA-512 y SHA-1 al vuelo.",
    tags: ["UUID v4", "SHA-256", "Contraseñas", "WebCrypto"]
  },
  {
    id: "color",
    href: "/apps/color-converter/",
    title: "Colores & Contraste WCAG",
    category: "DISEÑO",
    accent: "HEX / RGB / WCAG",
    icon: "🎨",
    color: "border-pink-500/30 text-pink-400 bg-pink-500/10",
    isPrivate: false,
    group: "utilidades",
    desc: "Conversión bidireccional entre HEX, RGB y HSL con calculadora en vivo de ratios de contraste WCAG (AA/AAA).",
    tags: ["HEX", "RGB", "HSL", "WCAG Contrast"]
  },
  {
    id: "pomodoro",
    href: "/apps/pomodoro/",
    title: "Temporizador Pomodoro",
    category: "TEMPORIZADOR",
    accent: "Enfoque & Pausas",
    icon: "⏱️",
    color: "border-cyan-500/30 text-cyan-400 bg-cyan-500/10",
    isPrivate: false,
    group: "utilidades",
    desc: "Bloques de trabajo enfocado y descansos configurables con contador de ciclos y avisos sonoros integrados.",
    tags: ["Productividad", "Pomodoro", "Enfoque", "Tiempo"]
  },
  {
    id: "base64",
    href: "/apps/base64-converter/",
    title: "Base64 & URL Encoder",
    category: "CONVERTIDOR",
    accent: "UTF-8 / URL Safe",
    icon: "64",
    color: "border-emerald-500/30 text-emerald-400 bg-emerald-500/10",
    isPrivate: false,
    group: "sistema",
    desc: "Codifica y decodifica texto con soporte UTF-8 completo, además de utilidades directas para URL encoding.",
    tags: ["Base64", "URL Encode", "UTF-8", "String Tools"]
  },
  {
    id: "mis-servidores",
    href: "/apps/mis-servidores/",
    title: "Servidores & Accesos",
    category: "SISTEMAS",
    accent: "🔒 SSH / DevOps",
    icon: "⚡",
    color: "border-rose-500/30 text-rose-400 bg-rose-500/10",
    isPrivate: true,
    group: "sistema",
    desc: "Fichero privado de servidores, IPs, accesos SSH habituales y gestor del PIN maestro de acceso.",
    tags: ["Privada", "DevOps", "Servidores", "Seguridad"]
  },
  {
    id: "herramientas-externas",
    href: "/apps/herramientas-externas/",
    title: "Herramientas Externas",
    category: "EXTERNO",
    accent: "Accesos Directos ↗",
    icon: "↗",
    color: "border-sky-500/30 text-sky-400 bg-sky-500/10",
    isPrivate: false,
    group: "externas",
    desc: "Gestor de accesos directos personalizables a herramientas y servicios web externos con enlaces directos.",
    tags: ["Accesos", "Enlaces", "Herramientas", "Dashboard"]
  }
];

const gestionApps = apps.filter(a => a.group === 'gestion');
const utilidadesApps = apps.filter(a => a.group === 'utilidades');
const sistemaApps = apps.filter(a => a.group === 'sistema');
const externasApps = apps.filter(a => a.group === 'externas');
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead title={`${SITE_TITLE} — Suite Personal`} description={SITE_DESCRIPTION} />
    <!-- Dynamic App Permissions & Auth Guard -->
    <script is:inline src="/apps/shared/auth-guard.js"></script>
    <style>
      /* Glowing accent utilities */
      .glow-cyan {
        box-shadow: 0 0 25px -5px rgba(6, 182, 212, 0.25);
      }
      .glow-badge {
        box-shadow: 0 0 10px rgba(6, 182, 212, 0.4);
      }
    </style>
  </head>
  <body class="bg-[#080d16] text-slate-100 min-h-screen flex flex-col font-sans selection:bg-cyan-500/30 selection:text-cyan-300">
    
    <!-- Top Navbar -->
    <header class="sticky top-0 z-50 w-full bg-[#080d16]/90 backdrop-blur-md border-b border-[#172234]">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
        
        <!-- Brand -->
        <a href="/" class="flex items-center gap-3 group">
          <span class="w-8 h-8 rounded-lg bg-cyan-500/10 text-cyan-400 border border-cyan-500/30 font-black text-sm flex items-center justify-center group-hover:bg-cyan-500 group-hover:text-slate-950 transition-all">
            T
          </span>
          <div class="flex flex-col">
            <span class="font-bold text-white tracking-wider text-xs sm:text-sm leading-tight uppercase font-mono">
              TALLER
            </span>
            <span class="text-[10px] text-slate-400 font-mono tracking-widest leading-tight uppercase">
              PANEL PERSONAL
            </span>
          </div>
        </a>

        <!-- Center Nav Links -->
        <nav class="hidden md:flex items-center gap-6 text-xs font-mono tracking-wider uppercase text-slate-400">
          <a href="#gestion" class="hover:text-cyan-400 transition-colors">FINANZAS</a>
          <a href="#utilidades" class="hover:text-cyan-400 transition-colors">UTILIDADES</a>
          <a href="#sistema" class="hover:text-cyan-400 transition-colors">SISTEMA</a>
          <a href="/cv" class="hover:text-cyan-400 transition-colors">CV</a>
        </nav>

        <!-- Right Status & Controls -->
        <div class="flex items-center gap-3">
          <a
            href="/apps/panel-control/"
            class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#0f172a] border border-[#1e293b] text-xs font-mono text-slate-300 hover:border-cyan-500/50 hover:text-cyan-400 transition-all"
            title="Panel de permisos y control"
          >
            <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse glow-badge"></span>
            <span class="hidden sm:inline">Suite activa</span>
            <span class="sm:hidden">Panel</span>
          </a>

          <!-- Avatar -->
          <div class="w-8 h-8 rounded-full bg-[#162338] border border-[#24344d] text-cyan-300 text-xs font-bold font-mono flex items-center justify-center">
            R
          </div>
        </div>
      </div>
    </header>

    <main class="w-full max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12 flex-1">
      
      <!-- Top Grid: Hero Left + Quick Summary Widget Right -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-10">
        
        <!-- Left Hero Presentation (8 cols) -->
        <div class="lg:col-span-7 xl:col-span-8 flex flex-col justify-center">
          <div class="text-cyan-400 font-mono text-xs tracking-widest uppercase mb-2">
            HOLA, RAMÓN
          </div>

          <h1 class="text-4xl sm:text-6xl font-black text-white tracking-tight leading-none mb-4">
            Tu banco de trabajo, <span class="text-cyan-400">listo.</span>
          </h1>

          <p class="text-sm sm:text-base text-slate-400 max-w-xl leading-relaxed mb-6">
            Cada herramienta en su sitio. Abre lo que necesitas, mide lo que importa y vuelve cuando quieras. Desarrolladas de forma independiente para el día a día.
          </p>

          <div class="flex flex-wrap items-center gap-3 text-xs font-mono">
            <a
              href="/cv"
              class="px-4 py-2 rounded-xl bg-[#131d2e] border border-[#1e2d42] text-slate-200 hover:text-cyan-300 hover:border-cyan-500/40 transition-all"
            >
              Trayectoria / CV →
            </a>
            <button
              id="pwa-install-btn"
              type="button"
              class="hidden px-4 py-2 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold transition-all items-center gap-1.5 cursor-pointer glow-cyan"
            >
              <span>📲 Instalar App</span>
            </button>
            <a
              href="mailto:minombre@ramonmenor.es"
              class="px-4 py-2 rounded-xl bg-[#0f1726] border border-[#1b2637] text-slate-400 hover:text-slate-200 transition-colors"
            >
              minombre@ramonmenor.es
            </a>
          </div>
        </div>

        <!-- Right Summary Widget (4 cols, matches mockup) -->
        <div class="lg:col-span-5 xl:col-span-4 bg-[#0e1524] border border-[#1a263a] rounded-2xl p-5 sm:p-6 shadow-xl relative overflow-hidden">
          <div class="flex items-center justify-between text-xs font-mono mb-2">
            <span class="text-cyan-400 font-bold uppercase tracking-widest">DETALLE • SUITE</span>
            <span class="text-slate-500" id="widget-date">01 OCT 2026</span>
          </div>

          <h2 class="text-xl font-bold text-white tracking-tight mb-4">
            Resumen rápido
          </h2>

          <div class="mb-5">
            <div class="flex items-baseline gap-2">
              <span class="text-3xl font-black text-white font-mono" id="stat-total-apps">{apps.length}/{apps.length}</span>
              <span class="text-xs text-slate-400 font-mono">herramientas listas</span>
            </div>
          </div>

          <!-- Progress lines matching mockup -->
          <div class="space-y-3.5 mb-6 text-xs font-mono">
            <div>
              <div class="flex justify-between text-slate-400 mb-1">
                <span>Herramientas públicas</span>
                <span class="text-slate-300">{apps.filter(a => !a.isPrivate).length} / {apps.filter(a => !a.isPrivate).length}</span>
              </div>
              <div class="h-1.5 w-full bg-[#182337] rounded-full overflow-hidden">
                <div class="h-full bg-cyan-400 w-full rounded-full"></div>
              </div>
            </div>

            <div>
              <div class="flex justify-between text-slate-400 mb-1">
                <span>Herramientas privadas</span>
                <span class="text-slate-300">2 / 2</span>
              </div>
              <div class="h-1.5 w-full bg-[#182337] rounded-full overflow-hidden">
                <div class="h-full bg-cyan-400 w-full rounded-full"></div>
              </div>
            </div>

            <div>
              <div class="flex justify-between text-slate-400 mb-1">
                <span>Almacenamiento seguro</span>
                <span class="text-cyan-400">100% local</span>
              </div>
              <div class="h-1.5 w-full bg-[#182337] rounded-full overflow-hidden">
                <div class="h-full bg-cyan-400 w-full rounded-full"></div>
              </div>
            </div>
          </div>

          <!-- Action Button in Widget -->
          <a
            href="/apps/panel-control/"
            class="block w-full text-center py-3 px-4 rounded-xl bg-cyan-400 hover:bg-cyan-300 text-slate-950 font-bold font-mono text-xs uppercase tracking-wider transition-all glow-cyan"
          >
            Abrir Panel de Control
          </a>
        </div>
      </div>

      <!-- Filter Bar -->
      <div class="flex items-center justify-between gap-3 mb-8 pb-3 border-b border-[#162133] flex-wrap">
        <div class="inline-flex bg-[#0d1422] p-1 rounded-xl text-xs font-mono text-slate-400 border border-[#1b2637]">
          <button type="button" id="filter-all-btn" class="filter-btn active px-3 py-1.5 rounded-lg bg-cyan-500 text-slate-950 font-bold whitespace-nowrap" data-filter="all">
            Todas ({apps.length})
          </button>
          <button type="button" id="filter-public-btn" class="filter-btn px-3 py-1.5 rounded-lg hover:text-white transition-colors whitespace-nowrap" data-filter="public">
            Públicas ({apps.filter(a => !a.isPrivate).length})
          </button>
          <button type="button" id="filter-private-btn" class="filter-btn px-3 py-1.5 rounded-lg hover:text-white transition-colors whitespace-nowrap" data-filter="private">
            🔒 Privadas ({apps.filter(a => a.isPrivate).length})
          </button>
        </div>

        <button
          id="auth-toggle-btn"
          type="button"
          class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl border border-[#1b2637] bg-[#0d1422] text-xs font-mono text-slate-400 hover:border-slate-500 hover:text-slate-200 transition-colors"
          title="Estado del acceso privado"
        >
          <span id="auth-status-dot" class="w-2 h-2 rounded-full bg-slate-500"></span>
          <span id="auth-status-text">Comprobando...</span>
        </button>
      </div>

      <!-- Section 1: Gestión Personal & Finanzas -->
      <section id="gestion" class="mb-10">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-xs font-mono font-bold tracking-widest text-slate-400 uppercase">
            GESTIÓN PERSONAL & FINANZAS
          </h2>
          <span class="text-xs font-mono text-slate-500">0{gestionApps.length}</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5">
          {gestionApps.map((app) => (
            <a
              href={app.href}
              data-app-id={app.id}
              data-type={app.isPrivate ? "private" : "public"}
              class="app-card group bg-[#0e1626]/80 hover:bg-[#131d31] border border-[#192438] hover:border-cyan-500/40 rounded-2xl p-4 transition-all duration-200 flex flex-col justify-between"
            >
              <div>
                <div class="flex items-center justify-between text-[11px] font-mono mb-2">
                  <span class="text-slate-500 group-hover:text-cyan-400 transition-colors uppercase tracking-wider">{app.category}</span>
                  {app.isPrivate ? (
                    <span class="text-rose-400 text-[10px]">🔒 Privada</span>
                  ) : (
                    <span class="text-emerald-400 text-[10px]">Pública</span>
                  )}
                </div>
                <h3 class="font-bold text-white text-base group-hover:text-cyan-300 transition-colors mb-1">
                  {app.title}
                </h3>
                <p class="text-xs text-slate-400 line-clamp-2 leading-relaxed mb-3">
                  {app.desc}
                </p>
              </div>

              <div class="pt-2 border-t border-[#182337] flex items-center justify-between text-[11px] font-mono">
                <span class="text-cyan-400 font-semibold">{app.accent}</span>
                <span class="text-slate-500 group-hover:translate-x-0.5 transition-transform">→</span>
              </div>
            </a>
          ))}
        </div>
      </section>

      <!-- Section 2: Utilidades & Desarrollo -->
      <section id="utilidades" class="mb-10">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-xs font-mono font-bold tracking-widest text-slate-400 uppercase">
            UTILIDADES & HERRAMIENTAS DEV
          </h2>
          <span class="text-xs font-mono text-slate-500">0{utilidadesApps.length}</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5">
          {utilidadesApps.map((app) => (
            <a
              href={app.href}
              data-app-id={app.id}
              data-type={app.isPrivate ? "private" : "public"}
              class="app-card group bg-[#0e1626]/80 hover:bg-[#131d31] border border-[#192438] hover:border-cyan-500/40 rounded-2xl p-4 transition-all duration-200 flex flex-col justify-between"
            >
              <div>
                <div class="flex items-center justify-between text-[11px] font-mono mb-2">
                  <span class="text-slate-500 group-hover:text-cyan-400 transition-colors uppercase tracking-wider">{app.category}</span>
                  {app.isPrivate ? (
                    <span class="text-rose-400 text-[10px]">🔒 Privada</span>
                  ) : (
                    <span class="text-emerald-400 text-[10px]">Pública</span>
                  )}
                </div>
                <h3 class="font-bold text-white text-base group-hover:text-cyan-300 transition-colors mb-1">
                  {app.title}
                </h3>
                <p class="text-xs text-slate-400 line-clamp-2 leading-relaxed mb-3">
                  {app.desc}
                </p>
              </div>

              <div class="pt-2 border-t border-[#182337] flex items-center justify-between text-[11px] font-mono">
                <span class="text-cyan-400 font-semibold">{app.accent}</span>
                <span class="text-slate-500 group-hover:translate-x-0.5 transition-transform">→</span>
              </div>
            </a>
          ))}
        </div>
      </section>

      <!-- Section 3: Sistema & Servidores -->
      <section id="sistema" class="mb-12">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-xs font-mono font-bold tracking-widest text-slate-400 uppercase">
            SISTEMA & INFRAESTRUCTURA
          </h2>
          <span class="text-xs font-mono text-slate-500">02</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5">
          {sistemaApps.map((app) => (
            <a
              href={app.href}
              data-app-id={app.id}
              data-type={app.isPrivate ? "private" : "public"}
              class="app-card group bg-[#0e1626]/80 hover:bg-[#131d31] border border-[#192438] hover:border-cyan-500/40 rounded-2xl p-4 transition-all duration-200 flex flex-col justify-between"
            >
              <div>
                <div class="flex items-center justify-between text-[11px] font-mono mb-2">
                  <span class="text-slate-500 group-hover:text-cyan-400 transition-colors uppercase tracking-wider">{app.category}</span>
                  {app.isPrivate ? (
                    <span class="text-rose-400 text-[10px]">🔒 Privada</span>
                  ) : (
                    <span class="text-emerald-400 text-[10px]">Pública</span>
                  )}
                </div>
                <h3 class="font-bold text-white text-base group-hover:text-cyan-300 transition-colors mb-1">
                  {app.title}
                </h3>
                <p class="text-xs text-slate-400 line-clamp-2 leading-relaxed mb-3">
                  {app.desc}
                </p>
              </div>

              <div class="pt-2 border-t border-[#182337] flex items-center justify-between text-[11px] font-mono">
                <span class="text-cyan-400 font-semibold">{app.accent}</span>
                <span class="text-slate-500 group-hover:translate-x-0.5 transition-transform">→</span>
              </div>
            </a>
          ))}
      <!-- Section 4: Mis Herramientas Externas -->
      <section id="externas" class="mb-12">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-xs font-mono font-bold tracking-widest text-slate-400 uppercase">
            MIS HERRAMIENTAS EXTERNAS
          </h2>
          <a href="/apps/herramientas-externas/" class="text-xs font-mono text-cyan-400 hover:underline">
            editar
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5" id="home-external-tools">
          <!-- Rendered dynamically by script or defaults -->
        </div>
      </section>

    </main>

    <!-- Clean Minimal Footer matching mockup -->
    <footer class="w-full border-t border-[#162133] bg-[#070b13] py-6 text-xs font-mono text-slate-500">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row justify-between items-center gap-3">
        <div>
          <span>TALLER • SUITE PERSONAL</span>
          <span class="mx-2 text-slate-700">|</span>
          <span class="text-slate-400">RAMÓN MENOR</span>
        </div>
        <div class="flex items-center gap-4 text-[11px]">
          <span>Uso privado</span>
          <a href="/cv" class="hover:text-cyan-400 transition-colors">CV</a>
          <a href="/apps/panel-control/" class="hover:text-cyan-400 transition-colors">Panel</a>
        </div>
      </div>
    </footer>

    {/* Client script for filtering, permissions sync & session status */}
    <script>
      const STORAGE_KEY = 'rm_private_access_session';
      let currentFilter = 'all';

      // Set formatted date
      const dateEl = document.getElementById('widget-date');
      if (dateEl) {
        const now = new Date();
        const months = ['ENE', 'FEB', 'MAR', 'ABR', 'MAY', 'JUN', 'JUL', 'AGO', 'SEP', 'OCT', 'NOV', 'DIC'];
        const day = String(now.getDate()).padStart(2, '0');
        const month = months[now.getMonth()];
        const year = now.getFullYear();
        dateEl.textContent = `${day} ${month} ${year}`;
      }

      function isUnlocked() {
        return sessionStorage.getItem(STORAGE_KEY) === 'unlocked' || localStorage.getItem(STORAGE_KEY) === 'unlocked';
      }

      function updateAuthUI() {
        const dot = document.getElementById('auth-status-dot');
        const text = document.getElementById('auth-status-text');
        const btn = document.getElementById('auth-toggle-btn');
        if (!dot || !text || !btn) return;

        if (isUnlocked()) {
          dot.className = 'w-2 h-2 rounded-full bg-emerald-400';
          text.textContent = '🔒 Privadas: Desbloqueadas';
          btn.title = 'Haz clic para bloquear el acceso privado';
        } else {
          dot.className = 'w-2 h-2 rounded-full bg-rose-400';
          text.textContent = '🔒 Privadas: Bloqueadas';
          btn.title = 'Las aplicaciones privadas pedirán PIN al entrar';
        }
      }

      function applyCurrentFilter() {
        const cards = document.querySelectorAll('.app-card');
        cards.forEach(cardEl => {
          const card = cardEl as HTMLElement;
          const type = card.getAttribute('data-type');
          const isVisible = card.getAttribute('data-visible') !== 'false';

          if (!isVisible) {
            card.style.display = 'none';
            return;
          }

          if (currentFilter === 'all' || currentFilter === type) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      }

      function syncWithPermissions() {
        const rmApps = (window as any).RMApps;
        if (!rmApps) return;

        const appsConfig = rmApps.getAll();
        const cards = document.querySelectorAll('.app-card');

        let publicCount = 0;
        let privateCount = 0;
        let visibleTotal = 0;

        cards.forEach(cardEl => {
          const card = cardEl as HTMLElement;
          const appId = card.getAttribute('data-app-id');
          const config = appsConfig.find((a: any) => a.id === appId);
          if (!config) return;

          const isPrivate = config.isPrivate;
          const isVisible = config.visible !== false;

          card.setAttribute('data-type', isPrivate ? 'private' : 'public');
          card.setAttribute('data-visible', isVisible ? 'true' : 'false');

          if (isVisible) {
            visibleTotal++;
            if (isPrivate) privateCount++;
            else publicCount++;
          }
        });

        // Update filter buttons text
        const allBtn = document.getElementById('filter-all-btn');
        const pubBtn = document.getElementById('filter-public-btn');
        const privBtn = document.getElementById('filter-private-btn');

        if (allBtn) allBtn.textContent = `Todas (${visibleTotal})`;
        if (pubBtn) pubBtn.textContent = `Públicas (${publicCount})`;
        if (privBtn) privBtn.textContent = `🔒 Privadas (${privateCount})`;

        applyCurrentFilter();
      }

      // Handle Filter buttons
      const filterBtns = document.querySelectorAll('.filter-btn');
      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          filterBtns.forEach(b => {
            b.classList.remove('active', 'bg-cyan-500', 'text-slate-950', 'font-bold');
            b.classList.add('text-slate-400');
          });
          btn.classList.add('active', 'bg-cyan-500', 'text-slate-950', 'font-bold');
          btn.classList.remove('text-slate-400');

          currentFilter = btn.getAttribute('data-filter') || 'all';
          applyCurrentFilter();
        });
      });

      // Handle Lock / Unlock toggle
      const toggleBtn = document.getElementById('auth-toggle-btn');
      if (toggleBtn) {
        toggleBtn.addEventListener('click', () => {
          if (isUnlocked()) {
            if (confirm('¿Deseas bloquear el acceso a las aplicaciones privadas?')) {
              sessionStorage.removeItem(STORAGE_KEY);
              localStorage.removeItem(STORAGE_KEY);
              updateAuthUI();
            }
          } else {
            window.location.href = '/apps/panel-control/';
          }
        });
      }

      // Listen for permissions changes from the control panel
      window.addEventListener('rm_apps_config_changed', syncWithPermissions);
      window.addEventListener('storage', (e) => {
        if (e.key === 'rm_apps_permissions_override') syncWithPermissions();
        if (e.key === STORAGE_KEY) updateAuthUI();
      });

      // PWA Install prompt handling
      let deferredInstallPrompt: any = null;
      const installBtn = document.getElementById('pwa-install-btn');

      window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        deferredInstallPrompt = e;
        if (installBtn) {
          installBtn.classList.remove('hidden');
          installBtn.classList.add('inline-flex');
        }
      });

      const isStandalone = window.matchMedia('(display-mode: standalone)').matches || (navigator as any).standalone;
      if (!isStandalone && installBtn && /iPhone|iPad|iPod|Android/i.test(navigator.userAgent)) {
        installBtn.classList.remove('hidden');
        installBtn.classList.add('inline-flex');
      }

      if (installBtn) {
        installBtn.addEventListener('click', async () => {
          if (deferredInstallPrompt) {
            deferredInstallPrompt.prompt();
            const { outcome } = await deferredInstallPrompt.userChoice;
            if (outcome === 'accepted') {
              installBtn.classList.add('hidden');
            }
            deferredInstallPrompt = null;
          } else {
            alert('Para instalar esta app en tu pantalla de inicio:\n\n• En Safari (iPhone/iPad): Pulsa el botón Compartir y luego "Añadir a pantalla de inicio".\n• En Chrome (Android/PC): Pulsa en los tres puntos ⋮ y "Instalar aplicación".');
          }
        });
      }

      function renderHomeExternalTools() {
        const container = document.getElementById('home-external-tools');
        if (!container) return;

        let tools = [
          { title: 'Nube de archivos', desc: 'Documentos y backup', url: 'https://drive.google.com' },
          { title: 'Calendario', desc: 'Agenda semanal', url: 'https://calendar.google.com' },
          { title: 'Lector de notas', desc: 'Notas y listas', url: 'https://keep.google.com' }
        ];

        try {
          const saved = localStorage.getItem('rm_external_tools_state');
          if (saved) tools = JSON.parse(saved);
        } catch (e) {}

        container.innerHTML = '';
        tools.slice(0, 6).forEach((t: any) => {
          let u = (t.url || '').trim();
          if (!u.startsWith('http://') && !u.startsWith('https://')) u = 'https://' + u;

          const card = document.createElement('a');
          card.href = u;
          card.target = '_blank';
          card.rel = 'noopener noreferrer';
          card.className = 'group bg-[#0e1626]/80 hover:bg-[#131d31] border border-[#192438] hover:border-cyan-500/40 rounded-2xl p-4 transition-all duration-200 flex flex-col justify-between';
          card.innerHTML = `
            <div>
              <div class="text-[11px] font-mono text-slate-500 group-hover:text-cyan-400 transition-colors uppercase tracking-wider mb-2">EXTERNO</div>
              <h3 class="font-bold text-white text-base group-hover:text-cyan-300 transition-colors mb-1">${t.title}</h3>
              <p class="text-xs text-slate-400 line-clamp-2 leading-relaxed mb-3">${t.desc || ''}</p>
            </div>
            <div class="pt-2 border-t border-[#182337] flex items-center justify-between text-[11px] font-mono text-cyan-400">
              <span>Abrir</span>
              <span class="group-hover:translate-x-0.5 transition-transform">↗</span>
            </div>
          `;
          container.appendChild(card);
        });
      }

      window.addEventListener('rm_external_tools_updated', renderHomeExternalTools);
      window.addEventListener('storage', (e) => {
        if (e.key === 'rm_external_tools_state') renderHomeExternalTools();
      });

      document.addEventListener('DOMContentLoaded', () => {
        updateAuthUI();
        syncWithPermissions();
        renderHomeExternalTools();
      });
      updateAuthUI();
      syncWithPermissions();
      renderHomeExternalTools();
    </script>
  </body>
</html>
