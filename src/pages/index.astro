---
import BaseHead from "../components/BaseHead.astro";
import Navbar from "../components/Navbar.astro";
import SmartAssistant from "../components/SmartAssistant.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";

const capabilities = [
  {
    icon: "🧠",
    title: "Integración de IA & LLMs",
    desc: "Conexión de modelos de lenguaje (Gemini API, Claude 3.5, OpenAI GPT-4o, Ollama local), embeddings vectoriales y sistemas RAG para aplicaciones web."
  },
  {
    icon: "⚡",
    title: "Desarrollo Web Full Stack",
    desc: "Aplicaciones web veloces y escalables con Astro 5, TypeScript, PHP (Yii2 Framework), Tailwind CSS y bases de datos relacionales (MySQL, Turso)."
  },
  {
    icon: "🤖",
    title: "Agentes & Automatización",
    desc: "Orquestación de agentes con Function Calling y MCP para ejecución automática de consultas SQL, procesamiento de APIs e informes."
  },
  {
    icon: "🛡️",
    title: "Infraestructura & DevOps",
    desc: "Servidores Linux Debian, contenedores Docker, proxies Nginx, virtualización y despliegues estables para funcionamiento 24/7."
  }
];

const projects = [
  {
    title: "ramonmenor.es — AI Portfolio",
    tag: "Astro 5 + AI Assistant",
    desc: "Sitio web oficial desarrollado con Astro 5, TypeScript, Tailwind CSS y asistente conversacional de IA integrado en tiempo real.",
    tech: ["Astro 5", "TypeScript", "Tailwind", "AI Assistant"]
  },
  {
    title: "Mis Perlas — Búsqueda Semántica RAG",
    tag: "Turso DB + Embeddings",
    desc: "Aplicación de consulta semántica conectada a base de datos serverless Turso (@libsql/client) y vectorización de lenguaje natural.",
    tech: ["Turso DB", "Embeddings", "Astro", "TypeScript"]
  },
  {
    title: "Pipeline de Agentes LLM",
    tag: "Gemini / Claude + Docker",
    desc: "Orquestación multi-agente con ejecución automática de scripts, consultas de base de datos y procesamiento semántico.",
    tech: ["Gemini API", "Claude Sonnet", "Node.js", "Docker"]
  }
];

const experiences = [
  {
    period: "2018 — Presente",
    title: "Desarrollador Web Senior & Consultor de IA",
    company: "Freelance / Proyectos Propios",
    desc: "Desarrollo de aplicaciones web de alto rendimiento con Astro, TypeScript, PHP (Yii2), MySQL y Docker. Integración de modelos de IA (Gemini, Claude, OpenAI, Ollama), sistemas RAG y agentes de automatización."
  },
  {
    period: "2012 — 2018",
    title: "Desarrollador Backend & Administrador de Sistemas",
    company: "Desarrollo Web & Servicios TI",
    desc: "Construcción de backends robustos en PHP y MySQL, diseño relacional de datos, administración de servidores Linux Debian, virtualización y redes."
  },
  {
    period: "2006 — 2012",
    title: "Técnico de Infraestructura y Sistemas",
    company: "Servicios Informáticos",
    desc: "Gestión de servidores, mantenimiento de infraestructura tecnológica empresarial y soporte de sistemas."
  }
];
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead title={`${SITE_TITLE} — Desarrollador Web Full Stack & IA`} description={SITE_DESCRIPTION} />
  </head>
  <body class="bg-white text-slate-900 min-h-screen flex flex-col font-sans">
    <Navbar />

    <main class="w-full max-w-5xl mx-auto px-4 sm:px-6">
      {/* HERO SECTION */}
      <section id="inicio" class="pt-16 sm:pt-24 pb-16 border-b border-slate-200">
        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100 border border-slate-200 text-slate-700 text-xs font-mono mb-6">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            Desarrollador Web Activo con Inteligencia Artificial
          </div>

          <h1 class="text-4xl sm:text-5xl md:text-6xl font-black text-slate-900 tracking-tight leading-none mb-4">
            Ramón Menor
          </h1>

          <p class="text-xl sm:text-2xl font-bold text-blue-600 mb-6">
            Full Stack Web Developer & AI Integration Specialist
          </p>

          <p class="text-base sm:text-lg text-slate-600 leading-relaxed mb-8">
            Más de 15 años de experiencia acumulada en ingeniería de software web (<strong class="text-slate-900">PHP, Astro, TypeScript, MySQL, Docker, Linux Debian</strong>) aplicados al desarrollo de soluciones modernas e integración directa de <strong class="text-slate-900">Inteligencia Artificial</strong> (Gemini, Claude, OpenAI, Ollama, RAG y Agentes).
          </p>

          <div class="flex flex-wrap items-center gap-3">
            <a
              href="#asistente-ia"
              class="px-5 py-3 rounded-xl bg-blue-600 text-white font-medium text-sm hover:bg-blue-700 transition-colors shadow-sm"
            >
              ⚡ Probar Asistente IA
            </a>
            <a
              href="#experiencia"
              class="px-5 py-3 rounded-xl bg-slate-100 border border-slate-200 text-slate-800 font-medium text-sm hover:bg-slate-200 transition-colors"
            >
              📄 Ver CV & Experiencia
            </a>
            <a
              href="#contacto"
              class="px-5 py-3 rounded-xl bg-white border border-slate-300 text-slate-700 font-medium text-sm hover:border-slate-400 transition-colors"
            >
              Contacto
            </a>
          </div>
        </div>
      </section>

      {/* SMART ASSISTANT DEMO */}
      <section class="py-16 border-b border-slate-200">
        <SmartAssistant />
      </section>

      {/* CAPABILITIES SECTION */}
      <section id="capacidades" class="py-16 border-b border-slate-200 scroll-mt-16">
        <div class="mb-10">
          <span class="text-xs font-mono uppercase tracking-wider text-blue-600 font-bold">Capacidades Clave</span>
          <h2 class="text-3xl font-bold text-slate-900 tracking-tight mt-1">
            Desarrollo Web e Integración de IA
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {capabilities.map((cap) => (
            <div class="clean-card p-6">
              <div class="text-2xl mb-3">{cap.icon}</div>
              <h3 class="text-lg font-bold text-slate-900 mb-2">{cap.title}</h3>
              <p class="text-sm text-slate-600 leading-relaxed">{cap.desc}</p>
            </div>
          ))}
        </div>
      </section>

      {/* TECH STACK */}
      <section id="stack" class="py-16 border-b border-slate-200 scroll-mt-16">
        <div class="mb-8">
          <span class="text-xs font-mono uppercase tracking-wider text-blue-600 font-bold">Ecosistema Tecnológico</span>
          <h2 class="text-3xl font-bold text-slate-900 tracking-tight mt-1">
            Herramientas & Tecnologías
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="clean-card p-5 bg-slate-50/50">
            <h3 class="text-xs font-mono font-bold uppercase text-slate-500 mb-3">IA & LLMs</h3>
            <ul class="space-y-1.5 text-sm font-medium text-slate-800">
              <li>• Gemini API</li>
              <li>• Claude Sonnet 3.5</li>
              <li>• OpenAI GPT-4o</li>
              <li>• Ollama (Local LLM)</li>
              <li>• Embeddings & RAG</li>
            </ul>
          </div>

          <div class="clean-card p-5 bg-slate-50/50">
            <h3 class="text-xs font-mono font-bold uppercase text-slate-500 mb-3">Frontend Web</h3>
            <ul class="space-y-1.5 text-sm font-medium text-slate-800">
              <li>• Astro 5</li>
              <li>• TypeScript</li>
              <li>• JavaScript (ESNext)</li>
              <li>• Tailwind CSS</li>
              <li>• HTML5 Semántico</li>
            </ul>
          </div>

          <div class="clean-card p-5 bg-slate-50/50">
            <h3 class="text-xs font-mono font-bold uppercase text-slate-500 mb-3">Backend & SQL</h3>
            <ul class="space-y-1.5 text-sm font-medium text-slate-800">
              <li>• PHP (+15 años)</li>
              <li>• Yii2 Framework</li>
              <li>• MySQL / PostgreSQL</li>
              <li>• Turso / LibSQL</li>
              <li>• Node.js & REST APIs</li>
            </ul>
          </div>

          <div class="clean-card p-5 bg-slate-50/50">
            <h3 class="text-xs font-mono font-bold uppercase text-slate-500 mb-3">DevOps & Linux</h3>
            <ul class="space-y-1.5 text-sm font-medium text-slate-800">
              <li>• Linux Debian</li>
              <li>• Docker Contenedores</li>
              <li>• Nginx Server</li>
              <li>• Git & GitHub</li>
              <li>• Proxmox / VMware</li>
            </ul>
          </div>
        </div>
      </section>

      {/* PROJECTS SECTION */}
      <section id="proyectos" class="py-16 border-b border-slate-200 scroll-mt-16">
        <div class="mb-10">
          <span class="text-xs font-mono uppercase tracking-wider text-blue-600 font-bold">Proyectos Destacados</span>
          <h2 class="text-3xl font-bold text-slate-900 tracking-tight mt-1">
            Casos de Uso Recientes
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {projects.map((proj) => (
            <div class="clean-card p-6 flex flex-col justify-between">
              <div>
                <span class="text-xs font-mono text-blue-600 font-semibold">{proj.tag}</span>
                <h3 class="text-lg font-bold text-slate-900 mt-1 mb-2">{proj.title}</h3>
                <p class="text-xs text-slate-600 leading-relaxed mb-4">{proj.desc}</p>
              </div>
              <div class="flex flex-wrap gap-1 font-mono text-[10px]">
                {proj.tech.map((t) => (
                  <span class="px-2 py-0.5 rounded bg-slate-100 text-slate-600 border border-slate-200">{t}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      {/* EXPERIENCE & CV SECTION */}
      <section id="experiencia" class="py-16 scroll-mt-16">
        <div class="mb-10">
          <span class="text-xs font-mono uppercase tracking-wider text-blue-600 font-bold">Trayectoria Profesional</span>
          <h2 class="text-3xl font-bold text-slate-900 tracking-tight mt-1">
            Currículum Resumido
          </h2>
        </div>

        <div class="space-y-6">
          {experiences.map((exp) => (
            <div class="clean-card p-6 border-l-4 border-l-blue-600">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-2">
                <h3 class="text-lg font-bold text-slate-900">{exp.title}</h3>
                <span class="text-xs font-mono font-bold text-blue-600">{exp.period}</span>
              </div>
              <p class="text-xs font-mono text-slate-500 mb-3">{exp.company}</p>
              <p class="text-sm text-slate-600 leading-relaxed">{exp.desc}</p>
            </div>
          ))}
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>
