---
import BaseHead from "../components/BaseHead.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";

const apps = [
  {
    id: "dividir-cuenta",
    href: "/apps/dividir-cuenta/",
    title: "Dividir Cuenta & Ticket",
    category: "FINANZAS",
    code: "01",
    accent: "€ Tickets & OCR",
    icon: "🧾",
    badgeColor: "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/30",
    isPrivate: false,
    group: "gestion",
    desc: "Calcula qué paga cada comensal según consumiciones. Escáner de tickets con cámara/OCR y reparto directo para Bizum.",
    tags: ["Restaurante", "Bizum", "OCR", "Calculadora"]
  },
  {
    id: "notas-privadas",
    href: "/apps/notas-privadas/",
    title: "Cuaderno Privado",
    category: "NOTAS",
    code: "02",
    accent: "🔒 Cifrado Local",
    icon: "📝",
    badgeColor: "bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/30",
    isPrivate: true,
    group: "gestion",
    desc: "Bloc de notas rápido y persistente en almacenamiento local. Ideal para borradores, snippets temporales y tareas.",
    tags: ["Privada", "Notas", "LocalStorage", "Borradores"]
  },
  {
    id: "habitos",
    href: "/apps/habitos/",
    title: "Hábitos & Rutinas",
    category: "HÁBITOS",
    code: "03",
    accent: "Racha Diaria",
    icon: "🎯",
    badgeColor: "bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border-cyan-500/30",
    isPrivate: false,
    group: "gestion",
    desc: "Seguimiento diario de hábitos y rachas semanales para mantener la constancia en tus rutinas personales.",
    tags: ["Hábitos", "Rutinas", "Productividad", "Objetivos"]
  },
  {
    id: "json",
    href: "/apps/json-formatter/",
    title: "JSON Formatter & Validator",
    category: "DEV TOOLS",
    code: "04",
    accent: "Validador & Minify",
    icon: "{ }",
    badgeColor: "bg-blue-500/10 text-blue-600 dark:text-blue-400 border-blue-500/30",
    isPrivate: false,
    group: "utilidades",
    desc: "Valida sintaxis, embellece con sangría configurable y compacta datos JSON en tiempo real en tu navegador.",
    tags: ["JSON", "Formateador", "Validador", "Minify"]
  },
  {
    id: "sql",
    href: "/apps/sql-formatter/",
    title: "SQL Formatter",
    category: "DEV TOOLS",
    code: "05",
    accent: "Query Beautifier",
    icon: "SQL",
    badgeColor: "bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 border-indigo-500/30",
    isPrivate: false,
    group: "utilidades",
    desc: "Convierte consultas SQL complejas o desordenadas en código limpio, estructurado y con palabras clave en mayúsculas.",
    tags: ["SQL", "Consultas", "Bases de datos", "Limpieza"]
  },
  {
    id: "hash-uuid",
    href: "/apps/hash-uuid/",
    title: "Hashes & UUIDs",
    category: "SEGURIDAD",
    code: "06",
    accent: "WebCrypto SHA",
    icon: "#",
    badgeColor: "bg-purple-500/10 text-purple-600 dark:text-purple-400 border-purple-500/30",
    isPrivate: false,
    group: "utilidades",
    desc: "Genera UUIDs v4 en lote, passwords criptográficas y calcula hashes SHA-256, SHA-512 y SHA-1 al vuelo.",
    tags: ["UUID v4", "SHA-256", "Contraseñas", "WebCrypto"]
  },
  {
    id: "color",
    href: "/apps/color-converter/",
    title: "Colores & Contraste WCAG",
    category: "DISEÑO",
    code: "07",
    accent: "HEX / RGB / WCAG",
    icon: "🎨",
    badgeColor: "bg-pink-500/10 text-pink-600 dark:text-pink-400 border-pink-500/30",
    isPrivate: false,
    group: "utilidades",
    desc: "Conversión bidireccional entre HEX, RGB y HSL con calculadora en vivo de ratios de contraste y accesibilidad WCAG.",
    tags: ["HEX", "RGB", "HSL", "WCAG Contrast"]
  },
  {
    id: "pomodoro",
    href: "/apps/pomodoro/",
    title: "Temporizador Pomodoro",
    category: "TIEMPO",
    code: "08",
    accent: "Enfoque & Pausas",
    icon: "⏱️",
    badgeColor: "bg-orange-500/10 text-orange-600 dark:text-orange-400 border-orange-500/30",
    isPrivate: false,
    group: "utilidades",
    desc: "Bloques de trabajo enfocado y descansos configurables con contador de ciclos y avisos sonoros integrados.",
    tags: ["Productividad", "Pomodoro", "Enfoque", "Tiempo"]
  },
  {
    id: "base64",
    href: "/apps/base64-converter/",
    title: "Base64 & URL Encoder",
    category: "CONVERTIDOR",
    code: "09",
    accent: "UTF-8 / URL Safe",
    icon: "64",
    badgeColor: "bg-teal-500/10 text-teal-600 dark:text-teal-400 border-teal-500/30",
    isPrivate: false,
    group: "sistema",
    desc: "Codifica y decodifica texto con soporte UTF-8 completo, además de utilidades directas para URL encoding.",
    tags: ["Base64", "URL Encode", "UTF-8", "String Tools"]
  },
  {
    id: "mis-servidores",
    href: "/apps/mis-servidores/",
    title: "Servidores & Accesos",
    category: "SISTEMAS",
    code: "10",
    accent: "🔒 SSH / DevOps",
    icon: "⚡",
    badgeColor: "bg-rose-500/10 text-rose-600 dark:text-rose-400 border-rose-500/30",
    isPrivate: true,
    group: "sistema",
    desc: "Fichero privado de servidores, IPs, accesos SSH habituales y gestor del PIN maestro de acceso.",
    tags: ["Privada", "DevOps", "Servidores", "Seguridad"]
  },
  {
    id: "herramientas-externas",
    href: "/apps/herramientas-externas/",
    title: "Herramientas Externas",
    category: "EXTERNO",
    code: "11",
    accent: "Accesos Directos ↗",
    icon: "↗",
    badgeColor: "bg-sky-500/10 text-sky-600 dark:text-sky-400 border-sky-500/30",
    isPrivate: false,
    group: "externas",
    desc: "Gestor de accesos directos personalizables a herramientas y servicios web externos con enlaces directos.",
    tags: ["Accesos", "Enlaces", "Herramientas", "Dashboard"]
  }
];
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <BaseHead title={`${SITE_TITLE} — Suite Personal de Herramientas`} description={SITE_DESCRIPTION} />
    <!-- Dynamic App Permissions & Auth Guard -->
    <script is:inline src="/apps/shared/auth-guard.js"></script>
  </head>
  <body class="bg-zinc-50 dark:bg-[#07080b] text-zinc-900 dark:text-zinc-100 min-h-screen flex flex-col font-sans transition-colors duration-200 bg-technical-grid relative pb-16 sm:pb-0">
    
    <!-- Top Animated Marquee Ticker -->
    <div class="w-full bg-zinc-900 text-zinc-300 dark:bg-black dark:text-zinc-400 text-[11px] font-mono py-1 border-b border-zinc-800 overflow-hidden whitespace-nowrap select-none">
      <div class="inline-block animate-marquee hover:[animation-play-state:paused]">
        <span class="mx-4 text-emerald-400 font-bold">[● SISTEMA EN LINEA]</span>
        <span class="mx-4">11 MICRO-APPS CLIENT-SIDE</span>
        <span class="mx-4 text-zinc-600">///</span>
        <span class="mx-4 text-cyan-400">0% RASTREO • 100% PERSISTENCIA LOCAL</span>
        <span class="mx-4 text-zinc-600">///</span>
        <span class="mx-4">PROTECCION CRIPTOGRAFICA SHA-256</span>
        <span class="mx-4 text-zinc-600">///</span>
        <span class="mx-4">COMPATIBLE PWA & MÓVIL</span>
        <span class="mx-4 text-zinc-600">///</span>
        <span class="mx-4 text-emerald-400 font-bold">[● SISTEMA EN LINEA]</span>
        <span class="mx-4">11 MICRO-APPS CLIENT-SIDE</span>
        <span class="mx-4 text-zinc-600">///</span>
        <span class="mx-4 text-cyan-400">0% RASTREO • 100% PERSISTENCIA LOCAL</span>
      </div>
    </div>

    <!-- Navigation Bar -->
    <Navbar currentPath="/" />

    <main class="w-full max-w-6xl mx-auto px-3 sm:px-6 pt-6 sm:pt-10 flex-1">
      
      <!-- Technical Telemetry Cockpit -->
      <section class="border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/60 p-4 sm:p-6 mb-6 sharp-card tech-bracket">
        
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-4 border-b border-zinc-200 dark:border-zinc-800">
          <div>
            <div class="flex items-center gap-2 font-mono text-[11px] uppercase tracking-wider text-zinc-500 mb-1">
              <span class="w-2 h-2 bg-emerald-500 inline-block animate-pulse"></span>
              <span>SUITE DE HERRAMIENTAS // RAMON MENOR</span>
            </div>
            <h1 class="text-2xl sm:text-4xl font-black text-zinc-950 dark:text-white uppercase tracking-tight">
              BANCO DE HERRAMIENTAS
            </h1>
          </div>

          <!-- Quick Metrics Bar -->
          <div class="flex flex-wrap items-center gap-2 font-mono text-xs">
            <div class="px-2.5 py-1 border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800/80">
              APPS: <strong id="stat-total-apps" class="text-black dark:text-cyan-400">{apps.length}</strong>
            </div>
            <div class="px-2.5 py-1 border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800/80">
              DATOS: <strong class="text-emerald-600 dark:text-emerald-400">LOCAL</strong>
            </div>
            <button
              id="pwa-install-btn"
              type="button"
              class="hidden px-2.5 py-1 border border-zinc-950 dark:border-cyan-400 bg-zinc-950 dark:bg-cyan-400 text-white dark:text-zinc-950 font-bold cursor-pointer"
            >
              📲 INSTALAR
            </button>
          </div>
        </div>

        <!-- Search Bar & Controls -->
        <div class="pt-4 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
          
          <!-- Command Line Search Input -->
          <div class="relative flex-1">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none font-mono text-xs text-zinc-400">
              &gt;_
            </div>
            <input
              type="text"
              id="tool-search-input"
              placeholder="Buscar por nombre, tag o función (p. ej. JSON, OCR, SHA)..."
              class="w-full pl-9 pr-14 py-2 border border-zinc-300 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-950 text-zinc-900 dark:text-white text-xs sm:text-sm font-mono placeholder:text-zinc-400 focus:outline-none focus:border-black dark:focus:border-cyan-400 transition-colors"
              autocomplete="off"
            />
            <div class="absolute inset-y-0 right-0 pr-2.5 flex items-center gap-1 font-mono text-[10px]">
              <button
                id="clear-search-btn"
                type="button"
                class="hidden px-1 text-zinc-400 hover:text-black dark:hover:text-white cursor-pointer font-bold"
                title="Limpiar"
              >
                [X]
              </button>
              <kbd class="hidden sm:inline-block px-1 border border-zinc-300 dark:border-zinc-700 text-zinc-400">
                /
              </kbd>
            </div>
          </div>

          <!-- Auth & View Mode Switches -->
          <div class="flex items-center gap-2 font-mono text-xs">
            <button
              id="auth-toggle-btn"
              type="button"
              class="px-2.5 py-2 border border-zinc-300 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-900 hover:border-black dark:hover:border-cyan-400 transition-colors cursor-pointer inline-flex items-center gap-2"
              title="Estado del acceso privado"
            >
              <span id="auth-status-dot" class="w-2 h-2 bg-zinc-400 inline-block"></span>
              <span id="auth-status-text">Comprobando...</span>
            </button>

            <!-- Grid / Compact List View Switcher -->
            <div class="hidden sm:flex border border-zinc-300 dark:border-zinc-700">
              <button
                type="button"
                id="view-grid-btn"
                class="view-switch-btn active px-2.5 py-2 bg-zinc-950 dark:bg-cyan-400 text-white dark:text-zinc-950 cursor-pointer font-bold"
                title="Vista en cuadrícula"
              >
                ▦
              </button>
              <button
                type="button"
                id="view-list-btn"
                class="view-switch-btn px-2.5 py-2 bg-transparent text-zinc-500 hover:text-black dark:hover:text-white cursor-pointer font-bold"
                title="Vista en lista compacta"
              >
                ☰
              </button>
            </div>
          </div>

        </div>

        <!-- Filter Segmented Tabs -->
        <div class="mt-4 pt-3 border-t border-zinc-200 dark:border-zinc-800 flex items-center gap-1.5 overflow-x-auto no-scrollbar font-mono text-xs">
          <button
            type="button"
            id="filter-all-btn"
            class="filter-btn active px-3 py-1 border border-black dark:border-cyan-400 bg-black dark:bg-cyan-400 text-white dark:text-black font-bold whitespace-nowrap transition-colors cursor-pointer"
            data-filter="all"
          >
            [ TODAS ({apps.length}) ]
          </button>
          <button
            type="button"
            id="filter-public-btn"
            class="filter-btn px-3 py-1 border border-zinc-300 dark:border-zinc-700 hover:border-black dark:hover:border-zinc-400 text-zinc-700 dark:text-zinc-300 whitespace-nowrap transition-colors cursor-pointer"
            data-filter="public"
          >
            [ PUBLICAS ({apps.filter(a => !a.isPrivate).length}) ]
          </button>
          <button
            type="button"
            id="filter-private-btn"
            class="filter-btn px-3 py-1 border border-zinc-300 dark:border-zinc-700 hover:border-black dark:hover:border-zinc-400 text-zinc-700 dark:text-zinc-300 whitespace-nowrap transition-colors cursor-pointer"
            data-filter="private"
          >
            [ 🔒 PRIVADAS ({apps.filter(a => a.isPrivate).length}) ]
          </button>
        </div>

      </section>

      <!-- Tool Cards Section -->
      <section id="herramientas" class="mb-12">
        
        <!-- Empty Results Message -->
        <div id="no-results-msg" class="hidden text-center py-12 border border-dashed border-zinc-300 dark:border-zinc-800 bg-white dark:bg-zinc-950 font-mono">
          <div class="text-xl mb-1">[!]</div>
          <p class="text-xs uppercase text-zinc-500 mb-3">No hay herramientas para este criterio de búsqueda.</p>
          <button id="reset-search-btn" class="px-3 py-1 bg-black text-white dark:bg-cyan-400 dark:text-black text-xs font-bold uppercase cursor-pointer">
            Restablecer filtros
          </button>
        </div>

        <!-- Dynamic Grid / List Container -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3" id="tools-grid">
          {apps.map((app, index) => (
            <a
              href={app.href}
              data-app-id={app.id}
              data-type={app.isPrivate ? "private" : "public"}
              data-group={app.group}
              data-title={app.title.toLowerCase()}
              data-desc={app.desc.toLowerCase()}
              data-tags={app.tags.join(" ").toLowerCase()}
              class="app-card sharp-card tech-bracket animate-tech-in group p-4 sm:p-5 flex flex-col justify-between"
              style={`animation-delay: ${index * 25}ms;`}
            >
              <div>
                <!-- Top Technical Header -->
                <div class="flex items-center justify-between gap-2 mb-3 pb-2 border-b border-zinc-200 dark:border-zinc-800">
                  <div class="flex items-center gap-2">
                    <span class="w-6 h-6 border border-zinc-300 dark:border-zinc-700 bg-zinc-100 dark:bg-zinc-800 font-mono font-bold text-xs flex items-center justify-center group-hover:bg-black group-hover:text-white dark:group-hover:bg-cyan-400 dark:group-hover:text-black transition-colors">
                      {app.icon}
                    </span>
                    <span class="font-mono text-[10px] font-bold uppercase tracking-wider text-zinc-500">
                      {app.code} // {app.category}
                    </span>
                  </div>

                  {app.isPrivate ? (
                    <span class="font-mono text-[9px] px-1.5 py-0.5 border border-rose-500/40 text-rose-600 dark:text-rose-400 font-bold uppercase">
                      🔒 PRIVADA
                    </span>
                  ) : (
                    <span class="font-mono text-[9px] px-1.5 py-0.5 border border-emerald-500/40 text-emerald-600 dark:text-emerald-400 font-bold uppercase">
                      PUBLICA
                    </span>
                  )}
                </div>

                <!-- Title & Description -->
                <h2 class="text-base font-bold text-zinc-950 dark:text-white group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors uppercase tracking-tight mb-1.5">
                  {app.title}
                </h2>
                <p class="text-xs text-zinc-600 dark:text-zinc-400 line-clamp-2 leading-relaxed mb-3">
                  {app.desc}
                </p>

                <!-- Tags -->
                <div class="flex flex-wrap gap-1 mb-3">
                  {app.tags.map((tag) => (
                    <span class="text-[9px] font-mono px-1.5 py-0.5 bg-zinc-100 dark:bg-zinc-800/80 border border-zinc-200 dark:border-zinc-700 text-zinc-600 dark:text-zinc-400">
                      #{tag}
                    </span>
                  ))}
                </div>
              </div>

              <!-- Footer info bar -->
              <div class="pt-2 border-t border-zinc-200 dark:border-zinc-800 flex items-center justify-between font-mono text-[11px]">
                <span class="text-cyan-600 dark:text-cyan-400 font-semibold">{app.accent}</span>
                <span class="text-zinc-400 group-hover:text-black dark:group-hover:text-white group-hover:translate-x-1 transition-all">
                  ABRIR ↗
                </span>
              </div>
            </a>
          ))}
        </div>
      </section>

      <!-- External Tools Deck Section -->
      <section id="externas" class="mb-12 border-t border-zinc-200 dark:border-zinc-800 pt-6">
        <div class="flex items-center justify-between mb-3 font-mono">
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold uppercase tracking-wider text-zinc-900 dark:text-white">
              // HERRAMIENTAS EXTERNAS
            </span>
            <a href="/apps/herramientas-externas/" class="text-xs text-cyan-600 dark:text-cyan-400 hover:underline">
              [EDITAR]
            </a>
          </div>

          <!-- Slider Navigation Arrows -->
          <div class="flex items-center gap-1">
            <button
              type="button"
              id="slider-prev-btn"
              class="w-7 h-7 border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 hover:border-black dark:hover:border-cyan-400 flex items-center justify-center text-xs cursor-pointer"
              title="Anterior"
            >
              ‹
            </button>
            <button
              type="button"
              id="slider-next-btn"
              class="w-7 h-7 border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 hover:border-black dark:hover:border-cyan-400 flex items-center justify-center text-xs cursor-pointer"
              title="Siguiente"
            >
              ›
            </button>
          </div>
        </div>

        <div class="relative overflow-hidden">
          <div
            class="flex gap-3 overflow-x-auto scroll-smooth snap-x snap-mandatory no-scrollbar py-1"
            id="home-external-tools"
          >
            <!-- Rendered dynamically by script -->
          </div>
        </div>
      </section>

    </main>

    <!-- Mobile Fixed Bottom Action Bar (Thumb Navigation) -->
    <div class="sm:hidden fixed bottom-0 left-0 right-0 z-50 bg-white/95 dark:bg-[#07080b]/95 border-t border-zinc-300 dark:border-zinc-800 px-3 py-2 flex items-center justify-between font-mono text-xs backdrop-blur-md">
      <a href="#top" class="px-2 py-1 text-zinc-700 dark:text-zinc-300 hover:text-cyan-500 font-bold">
        ▲ INICIO
      </a>
      <button id="mobile-focus-search-btn" type="button" class="px-2 py-1 text-zinc-700 dark:text-zinc-300 hover:text-cyan-500">
        🔍 BUSCAR
      </button>
      <a href="/apps/panel-control/" class="px-2 py-1 text-zinc-700 dark:text-zinc-300 hover:text-cyan-500">
        ⚙️ PANEL
      </a>
      <a href="/cv" class="px-2 py-1 text-zinc-700 dark:text-zinc-300 hover:text-cyan-500">
        📄 CV
      </a>
    </div>

    <!-- Footer -->
    <Footer />

    {/* Client script for real-time filtering, auth guard, view switching & slider */}
    <script>
      const STORAGE_KEY = 'rm_private_access_session';
      let currentFilter = 'all';
      let searchQuery = '';

      function isUnlocked() {
        return sessionStorage.getItem(STORAGE_KEY) === 'unlocked' || localStorage.getItem(STORAGE_KEY) === 'unlocked';
      }

      function updateAuthUI() {
        const dot = document.getElementById('auth-status-dot');
        const text = document.getElementById('auth-status-text');
        const btn = document.getElementById('auth-toggle-btn');
        if (!dot || !text || !btn) return;

        if (isUnlocked()) {
          dot.className = 'w-2 h-2 bg-emerald-500 inline-block';
          text.textContent = 'PRIVADAS: DESBLOQUEADAS';
          btn.title = 'Haz clic para bloquear el acceso privado';
        } else {
          dot.className = 'w-2 h-2 bg-rose-500 inline-block';
          text.textContent = 'PRIVADAS: BLOQUEADAS';
          btn.title = 'Las aplicaciones privadas pedirán PIN al entrar';
        }
      }

      function applyFilters() {
        const cards = document.querySelectorAll('.app-card');
        const noResults = document.getElementById('no-results-msg');
        let visibleCount = 0;

        cards.forEach(cardEl => {
          const card = cardEl as HTMLElement;
          const type = card.getAttribute('data-type');
          const isConfigVisible = card.getAttribute('data-visible') !== 'false';
          const title = card.getAttribute('data-title') || '';
          const desc = card.getAttribute('data-desc') || '';
          const tags = card.getAttribute('data-tags') || '';

          if (!isConfigVisible) {
            card.style.display = 'none';
            return;
          }

          const matchesType = currentFilter === 'all' || currentFilter === type;
          const matchesSearch = !searchQuery || 
            title.includes(searchQuery) || 
            desc.includes(searchQuery) || 
            tags.includes(searchQuery);

          if (matchesType && matchesSearch) {
            card.style.display = 'flex';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (noResults) {
          if (visibleCount === 0) noResults.classList.remove('hidden');
          else noResults.classList.add('hidden');
        }
      }

      function syncWithPermissions() {
        const rmApps = (window as any).RMApps;
        if (!rmApps) return;

        const appsConfig = rmApps.getAll();
        const cards = document.querySelectorAll('.app-card');

        let publicCount = 0;
        let privateCount = 0;
        let visibleTotal = 0;

        cards.forEach(cardEl => {
          const card = cardEl as HTMLElement;
          const appId = card.getAttribute('data-app-id');
          const config = appsConfig.find((a: any) => a.id === appId);
          if (!config) return;

          const isPrivate = config.isPrivate;
          const isVisible = config.visible !== false;

          card.setAttribute('data-type', isPrivate ? 'private' : 'public');
          card.setAttribute('data-visible', isVisible ? 'true' : 'false');

          if (isVisible) {
            visibleTotal++;
            if (isPrivate) privateCount++;
            else publicCount++;
          }
        });

        const allBtn = document.getElementById('filter-all-btn');
        const pubBtn = document.getElementById('filter-public-btn');
        const privBtn = document.getElementById('filter-private-btn');

        if (allBtn) allBtn.textContent = `[ TODAS (${visibleTotal}) ]`;
        if (pubBtn) pubBtn.textContent = `[ PUBLICAS (${publicCount}) ]`;
        if (privBtn) privBtn.textContent = `[ 🔒 PRIVADAS (${privateCount}) ]`;

        applyFilters();
      }

      // Handle Type Filter Buttons
      const filterBtns = document.querySelectorAll('.filter-btn');
      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          filterBtns.forEach(b => {
            b.classList.remove('active', 'border-black', 'dark:border-cyan-400', 'bg-black', 'dark:bg-cyan-400', 'text-white', 'dark:text-black', 'font-bold');
            b.classList.add('border-zinc-300', 'dark:border-zinc-700', 'text-zinc-700', 'dark:text-zinc-300');
          });
          btn.classList.add('active', 'border-black', 'dark:border-cyan-400', 'bg-black', 'dark:bg-cyan-400', 'text-white', 'dark:text-black', 'font-bold');
          btn.classList.remove('border-zinc-300', 'dark:border-zinc-700', 'text-zinc-700', 'dark:text-zinc-300');

          currentFilter = btn.getAttribute('data-filter') || 'all';
          applyFilters();
        });
      });

      // Handle Search Input & Mobile quick focus
      const searchInput = document.getElementById('tool-search-input') as HTMLInputElement | null;
      const clearSearchBtn = document.getElementById('clear-search-btn');
      const resetSearchBtn = document.getElementById('reset-search-btn');
      const mobileSearchBtn = document.getElementById('mobile-focus-search-btn');

      if (searchInput) {
        searchInput.addEventListener('input', () => {
          searchQuery = (searchInput.value || '').trim().toLowerCase();
          if (clearSearchBtn) {
            if (searchQuery) clearSearchBtn.classList.remove('hidden');
            else clearSearchBtn.classList.add('hidden');
          }
          applyFilters();
        });

        window.addEventListener('keydown', (e) => {
          if (e.key === '/' && document.activeElement !== searchInput) {
            e.preventDefault();
            searchInput.focus();
          } else if (e.key === 'Escape' && document.activeElement === searchInput) {
            clearSearch();
            searchInput.blur();
          }
        });
      }

      if (mobileSearchBtn && searchInput) {
        mobileSearchBtn.addEventListener('click', () => {
          searchInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
          searchInput.focus();
        });
      }

      function clearSearch() {
        if (searchInput) {
          searchInput.value = '';
          searchQuery = '';
          if (clearSearchBtn) clearSearchBtn.classList.add('hidden');
          applyFilters();
        }
      }

      if (clearSearchBtn) clearSearchBtn.addEventListener('click', clearSearch);
      if (resetSearchBtn) resetSearchBtn.addEventListener('click', () => {
        clearSearch();
        const allBtn = document.getElementById('filter-all-btn');
        if (allBtn) allBtn.click();
      });

      // Handle Grid / List View Toggle
      const gridBtn = document.getElementById('view-grid-btn');
      const listBtn = document.getElementById('view-list-btn');
      const toolsGrid = document.getElementById('tools-grid');

      function setViewMode(mode: 'grid' | 'list') {
        if (!toolsGrid) return;
        if (mode === 'list') {
          toolsGrid.className = 'flex flex-col gap-2';
          listBtn?.classList.add('bg-zinc-950', 'dark:bg-cyan-400', 'text-white', 'dark:text-zinc-950');
          listBtn?.classList.remove('bg-transparent', 'text-zinc-500');
          gridBtn?.classList.remove('bg-zinc-950', 'dark:bg-cyan-400', 'text-white', 'dark:text-zinc-950');
          gridBtn?.classList.add('bg-transparent', 'text-zinc-500');
        } else {
          toolsGrid.className = 'grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3';
          gridBtn?.classList.add('bg-zinc-950', 'dark:bg-cyan-400', 'text-white', 'dark:text-zinc-950');
          gridBtn?.classList.remove('bg-transparent', 'text-zinc-500');
          listBtn?.classList.remove('bg-zinc-950', 'dark:bg-cyan-400', 'text-white', 'dark:text-zinc-950');
          listBtn?.classList.add('bg-transparent', 'text-zinc-500');
        }
        localStorage.setItem('rm_view_mode', mode);
      }

      if (gridBtn) gridBtn.onclick = () => setViewMode('grid');
      if (listBtn) listBtn.onclick = () => setViewMode('list');

      const savedMode = (localStorage.getItem('rm_view_mode') as 'grid' | 'list') || 'grid';
      if (savedMode === 'list') setViewMode('list');

      // Handle Lock / Unlock toggle
      const toggleBtn = document.getElementById('auth-toggle-btn');
      if (toggleBtn) {
        toggleBtn.addEventListener('click', () => {
          if (isUnlocked()) {
            if (confirm('¿Deseas bloquear el acceso a las aplicaciones privadas?')) {
              sessionStorage.removeItem(STORAGE_KEY);
              localStorage.removeItem(STORAGE_KEY);
              updateAuthUI();
            }
          } else {
            window.location.href = '/apps/panel-control/';
          }
        });
      }

      // Listen for permissions changes from the control panel
      window.addEventListener('rm_apps_config_changed', syncWithPermissions);
      window.addEventListener('storage', (e) => {
        if (e.key === 'rm_apps_permissions_override') syncWithPermissions();
        if (e.key === STORAGE_KEY) updateAuthUI();
      });

      // PWA Install prompt handling
      let deferredInstallPrompt: any = null;
      const installBtn = document.getElementById('pwa-install-btn');

      window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        deferredInstallPrompt = e;
        if (installBtn) {
          installBtn.classList.remove('hidden');
          installBtn.classList.add('inline-flex');
        }
      });

      const isStandalone = window.matchMedia('(display-mode: standalone)').matches || (navigator as any).standalone;
      if (!isStandalone && installBtn && /iPhone|iPad|iPod|Android/i.test(navigator.userAgent)) {
        installBtn.classList.remove('hidden');
        installBtn.classList.add('inline-flex');
      }

      if (installBtn) {
        installBtn.addEventListener('click', async () => {
          if (deferredInstallPrompt) {
            deferredInstallPrompt.prompt();
            const { outcome } = await deferredInstallPrompt.userChoice;
            if (outcome === 'accepted') {
              installBtn.classList.add('hidden');
            }
            deferredInstallPrompt = null;
          } else {
            alert('Para instalar esta app en tu pantalla de inicio:\n\n• En Safari (iOS): Pulsa Compartir y "Añadir a pantalla de inicio".\n• En Chrome (Android/PC): Pulsa en ⋮ y "Instalar aplicación".');
          }
        });
      }

      let autoSlideTimer: any = null;

      function setupSliderControls() {
        const slider = document.getElementById('home-external-tools');
        const prevBtn = document.getElementById('slider-prev-btn');
        const nextBtn = document.getElementById('slider-next-btn');
        if (!slider) return;

        function slideNext() {
          if (!slider) return;
          const maxScroll = slider.scrollWidth - slider.clientWidth;
          if (slider.scrollLeft >= maxScroll - 15) {
            slider.scrollTo({ left: 0, behavior: 'smooth' });
          } else {
            slider.scrollBy({ left: 260, behavior: 'smooth' });
          }
        }

        function slidePrev() {
          if (!slider) return;
          if (slider.scrollLeft <= 15) {
            const maxScroll = slider.scrollWidth - slider.clientWidth;
            slider.scrollTo({ left: maxScroll, behavior: 'smooth' });
          } else {
            slider.scrollBy({ left: -260, behavior: 'smooth' });
          }
        }

        if (prevBtn) prevBtn.onclick = () => { slidePrev(); resetAutoSlide(); };
        if (nextBtn) nextBtn.onclick = () => { slideNext(); resetAutoSlide(); };

        function startAutoSlide() {
          clearInterval(autoSlideTimer);
          autoSlideTimer = setInterval(() => { slideNext(); }, 4500);
        }

        function resetAutoSlide() {
          clearInterval(autoSlideTimer);
          startAutoSlide();
        }

        slider.onmouseenter = () => clearInterval(autoSlideTimer);
        slider.onmouseleave = () => startAutoSlide();
        slider.ontouchstart = () => clearInterval(autoSlideTimer);
        slider.ontouchend = () => startAutoSlide();

        startAutoSlide();
      }

      function renderHomeExternalTools() {
        const container = document.getElementById('home-external-tools');
        if (!container) return;

        let tools = [
          { title: 'Nube de archivos', desc: 'Documentos y backup', url: 'https://drive.google.com' },
          { title: 'Calendario', desc: 'Agenda semanal', url: 'https://calendar.google.com' },
          { title: 'Lector de notas', desc: 'Notas y listas', url: 'https://keep.google.com' }
        ];

        try {
          const saved = localStorage.getItem('rm_external_tools_state');
          if (saved) tools = JSON.parse(saved);
        } catch (e) {}

        container.innerHTML = '';
        tools.forEach((t: any) => {
          let u = (t.url || '').trim();
          if (!u.startsWith('http://') && !u.startsWith('https://')) u = 'https://' + u;

          const card = document.createElement('a');
          card.href = u;
          card.target = '_blank';
          card.rel = 'noopener noreferrer';
          card.className = 'w-[240px] shrink-0 snap-start sharp-card tech-bracket p-4 flex flex-col justify-between font-mono';
          card.innerHTML = `
            <div>
              <div class="text-[9px] text-zinc-400 group-hover:text-cyan-500 uppercase tracking-widest mb-1.5 font-bold">EXTERNO // LINK</div>
              <h4 class="font-bold text-zinc-950 dark:text-white text-sm group-hover:text-cyan-500 transition-colors mb-1 truncate uppercase">${t.title}</h4>
              <p class="text-[11px] text-zinc-500 line-clamp-2 leading-relaxed mb-3">${t.desc || 'Acceso directo'}</p>
            </div>
            <div class="pt-2 border-t border-zinc-200 dark:border-zinc-800 flex items-center justify-between text-[10px] text-cyan-600 dark:text-cyan-400 font-bold">
              <span>VISITAR</span>
              <span>↗</span>
            </div>
          `;
          container.appendChild(card);
        });

        setupSliderControls();
      }

      window.addEventListener('rm_external_tools_updated', renderHomeExternalTools);
      window.addEventListener('storage', (e) => {
        if (e.key === 'rm_external_tools_state') renderHomeExternalTools();
      });

      document.addEventListener('DOMContentLoaded', () => {
        updateAuthUI();
        syncWithPermissions();
        renderHomeExternalTools();
      });

      updateAuthUI();
      syncWithPermissions();
      renderHomeExternalTools();
    </script>
  </body>
</html>
