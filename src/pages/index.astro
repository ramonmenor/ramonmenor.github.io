---
import BaseHead from "../components/BaseHead.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";

const microApps = [
  {
    href: "/tools/json",
    title: "Formateador & Validador JSON",
    icon: "{ }",
    color: "bg-blue-50 text-blue-600 border-blue-100",
    desc: "Valida la sintaxis, embellece con sangría configurable y compacta (minifica) datos JSON en tiempo real.",
    tags: ["JSON", "Formateador", "Validador", "Minify"]
  },
  {
    href: "/tools/sql",
    title: "Formateador SQL",
    icon: "SQL",
    color: "bg-indigo-50 text-indigo-600 border-indigo-100",
    desc: "Convierte consultas SQL desordenadas en código limpio, estructurado y con palabras clave en mayúsculas estándar.",
    tags: ["SQL", "Consultas", "Bases de datos", "Limpieza"]
  },
  {
    href: "/tools/hash-uuid",
    title: "Generador de Hashes & UUIDs",
    icon: "#",
    color: "bg-purple-50 text-purple-600 border-purple-100",
    desc: "Crea UUIDs v4 en masa, contraseñas aleatorias seguras y calcula hashes SHA-256, SHA-512 y SHA-1 al instante.",
    tags: ["UUID v4", "SHA-256", "Contraseñas", "Crypto"]
  },
  {
    href: "/tools/colores",
    title: "Convertidor de Colores & Contraste",
    icon: "🎨",
    color: "bg-pink-50 text-pink-600 border-pink-100",
    desc: "Conversión simultánea entre HEX, RGB, HSL y cálculo de contraste de accesibilidad según normativa WCAG.",
    tags: ["HEX", "RGB", "HSL", "Contraste WCAG"]
  },
  {
    href: "/tools/base64",
    title: "Codificador Base64 & URL",
    icon: "64",
    color: "bg-emerald-50 text-emerald-600 border-emerald-100",
    desc: "Codifica y decodifica texto en Base64 con soporte UTF-8 completo y conversor de URL encode/decode.",
    tags: ["Base64", "URL Encode", "UTF-8", "Texto"]
  }
];
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead title={`${SITE_TITLE} — Espacio Personal & Herramientas`} description={SITE_DESCRIPTION} />
  </head>
  <body class="bg-white text-slate-900 min-h-screen flex flex-col font-sans">
    <Navbar currentPath="/" />

    <main class="w-full max-w-5xl mx-auto px-4 sm:px-6 py-12 sm:py-16 flex-1">
      {/* Hero / Presentation */}
      <section class="max-w-3xl mb-12 sm:mb-16">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100 border border-slate-200 text-slate-700 text-xs font-mono mb-4">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          ramonmenor.es // Espacio personal
        </div>

        <h1 class="text-4xl sm:text-5xl font-black text-slate-900 tracking-tight leading-none mb-4">
          Ramón Menor
        </h1>

        <p class="text-lg sm:text-xl text-slate-600 leading-relaxed mb-6">
          Desarrollador web. Este es mi rincón digital donde desarrollo y tengo a mano pequeñas aplicaciones y utilidades que me ayudan en el trabajo del día a día.
        </p>

        <div class="flex flex-wrap items-center gap-3 text-xs font-mono">
          <a
            href="/cv"
            class="px-4 py-2 rounded-lg bg-slate-900 text-white font-medium hover:bg-slate-800 transition-colors"
          >
            Ver Trayectoria / CV →
          </a>
          <a
            href="mailto:ramonmenor@gmail.com"
            class="px-4 py-2 rounded-lg bg-slate-100 text-slate-700 border border-slate-200 hover:border-slate-300 transition-colors"
          >
            ramonmenor@gmail.com
          </a>
        </div>
      </section>

      {/* Micro-apps List */}
      <section id="herramientas" class="scroll-mt-20">
        <div class="flex items-center justify-between mb-6 pb-3 border-b border-slate-200">
          <div>
            <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">
              Herramientas & Utilidades
            </h2>
            <p class="text-xs sm:text-sm text-slate-500 mt-0.5">
              Micro-aplicaciones ligeras, privadas y ejecutadas al 100% en tu navegador.
            </p>
          </div>
          <span class="text-xs font-mono text-slate-400 bg-slate-100 px-2.5 py-1 rounded-full">
            {microApps.length} utilidades
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {microApps.map((app) => (
            <a
              href={app.href}
              class="group clean-card p-6 flex flex-col justify-between hover:border-blue-300 hover:shadow-md transition-all"
            >
              <div>
                <div class="flex items-center gap-3 mb-3">
                  <span class={`w-10 h-10 rounded-xl flex items-center justify-center font-mono font-bold text-sm border ${app.color}`}>
                    {app.icon}
                  </span>
                  <div>
                    <h3 class="font-bold text-base text-slate-900 group-hover:text-blue-600 transition-colors flex items-center gap-1.5">
                      <span>{app.title}</span>
                      <svg class="w-4 h-4 opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </h3>
                  </div>
                </div>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-4">
                  {app.desc}
                </p>
              </div>

              <div class="flex flex-wrap gap-1.5 pt-2 border-t border-slate-100 font-mono text-[10px]">
                {app.tags.map((tag) => (
                  <span class="px-2 py-0.5 rounded bg-slate-100 text-slate-600 border border-slate-200">
                    {tag}
                  </span>
                ))}
              </div>
            </a>
          ))}
        </div>
      </section>

      {/* Note about privacy and client-side execution */}
      <section class="mt-12 p-5 bg-slate-50 border border-slate-200 rounded-2xl flex items-start gap-3 text-xs text-slate-600">
        <svg class="w-5 h-5 text-blue-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <p>
          <strong class="text-slate-800">Privacidad total:</strong> Todas las herramientas se procesan exclusivamente en el navegador local de tu dispositivo. Ningún dato, JSON, consulta SQL o texto se envía a servidores externos.
        </p>
      </section>
    </main>

    <Footer />
  </body>
</html>
