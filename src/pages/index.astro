---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body class="bg-[#0a0a0a] text-gray-100 min-h-screen flex flex-col">
    <Header title={SITE_TITLE} />
    <main class="flex-1 flex flex-col items-center justify-center relative overflow-hidden px-4 sm:px-6 lg:px-8 py-20">
      
      {/* Background glowing effects */}
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-indigo-600/20 rounded-full blur-[120px] -z-10 pointer-events-none"></div>
      <div class="absolute top-0 right-0 w-[400px] h-[400px] bg-purple-600/20 rounded-full blur-[100px] -z-10 pointer-events-none"></div>

      <div class="max-w-4xl mx-auto text-center z-10">
        <div class="inline-flex items-center gap-2 px-3 py-1 text-sm font-medium text-indigo-300 bg-indigo-500/10 border border-indigo-500/20 rounded-full mb-8">
          <span class="flex h-2 w-2 rounded-full bg-green-400"></span>
          Disponible para proyectos
        </div>

        <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight mb-8">
          Hola, soy <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 via-purple-400 to-pink-400">Ramón Menor</span>
        </h1>
        
        <p class="text-xl md:text-2xl text-gray-400 mb-10 max-w-2xl mx-auto leading-relaxed">
          Desarrollador Full Stack apasionado por crear experiencias digitales excepcionales con la ayuda de la IA.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/resume" class="w-full sm:w-auto px-8 py-4 bg-white text-black font-semibold rounded-xl hover:bg-gray-100 transition-colors shadow-lg shadow-white/5">
            Ver mi Currículum
          </a>
          <a href="/stack" class="w-full sm:w-auto px-8 py-4 bg-white/5 text-white font-semibold rounded-xl border border-white/10 hover:bg-white/10 transition-colors backdrop-blur-sm">
            Descubre mi Stack IA
          </a>
        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>
