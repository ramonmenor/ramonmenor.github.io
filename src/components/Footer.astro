---
const today = new Date();
---

<footer id="contacto" class="border-t border-slate-200 bg-slate-50 py-16 mt-20">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-8 pb-12 border-b border-slate-200">
      <div>
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">
          Ramón Menor
        </h2>
        <p class="text-sm text-slate-600 mt-1 max-w-md">
          Desarrollador Web Full Stack & Especialista en Integración de Inteligencia Artificial.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3 font-medium text-xs">
        <a
          href="mailto:minombre@ramonmenor.es"
          class="px-4 py-2.5 rounded-lg bg-slate-900 text-white hover:bg-slate-800 transition-colors"
        >
          minombre@ramonmenor.es
        </a>
        <a
          href="https://linkedin.com/in/ramonmenor"
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-2.5 rounded-lg bg-white border border-slate-300 text-slate-700 hover:border-slate-400 transition-colors"
        >
          LinkedIn
        </a>
        <a
          href="https://github.com/ramonmenor"
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-2.5 rounded-lg bg-white border border-slate-300 text-slate-700 hover:border-slate-400 transition-colors"
        >
          GitHub
        </a>
      </div>
    </div>

    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between font-mono text-xs text-slate-500 gap-4">
      <div>
        &copy; {today.getFullYear()} Ramón Menor — Todos los derechos reservados.
      </div>
      <div>
        ramonmenor.es
      </div>
    </div>
  </div>
</footer>
