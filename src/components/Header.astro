---
import HeaderLink from "./HeaderLink.astro";
import { SITE_TITLE } from "../consts";
---

<header class="sticky top-0 z-50 w-full border-b border-white/10 bg-black/50 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-4">
      <a href="/" class="flex items-center gap-2 group">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-tr from-indigo-500 to-purple-500 text-white shadow-lg transition-transform group-hover:scale-105">
           <span class="font-bold text-lg">RM</span>
        </div>
        <span class="text-xl font-bold tracking-tight text-white">{SITE_TITLE}</span>
      </a>
    </div>

    <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-gray-300">
      <HeaderLink href="/" class="hover:text-white transition-colors">Inicio</HeaderLink>
      <HeaderLink href="/stack" class="hover:text-white transition-colors">Stack & IA</HeaderLink>
      <HeaderLink href="/skills" class="hover:text-white transition-colors">Skills</HeaderLink>
      <HeaderLink href="/resume" class="hover:text-white transition-colors">Currículum</HeaderLink>
    </nav>
    
    <div class="flex md:hidden">
       {/* Mobile menu could go here */}
    </div>
  </div>
</header>

