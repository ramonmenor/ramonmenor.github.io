---
const projects = [
  {
    title: "RamónMenor.es — AI Portfolio OS",
    badge: "DEMO IA EN VIVO",
    category: "Astro 5 + AI Studio",
    desc: "Plataforma portfolio personal desarrollada con Astro 5, TypeScript, Tailwind CSS y entorno interactivo de simulación de IA en tiempo real.",
    tags: ["Astro 5", "TypeScript", "AI Playground", "Tailwind CSS"],
    link: "#ai-shell",
    featured: true
  },
  {
    title: "Mis Perlas — Búsqueda Semántica RAG",
    badge: "SERVERLESS IA",
    category: "Base Vectorial + AI",
    desc: "Sistema de almacenamiento y consulta de perlas de conocimiento con base de datos serverless Turso (@libsql/client) y búsqueda semántica por embeddings.",
    tags: ["Turso / LibSQL", "Astro", "Embeddings", "TypeScript"],
    link: "#ai-shell",
    featured: false
  },
  {
    title: "Pipeline de Agentes Autónomos LLM",
    badge: "ORQUESTACIÓN IA",
    category: "Multi-Agent System",
    desc: "Sistema multi-agente con Function Calling / MCP para ejecución de tareas automatizadas, scraping inteligente y generación de datos estructurados.",
    tags: ["Gemini API", "Claude Sonnet", "Node.js", "Docker"],
    link: "#ai-shell",
    featured: false
  }
];
---

<div id="projects" class="py-16 sm:py-24">
  <div class="mb-12 flex flex-col sm:flex-row items-start sm:items-end justify-between gap-4">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 font-mono text-xs mb-3">
        <span>🚀 PROYECTOS & CASOS</span>
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-foreground tracking-tight">
        Desarrollos e <span class="gradient-text-purple">Integraciones</span>
      </h2>
    </div>
    <a href="#ai-shell" class="font-mono text-xs text-cyan-400 hover:underline flex items-center gap-1">
      <span>Probar la demo interactiva</span>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
    </a>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {projects.map((proj) => (
      <div class={`glass-panel rounded-3xl p-6 sm:p-7 flex flex-col justify-between transition-all duration-300 hover:-translate-y-1 ${
        proj.featured ? 'border-cyan-500/40 bg-cyan-500/5 shadow-xl shadow-cyan-500/5' : 'hover:border-cyan-500/30'
      }`}>
        <div>
          <div class="flex items-center justify-between font-mono text-xs mb-4">
            <span class="text-muted-foreground">{proj.category}</span>
            <span class="px-2.5 py-0.5 rounded-full bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 text-[10px] font-bold">
              {proj.badge}
            </span>
          </div>
          <h3 class="text-xl font-bold text-foreground mb-3">{proj.title}</h3>
          <p class="text-xs text-muted-foreground leading-relaxed mb-6">{proj.desc}</p>
        </div>

        <div>
          <div class="flex flex-wrap gap-1.5 mb-6 font-mono text-[10px]">
            {proj.tags.map(tag => (
              <span class="px-2.5 py-1 rounded-lg bg-white/5 border border-border/40 text-muted-foreground">{tag}</span>
            ))}
          </div>
          <a
            href={proj.link}
            class="inline-flex items-center gap-1.5 text-xs font-mono font-bold text-cyan-400 hover:text-cyan-300 transition-colors"
          >
            <span>Explorar en IA Studio</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
      </div>
    ))}
  </div>
</div>
