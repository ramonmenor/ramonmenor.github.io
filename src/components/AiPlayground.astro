---
interface Props {
  title?: string;
  subtitle?: string;
}

const { 
  title = "AI Architecture & Prompt Studio", 
  subtitle = "Interactúa en tiempo real con este generador de arquitectura e integración de Inteligencia Artificial para proyectos web." 
} = Astro.props;

const presets = [
  {
    id: "ecommerce-rag",
    label: "E-Commerce con RAG",
    icon: "🛒",
    name: "E-Commerce con Búsqueda Semántica & RAG",
    desc: "Búsqueda de productos por lenguaje natural, recomendación personalizada con base vectorial (Turso/Pinecone) y checkout optimizado.",
    stack: "Astro 5 + TypeScript + Turso (@libsql/client) + Gemini API",
    prompt: "Actúa como un arquitecto senior de IA y desarrollo web. Diseña un sistema de búsqueda semántica y recomendación RAG para e-commerce usando Astro, embeddings vectoriales y Gemini API.",
    code: `import { GoogleGenerativeAI } from "@google/genai";\nimport { createClient } from "@libsql/client";\n\nconst ai = new GoogleGenerativeAI({ apiKey: process.env.GEMINI_API_KEY });\nconst db = createClient({ url: process.env.TURSO_URL, authToken: process.env.TURSO_TOKEN });\n\nexport async function POST({ request }) {\n  const { query } = await request.json();\n  const embedding = await ai.embedContent({ model: "text-embedding-004", content: query });\n  const results = await db.execute({\n    sql: "SELECT id, title, price, vector_distance(embedding, ?) AS dist FROM products ORDER BY dist LIMIT 5",\n    args: [JSON.stringify(embedding.values)]\n  });\n  return new Response(JSON.stringify({ products: results.rows }));\n}`
  },
  {
    id: "saas-agents",
    label: "SaaS con Agentes IA",
    icon: "🤖",
    name: "SaaS B2B con Agentes Autónomos Multi-Paso",
    desc: "Orquestación de agentes con Function Calling / MCP para ejecución de tareas complejas, scraping semántico y reportes automáticos.",
    stack: "Node.js + Express/Astro + Claude Sonnet 3.5 + Docker + Redis",
    prompt: "Eres un desarrollador experto en agentes de IA autónomos. Genera la arquitectura de un pipeline de tareas multi-agente con evaluación de riesgos y fallback a humanos.",
    code: `// Multi-agent workflow runner\nimport { Anthropic } from "@anthropic-ai/sdk";\nconst anthropic = new Anthropic();\n\nexport async function runAgentWorkflow(task: string) {\n  const response = await anthropic.messages.create({\n    model: "claude-3-5-sonnet-20241022",\n    max_tokens: 1024,\n    tools: [{ name: "query_database", description: "Consulta la base de datos SQL" }],\n    messages: [{ role: "user", content: task }]\n  });\n  return response.content;\n}`
  },
  {
    id: "ai-assistant",
    label: "Asistente Web 24/7",
    icon: "💬",
    name: "Asistente Web Inteligente con Memoria Contextual",
    desc: "Chatbot de soporte de baja latencia con streaming en vivo en el navegador, preservación de contexto y derivación humana.",
    stack: "Astro + Tailwind CSS + WebSockets / Server-Sent Events + Ollama/Gemini",
    prompt: "Diseña un asistente conversacional de baja latencia integrado en la interfaz web de una empresa con soporte para streaming SSE y contexto dinamico.",
    code: `// Server-Sent Events (SSE) AI Streaming endpoint in Astro\nexport async function GET({ request }) {\n  const stream = new ReadableStream({\n    async start(controller) {\n      const encoder = new TextEncoder();\n      controller.enqueue(encoder.encode('data: {"text": "Hola, ¿en qué puedo ayudarte hoy?"}\\n\\n'));\n      controller.close();\n    }\n  });\n  return new Response(stream, { headers: { "Content-Type": "text/event-stream" } });\n}`
  }
];
---

<div class="hud-panel p-6 sm:p-8 rounded-2xl relative overflow-hidden border border-neon-cyan/30 shadow-[0_0_30px_rgba(0,240,255,0.08)] bg-card/90 backdrop-blur-xl dark:bg-void-card/90">
  {/* Glowing ambient backdrop */}
  <div class="absolute -top-24 -right-24 w-72 h-72 bg-neon-cyan/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-24 -left-24 w-72 h-72 bg-neon-magenta/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative z-10">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6 pb-6 border-b border-border/40">
      <div>
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-neon-cyan/10 border border-neon-cyan/30 text-neon-cyan font-mono text-xs mb-2">
          <span class="w-2 h-2 rounded-full bg-neon-green animate-pulse"></span>
          Ecosistema IA Interactivo
        </div>
        <h3 class="text-2xl sm:text-3xl font-black text-foreground">{title}</h3>
        <p class="text-sm text-muted-foreground mt-1 max-w-2xl">{subtitle}</p>
      </div>
      <div class="flex items-center gap-2 font-mono text-xs text-muted-foreground">
        <span class="px-2 py-1 rounded bg-secondary border border-border">Gemini / Claude / Ollama</span>
      </div>
    </div>

    {/* Preset selector */}
    <div class="mb-6">
      <label class="block text-xs font-mono uppercase tracking-wider text-muted-foreground mb-3">
        1. Selecciona un escenario de integración de IA:
      </label>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3" id="presetButtons">
        {presets.map((preset, idx) => (
          <button
            type="button"
            data-preset-id={preset.id}
            class={`preset-btn p-3.5 rounded-xl border text-left transition-all duration-200 ${
              idx === 0 
                ? 'border-neon-cyan bg-neon-cyan/10 text-foreground shadow-[0_0_15px_rgba(0,240,255,0.15)]' 
                : 'border-border/60 bg-secondary/40 text-muted-foreground hover:border-neon-cyan/50 hover:text-foreground'
            }`}
          >
            <div class="flex items-center gap-2 font-bold text-sm text-foreground mb-1">
              <span>{preset.icon}</span>
              <span>{preset.label}</span>
            </div>
            <p class="text-xs text-muted-foreground line-clamp-2">{preset.desc}</p>
          </button>
        ))}
      </div>
    </div>

    {/* Custom Prompt Input */}
    <div class="mb-6">
      <div class="flex items-center justify-between mb-2">
        <label for="aiIdeaInput" class="text-xs font-mono uppercase tracking-wider text-muted-foreground">
          2. O describe tu idea de proyecto con IA:
        </label>
        <span class="text-[11px] text-neon-cyan font-mono cursor-pointer hover:underline" id="clearInputBtn">Limpiar</span>
      </div>
      <div class="relative">
        <input
          type="text"
          id="aiIdeaInput"
          placeholder="Ej: Quiero una app de análisis financiero en tiempo real con agentes de IA y alertas por Telegram..."
          class="w-full px-4 py-3 rounded-xl bg-background dark:bg-void border border-border/80 text-sm text-foreground focus:outline-none focus:border-neon-cyan focus:ring-1 focus:ring-neon-cyan transition-all"
        />
        <button
          id="generateAiBtn"
          type="button"
          class="absolute right-2 top-2 px-4 py-1.5 rounded-lg bg-gradient-to-r from-neon-cyan to-cyan-600 text-void font-bold text-xs font-mono hover:opacity-90 transition-opacity flex items-center gap-1.5 shadow-md"
        >
          <span>⚡ Simular IA</span>
        </button>
      </div>
    </div>

    {/* Output Tabs & Terminal */}
    <div class="rounded-xl border border-border/60 bg-background dark:bg-void overflow-hidden shadow-inner">
      <div class="flex items-center justify-between px-4 py-2.5 border-b border-border/40 bg-secondary/50 font-mono text-xs">
        <div class="flex items-center gap-2">
          <button id="tabArch" type="button" class="tab-btn active-tab px-3 py-1 rounded bg-neon-cyan/10 text-neon-cyan font-semibold border border-neon-cyan/30">
            🏗️ Arquitectura
          </button>
          <button id="tabPrompt" type="button" class="tab-btn px-3 py-1 rounded text-muted-foreground hover:text-foreground">
            📝 System Prompt
          </button>
          <button id="tabCode" type="button" class="tab-btn px-3 py-1 rounded text-muted-foreground hover:text-foreground">
            💻 Código TS/Astro
          </button>
        </div>
        <button id="copyBtn" type="button" class="text-xs text-muted-foreground hover:text-neon-cyan transition-colors flex items-center gap-1">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
          <span>Copiar</span>
        </button>
      </div>

      <div class="p-4 sm:p-5 font-mono text-xs leading-relaxed min-h-[220px] max-h-[360px] overflow-y-auto">
        <div id="statusIndicator" class="flex items-center gap-2 mb-3 text-neon-green">
          <span class="w-2 h-2 rounded-full bg-neon-green animate-ping"></span>
          <span id="statusText">Sistema Listo. Selecciona o escribe una idea.</span>
        </div>

        <div id="contentArch" class="tab-content block">
          <div class="text-muted-foreground space-y-3" id="archOutputText">
            <!-- Dynamically populated -->
          </div>
        </div>

        <div id="contentPrompt" class="tab-content hidden">
          <pre id="promptOutputText" class="text-neon-cyan whitespace-pre-wrap font-mono text-xs bg-void-card/50 p-3 rounded border border-border/40"></pre>
        </div>

        <div id="contentCode" class="tab-content hidden">
          <pre id="codeOutputText" class="text-neon-green whitespace-pre-wrap font-mono text-xs bg-void-card/50 p-3 rounded border border-border/40 overflow-x-auto"></pre>
        </div>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ presets }}>
  let currentPreset = presets[0];

  const presetButtons = document.querySelectorAll(".preset-btn");
  const aiIdeaInput = document.getElementById("aiIdeaInput");
  const generateAiBtn = document.getElementById("generateAiBtn");
  const clearInputBtn = document.getElementById("clearInputBtn");
  const statusText = document.getElementById("statusText");
  const archOutputText = document.getElementById("archOutputText");
  const promptOutputText = document.getElementById("promptOutputText");
  const codeOutputText = document.getElementById("codeOutputText");
  const copyBtn = document.getElementById("copyBtn");

  const tabArch = document.getElementById("tabArch");
  const tabPrompt = document.getElementById("tabPrompt");
  const tabCode = document.getElementById("tabCode");
  const contentArch = document.getElementById("contentArch");
  const contentPrompt = document.getElementById("contentPrompt");
  const contentCode = document.getElementById("contentCode");

  function renderPreset(preset) {
    currentPreset = preset;
    statusText.textContent = `Generando propuesta técnica para: ${preset.name}...`;

    archOutputText.innerHTML = `
      <p><strong class="text-foreground">🎯 Proyecto:</strong> ${preset.name}</p>
      <p><strong class="text-foreground">💡 Concepto:</strong> ${preset.desc}</p>
      <p><strong class="text-foreground">🛠️ Stack Recomendado:</strong> <span class="text-neon-cyan">${preset.stack}</span></p>
      <div class="mt-3 p-3 rounded bg-secondary/40 border border-border/50 text-foreground">
        <strong class="text-neon-green">⚡ Flujo de Inteligencia Artificial:</strong>
        <ol class="list-decimal list-inside mt-1 space-y-1 text-muted-foreground">
          <li>Recepción del requerimiento del cliente mediante API/UI web reactiva.</li>
          <li>Procesado de embeddings / embeddings vectoriales en base de datos semántica.</li>
          <li>Orquestación con modelo LLM (Gemini / Claude / Ollama) mediante Function Calling.</li>
          <li>Respuesta en tiempo real con streaming (SSE) y monitoreo de fallos.</li>
        </ol>
      </div>
    `;

    promptOutputText.textContent = preset.prompt;
    codeOutputText.textContent = preset.code;

    setTimeout(() => {
      statusText.textContent = `✅ Análisis completado para ${preset.name}`;
    }, 400);
  }

  // Handle Preset Clicks
  presetButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const presetId = btn.getAttribute("data-preset-id");
      const found = presets.find((p) => p.id === presetId);
      if (found) {
        presetButtons.forEach((b) => {
          b.classList.remove("border-neon-cyan", "bg-neon-cyan/10", "text-foreground", "shadow-[0_0_15px_rgba(0,240,255,0.15)]");
          b.classList.add("border-border/60", "bg-secondary/40", "text-muted-foreground");
        });
        btn.classList.add("border-neon-cyan", "bg-neon-cyan/10", "text-foreground", "shadow-[0_0_15px_rgba(0,240,255,0.15)]");
        btn.classList.remove("border-border/60", "bg-secondary/40", "text-muted-foreground");
        renderPreset(found);
      }
    });
  });

  // Handle Custom Generation
  generateAiBtn?.addEventListener("click", () => {
    const customText = aiIdeaInput.value.trim();
    if (!customText) return;

    statusText.textContent = "⚡ Analizando requerimientos y sintetizando arquitectura de IA...";
    
    setTimeout(() => {
      const customPreset = {
        name: `Proyecto Personalizado: "${customText}"`,
        desc: `Solución a medida basada en: ${customText}`,
        stack: "Astro 5 + TypeScript + Turso / PostgreSQL + Gemini API / Claude Sonnet + Docker",
        prompt: `Actúa como un arquitecto líder de IA. Genera el diseño técnico, la estructura de base de datos y la plantilla de integración para el requerimiento: "${customText}".`,
        code: `// Custom Integration Handler for: ${customText}\nimport { GoogleGenerativeAI } from "@google/genai";\n\nexport async function handleAiTask(input: string) {\n  const ai = new GoogleGenerativeAI({ apiKey: process.env.GEMINI_API_KEY });\n  const model = ai.getGenerativeModel({ model: "gemini-1.5-flash" });\n  const result = await model.generateContent(\`Procesa esta solicitud: \${input}\`);\n  return result.response.text();\n}`
      };
      renderPreset(customPreset);
    }, 600);
  });

  clearInputBtn?.addEventListener("click", () => {
    aiIdeaInput.value = "";
    renderPreset(presets[0]);
  });

  // Tabs switching
  tabArch?.addEventListener("click", () => {
    setActiveTab(tabArch, contentArch);
  });
  tabPrompt?.addEventListener("click", () => {
    setActiveTab(tabPrompt, contentPrompt);
  });
  tabCode?.addEventListener("click", () => {
    setActiveTab(tabCode, contentCode);
  });

  function setActiveTab(activeBtn, activeContent) {
    [tabArch, tabPrompt, tabCode].forEach((b) => {
      b.classList.remove("active-tab", "bg-neon-cyan/10", "text-neon-cyan", "font-semibold", "border", "border-neon-cyan/30");
      b.classList.add("text-muted-foreground");
    });
    [contentArch, contentPrompt, contentCode].forEach((c) => c.classList.add("hidden"));

    activeBtn.classList.add("active-tab", "bg-neon-cyan/10", "text-neon-cyan", "font-semibold", "border", "border-neon-cyan/30");
    activeBtn.classList.remove("text-muted-foreground");
    activeContent.classList.remove("hidden");
  }

  // Copy functionality
  copyBtn?.addEventListener("click", () => {
    let textToCopy = promptOutputText.textContent;
    if (!contentArch.classList.contains("hidden")) {
      textToCopy = archOutputText.innerText;
    } else if (!contentCode.classList.contains("hidden")) {
      textToCopy = codeOutputText.textContent;
    }
    navigator.clipboard.writeText(textToCopy || "").then(() => {
      const origText = copyBtn.querySelector("span").textContent;
      copyBtn.querySelector("span").textContent = "¡Copiado!";
      setTimeout(() => {
        copyBtn.querySelector("span").textContent = origText;
      }, 1500);
    });
  });

  // Initial load
  renderPreset(presets[0]);
</script>
