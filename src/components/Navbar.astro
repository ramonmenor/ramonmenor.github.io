---
interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;
---

<header class="sticky top-0 z-50 w-full bg-white/95 backdrop-blur-md border-b border-slate-200/80">
  <div class="max-w-5xl mx-auto px-3 sm:px-6 h-14 sm:h-16 flex items-center justify-between">
    {/* Brand */}
    <a href="/" class="flex items-center gap-2 group flex-shrink-0">
      <span class="w-8 h-8 rounded-lg bg-slate-900 text-white font-bold text-sm flex items-center justify-center group-hover:bg-blue-600 transition-colors">
        RM
      </span>
      <div class="flex flex-col">
        <span class="font-bold text-slate-900 tracking-tight text-sm leading-tight group-hover:text-blue-600 transition-colors">
          Ramón Menor
        </span>
        <span class="text-[10px] sm:text-[11px] text-slate-500 font-mono leading-tight hidden sm:block">
          Espacio Personal
        </span>
      </div>
    </a>

    {/* Navigation */}
    <nav class="flex items-center gap-1.5 sm:gap-4 text-xs sm:text-sm text-slate-600 font-medium">
      <a href="/" class={`px-2.5 py-1.5 rounded-lg hover:text-slate-900 transition-colors ${currentPath === '/' ? 'text-blue-600 font-semibold bg-blue-50/60' : ''}`}>
        Apps
      </a>
      <a href="/cv" class={`px-2.5 py-1.5 rounded-lg hover:text-slate-900 transition-colors ${currentPath === '/cv' ? 'text-blue-600 font-semibold bg-blue-50/60' : ''}`}>
        CV
      </a>
      <a
        href="/apps/panel-control/"
        class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 font-mono transition-colors border border-slate-200 text-xs"
        title="Panel de Control y Permisos"
      >
        <span>⚙️</span>
        <span class="hidden sm:inline">Panel</span>
      </a>
      <a
        href="https://github.com/ramonmenor"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden md:inline-flex items-center gap-1 hover:text-slate-900 transition-colors text-xs text-slate-500 font-mono pl-1"
      >
        <span>GitHub</span>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
      </a>
    </nav>
  </div>
</header>
