---
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;
---

<div class="sticky top-3 z-50 w-full px-3 sm:px-6 pointer-events-none">
  <header class="max-w-5xl mx-auto h-14 sm:h-15 rounded-2xl border border-slate-200/90 dark:border-slate-800/90 bg-white/80 dark:bg-[#0c0e15]/80 backdrop-blur-xl shadow-sm hover:shadow-md transition-all duration-200 px-3 sm:px-5 flex items-center justify-between gap-3 pointer-events-auto">
    
    {/* Brand Identity */}
    <a href="/" class="flex items-center gap-2.5 group shrink-0">
      <div class="relative w-8 h-8 rounded-xl bg-gradient-to-tr from-sky-500 to-indigo-600 p-[1.5px] transition-transform duration-300 group-hover:scale-105">
        <div class="w-full h-full rounded-[10px] bg-slate-950 text-white flex items-center justify-center font-mono font-bold text-xs">
          RM
        </div>
      </div>
      <div class="flex flex-col">
        <span class="font-bold text-slate-900 dark:text-white tracking-tight text-xs sm:text-sm leading-tight group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors">
          Ramón Menor
        </span>
        <span class="text-[10px] text-slate-500 dark:text-slate-400 font-mono tracking-wider uppercase leading-tight hidden xs:block">
          Toolbox OS
        </span>
      </div>
    </a>

    {/* Center Navigation Links (desktop) */}
    <nav class="hidden md:flex items-center gap-1 text-xs font-mono">
      <a
        href="/"
        class={`px-3 py-1.5 rounded-xl transition-all ${currentPath === '/' ? 'bg-slate-100 dark:bg-slate-800 text-sky-600 dark:text-sky-400 font-bold shadow-xs' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100/70 dark:hover:bg-slate-800/50'}`}
      >
        HERRAMIENTAS
      </a>
      <a
        href="/cv"
        class={`px-3 py-1.5 rounded-xl transition-all ${currentPath === '/cv' ? 'bg-slate-100 dark:bg-slate-800 text-sky-600 dark:text-sky-400 font-bold shadow-xs' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100/70 dark:hover:bg-slate-800/50'}`}
      >
        TRAYECTORIA
      </a>
      <a
        href="https://github.com/ramonmenor"
        target="_blank"
        rel="noopener noreferrer"
        class="px-2.5 py-1.5 rounded-xl text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100/70 dark:hover:bg-slate-800/50 transition-colors inline-flex items-center gap-1"
        title="Ver código fuente en GitHub"
      >
        <span>GITHUB</span>
        <svg class="w-3 h-3 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
      </a>
    </nav>

    {/* Right Controls: Panel button + Live clock + Theme Switcher */}
    <div class="flex items-center gap-2">
      <div id="nav-live-clock" class="hidden lg:flex items-center gap-1.5 text-[11px] font-mono text-slate-400 dark:text-slate-500 px-2 py-1 rounded-lg bg-slate-100/60 dark:bg-slate-900/40 border border-slate-200/50 dark:border-slate-800/50">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <span id="nav-clock-time">00:00:00</span>
      </div>

      <a
        href="/apps/panel-control/"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/80 dark:bg-slate-900/80 text-xs font-mono text-slate-700 dark:text-slate-300 hover:border-sky-500/40 hover:text-sky-600 dark:hover:text-sky-400 transition-all shadow-2xs"
        title="Panel de Control y Permisos"
      >
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="hidden sm:inline">Panel</span>
      </a>

      {/* Theme Switcher */}
      <ThemeToggle />
    </div>

  </header>
</div>

<script>
  function updateNavClock() {
    const el = document.getElementById('nav-clock-time');
    if (el) {
      const d = new Date();
      const h = String(d.getHours()).padStart(2, '0');
      const m = String(d.getMinutes()).padStart(2, '0');
      const s = String(d.getSeconds()).padStart(2, '0');
      el.textContent = `${h}:${m}:${s}`;
    }
  }
  updateNavClock();
  setInterval(updateNavClock, 1000);
</script>
