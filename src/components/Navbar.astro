---
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;
---

<header class="sticky top-0 z-50 w-full border-b border-zinc-200 dark:border-zinc-800 bg-white/95 dark:bg-[#07080b]/95 backdrop-blur-md transition-colors duration-200">
  <div class="max-w-6xl mx-auto px-3 sm:px-6 h-13 flex items-center justify-between gap-3">
    
    {/* Brand Identity */}
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="w-7 h-7 bg-zinc-950 text-white dark:bg-cyan-400 dark:text-zinc-950 flex items-center justify-center font-mono font-black text-xs tracking-tighter transition-transform group-hover:scale-105">
        RM
      </div>
      <div class="flex items-center gap-2 font-mono">
        <span class="font-bold text-xs tracking-wider uppercase text-zinc-900 dark:text-zinc-100 group-hover:text-cyan-500 transition-colors">
          RAMONMENOR.ES
        </span>
        <span class="hidden sm:inline-block text-[10px] px-1.5 py-0.5 border border-zinc-300 dark:border-zinc-700 text-zinc-500 dark:text-zinc-400 uppercase tracking-widest">
          v2.0
        </span>
      </div>
    </a>

    {/* Center Navigation Links (desktop) */}
    <nav class="hidden md:flex items-center gap-1 font-mono text-xs">
      <a
        href="/"
        class={`px-3 py-1 border transition-all ${currentPath === '/' ? 'border-zinc-950 dark:border-cyan-400 bg-zinc-950 dark:bg-cyan-400 text-white dark:text-zinc-950 font-bold' : 'border-transparent text-zinc-600 dark:text-zinc-400 hover:border-zinc-300 dark:hover:border-zinc-700'}`}
      >
        [ APPS ]
      </a>
      <a
        href="/cv"
        class={`px-3 py-1 border transition-all ${currentPath === '/cv' ? 'border-zinc-950 dark:border-cyan-400 bg-zinc-950 dark:bg-cyan-400 text-white dark:text-zinc-950 font-bold' : 'border-transparent text-zinc-600 dark:text-zinc-400 hover:border-zinc-300 dark:hover:border-zinc-700'}`}
      >
        [ CV / PERFIL ]
      </a>
      <a
        href="https://github.com/ramonmenor"
        target="_blank"
        rel="noopener noreferrer"
        class="px-2.5 py-1 text-zinc-500 dark:text-zinc-400 hover:text-black dark:hover:text-white transition-colors inline-flex items-center gap-1"
        title="Código fuente"
      >
        GITHUB ↗
      </a>
    </nav>

    {/* Right Controls: Panel button + Live clock + Theme Switcher */}
    <div class="flex items-center gap-2 font-mono text-xs">
      
      <div id="nav-live-clock" class="hidden sm:flex items-center gap-1.5 px-2 py-1 border border-zinc-200 dark:border-zinc-800 text-[11px] text-zinc-500 dark:text-zinc-400 bg-zinc-50 dark:bg-zinc-900/60">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <span id="nav-clock-time">00:00:00</span>
      </div>

      <a
        href="/apps/panel-control/"
        class="inline-flex items-center gap-1.5 px-2.5 py-1 border border-zinc-300 dark:border-zinc-700 bg-zinc-100 dark:bg-zinc-900 text-zinc-800 dark:text-zinc-200 hover:border-zinc-950 dark:hover:border-cyan-400 transition-colors"
        title="Panel de Control y Permisos"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-ping"></span>
        <span class="text-xs">PANEL</span>
      </a>

      {/* Theme Switcher */}
      <ThemeToggle />
    </div>

  </div>
</header>

<script>
  function updateNavClock() {
    const el = document.getElementById('nav-clock-time');
    if (el) {
      const d = new Date();
      const h = String(d.getHours()).padStart(2, '0');
      const m = String(d.getMinutes()).padStart(2, '0');
      const s = String(d.getSeconds()).padStart(2, '0');
      el.textContent = `${h}:${m}:${s}`;
    }
  }
  updateNavClock();
  setInterval(updateNavClock, 1000);
</script>
