---
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;
---

<header class="sticky top-0 z-50 w-full bg-white/85 dark:bg-[#090d16]/85 backdrop-blur-md border-b border-slate-200/80 dark:border-slate-800/80 transition-colors duration-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
    
    {/* Brand */}
    <a href="/" class="flex items-center gap-3 group shrink-0">
      <div class="w-9 h-9 rounded-xl bg-slate-900 text-white dark:bg-white dark:text-slate-950 font-black text-sm flex items-center justify-center shadow-sm group-hover:scale-105 transition-transform duration-200">
        RM
      </div>
      <div class="flex flex-col">
        <span class="font-bold text-slate-900 dark:text-white tracking-tight text-sm leading-tight group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors">
          Ramón Menor
        </span>
        <span class="text-[11px] text-slate-500 dark:text-slate-400 font-mono tracking-wider uppercase leading-tight">
          Suite de Herramientas
        </span>
      </div>
    </a>

    {/* Center Navigation Links (desktop) */}
    <nav class="hidden md:flex items-center gap-1 text-xs font-mono">
      <a
        href="/"
        class={`px-3 py-1.5 rounded-lg transition-colors ${currentPath === '/' ? 'bg-slate-100 dark:bg-slate-800/80 text-sky-600 dark:text-sky-400 font-semibold' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100/60 dark:hover:bg-slate-800/50'}`}
      >
        HERRAMIENTAS
      </a>
      <a
        href="/cv"
        class={`px-3 py-1.5 rounded-lg transition-colors ${currentPath === '/cv' ? 'bg-slate-100 dark:bg-slate-800/80 text-sky-600 dark:text-sky-400 font-semibold' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100/60 dark:hover:bg-slate-800/50'}`}
      >
        TRAYECTORIA
      </a>
      <a
        href="https://github.com/ramonmenor"
        target="_blank"
        rel="noopener noreferrer"
        class="px-3 py-1.5 rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100/60 dark:hover:bg-slate-800/50 transition-colors inline-flex items-center gap-1"
      >
        <span>GITHUB</span>
        <svg class="w-3 h-3 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
      </a>
    </nav>

    {/* Right Controls: Panel button + Theme Switcher */}
    <div class="flex items-center gap-2 sm:gap-3">
      <a
        href="/apps/panel-control/"
        class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-xs font-mono text-slate-700 dark:text-slate-300 hover:border-sky-500/40 hover:text-sky-600 dark:hover:text-sky-400 transition-all shadow-sm"
        title="Panel de Control y Permisos"
      >
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="hidden sm:inline">Panel de Control</span>
        <span class="sm:hidden">Panel</span>
      </a>

      {/* Theme Toggle Button */}
      <ThemeToggle />
    </div>

  </div>
</header>
