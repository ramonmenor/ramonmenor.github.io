---
---

<div id="asistente-ia" class="scroll-mt-24">
  <div class="clean-card p-6 sm:p-8 bg-slate-50/50 border border-slate-200">
    <div class="max-w-3xl mx-auto">
      {/* Header */}
      <div class="text-center mb-6">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-50 border border-blue-200 text-blue-700 text-xs font-medium mb-3">
          <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
          Asistente de Consulta IA en Vivo
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">
          Pregunta sobre mi experiencia o consulta un proyecto
        </h2>
        <p class="text-sm text-slate-600 mt-2">
          Haz cualquier consulta en lenguaje natural sobre mi stack, integración de IA (Gemini, Claude, Ollama, RAG) o metodologías de trabajo.
        </p>
      </div>

      {/* Input Form */}
      <div class="relative mb-4">
        <div class="flex items-center bg-white border border-slate-300 rounded-xl p-2 shadow-sm focus-within:border-blue-600 focus-within:ring-1 focus-within:ring-blue-600 transition-all">
          <svg class="w-5 h-5 text-slate-400 ml-2 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <input
            type="text"
            id="queryInput"
            placeholder="Ej: ¿Qué soluciones de IA has implementado? o ¿Cómo integrarías RAG en mi web?"
            class="w-full text-sm text-slate-900 bg-transparent focus:outline-none placeholder:text-slate-400"
          />
          <button
            id="querySubmitBtn"
            type="button"
            class="px-4 py-2 rounded-lg bg-blue-600 text-white font-medium text-xs hover:bg-blue-700 transition-colors flex items-center gap-1.5 ml-2"
          >
            <span>Consultar</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </button>
        </div>
      </div>

      {/* Prompt suggestions */}
      <div class="flex flex-wrap items-center gap-2 mb-6 text-xs">
        <span class="text-slate-500">Consultas frecuentes:</span>
        <button type="button" class="query-chip px-3 py-1 rounded-full bg-white border border-slate-200 text-slate-700 hover:border-blue-400 hover:text-blue-600 transition-colors" data-prompt="experiencia-ia">
          🧠 Experiencia en Inteligencia Artificial
        </button>
        <button type="button" class="query-chip px-3 py-1 rounded-full bg-white border border-slate-200 text-slate-700 hover:border-blue-400 hover:text-blue-600 transition-colors" data-prompt="stack-web">
          ⚙️ Stack Web & Backend
        </button>
        <button type="button" class="query-chip px-3 py-1 rounded-full bg-white border border-slate-200 text-slate-700 hover:border-blue-400 hover:text-blue-600 transition-colors" data-prompt="ejemplo-rag">
          🛒 ¿Cómo aplicas RAG a una web?
        </button>
        <button type="button" class="query-chip px-3 py-1 rounded-full bg-white border border-slate-200 text-slate-700 hover:border-blue-400 hover:text-blue-600 transition-colors" data-prompt="contacto-proyectos">
          📩 Disponibilidad & Proyectos
        </button>
      </div>

      {/* Response Box */}
      <div id="responseContainer" class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm min-h-[160px]">
        <div id="responseText" class="text-sm text-slate-700 leading-relaxed space-y-3">
          <p class="text-slate-500 italic">
            Selecciona una de las consultas de ejemplo o escribe la tuya para obtener información directa sobre la trayectoria, capacidades y metodologías de integración de IA de Ramón Menor.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const queryInput = document.getElementById('queryInput') as HTMLInputElement;
  const querySubmitBtn = document.getElementById('querySubmitBtn');
  const responseText = document.getElementById('responseText');
  const queryChips = document.querySelectorAll('.query-chip');

  const knowledgeBase = {
    'experiencia-ia': `
      <div class="font-semibold text-slate-900 mb-1">🧠 Integración de Inteligencia Artificial</div>
      <p class="mb-2">Ramón Menor integra modelos LLM y soluciones de IA directamente en proyectos web de producción:</p>
      <ul class="list-disc list-inside space-y-1 text-slate-600 font-mono text-xs">
        <li><strong>Modelos:</strong> Gemini API, Claude Sonnet 3.5, OpenAI GPT-4o y modelos locales con Ollama.</li>
        <li><strong>RAG & Vector DB:</strong> Búsqueda semántica sobre bases de datos privadas usando Turso (@libsql/client) y embeddings.</li>
        <li><strong>Agentes Autónomos:</strong> Orquestación con Function Calling / MCP para ejecución de tareas multi-paso.</li>
        <li><strong>Streaming UI:</strong> Interfaces reactivas con Server-Sent Events (SSE) para respuestas en tiempo real.</li>
      </ul>
    `,
    'stack-web': `
      <div class="font-semibold text-slate-900 mb-1">⚙️ Stack de Desarrollo Web (+15 Años de Experiencia)</div>
      <p class="mb-2">Arquitecturas estables, rápidas y orientadas a producto:</p>
      <ul class="list-disc list-inside space-y-1 text-slate-600 font-mono text-xs">
        <li><strong>Frontend:</strong> Astro 5, TypeScript, JavaScript (ESNext), Tailwind CSS y HTML semántico.</li>
        <li><strong>Backend:</strong> PHP (Yii2 Framework), Node.js, Express y desarrollo de APIs RESTful.</li>
        <li><strong>Bases de Datos:</strong> MySQL, PostgreSQL, Turso / LibSQL (Serverless Edge DB).</li>
        <li><strong>DevOps & Infraestructura:</strong> Servidores Linux Debian, Docker, Nginx, VPNs y respaldos.</li>
      </ul>
    `,
    'ejemplo-rag': `
      <div class="font-semibold text-slate-900 mb-1">🛒 Aplicación Práctica de RAG en Entornos Web</div>
      <p class="mb-2">Para implementar RAG (Generación Aumentada por Recuperación) en una aplicación web:</p>
      <ol class="list-decimal list-inside space-y-1 text-slate-600 font-mono text-xs">
        <li>Vectorización del catálogo/documentación mediante modelos de embeddings (text-embedding-004).</li>
        <li>Almacenamiento de vectores en base de datos de alta velocidad (Turso / Pinecone).</li>
        <li>Búsqueda por similitud del coseno ante cada consulta del usuario.</li>
        <li>Generación contextualizada de respuesta mediante el LLM y renderizado en Astro/TypeScript.</li>
      </ol>
    `,
    'contacto-proyectos': `
      <div class="font-semibold text-slate-900 mb-1">📩 Disponibilidad para Proyectos & Colaboración</div>
      <p class="mb-2">Ramón Menor está disponible para:</p>
      <ul class="list-disc list-inside space-y-1 text-slate-600 font-mono text-xs">
        <li>Desarrollo completo de aplicaciones web modernas e inteligentes.</li>
        <li>Integración de soluciones de Inteligencia Artificial en productos o sistemas existentes.</li>
        <li>Consultoría en arquitectura de software, bases de datos e infraestructura Linux.</li>
      </ul>
      <div class="mt-3 pt-2 border-t border-slate-100 font-semibold text-blue-600 text-xs">
        Contacto directo: <a href="mailto:ramonmenor@gmail.com" class="underline">ramonmenor@gmail.com</a> | <a href="https://linkedin.com/in/ramonmenor" target="_blank" class="underline">LinkedIn</a>
      </div>
    `
  };

  function processQuery(promptKey?: string, customText?: string) {
    if (!responseText) return;

    responseText.innerHTML = `
      <div class="flex items-center gap-2 text-slate-500 py-2">
        <svg class="animate-spin h-4 w-4 text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span>Procesando consulta...</span>
      </div>
    `;

    setTimeout(() => {
      if (promptKey && knowledgeBase[promptKey as keyof typeof knowledgeBase]) {
        responseText.innerHTML = knowledgeBase[promptKey as keyof typeof knowledgeBase];
      } else if (customText) {
        responseText.innerHTML = `
          <div class="font-semibold text-slate-900 mb-1">💡 Respuesta para: "${customText}"</div>
          <p class="text-slate-600 mb-2">
            En base al perfil de Ramón Menor: Desarrollador Web Full Stack con más de 15 años de trayectoria en PHP, Astro, TypeScript, SQL y Docker, especializado en la integración de Inteligencia Artificial (Gemini API, Claude, OpenAI, RAG y Agentes autónomos).
          </p>
          <p class="text-slate-600 font-mono text-xs">
            Esta solución se puede estructurar utilizando una arquitectura limpia en Astro 5 + TypeScript + base de datos relacional y conexión directa con modelos LLM.
          </p>
        `;
      } else {
        responseText.innerHTML = knowledgeBase['experiencia-ia'];
      }
    }, 300);
  }

  queryChips.forEach(chip => {
    chip.addEventListener('click', () => {
      const promptKey = chip.getAttribute('data-prompt') || '';
      processQuery(promptKey);
    });
  });

  querySubmitBtn?.addEventListener('click', () => {
    const text = queryInput.value.trim();
    if (text) processQuery(undefined, text);
  });

  queryInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      const text = queryInput.value.trim();
      if (text) processQuery(undefined, text);
    }
  });
</script>
