---
---

<div id="ai-shell" class="glass-panel glass-panel-glow rounded-3xl p-6 sm:p-8 relative overflow-hidden shadow-2xl">
  {/* Ambient glowing radial effects */}
  <div class="absolute -top-32 -right-32 w-80 h-80 bg-cyan-500/15 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-32 -left-32 w-80 h-80 bg-purple-500/15 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative z-10">
    {/* Terminal Title Bar */}
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-6 border-b border-border/40">
      <div class="flex items-center gap-3">
        <div class="flex items-center gap-1.5">
          <span class="w-3 h-3 rounded-full bg-rose-500/80 inline-block"></span>
          <span class="w-3 h-3 rounded-full bg-amber-500/80 inline-block"></span>
          <span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block"></span>
        </div>
        <span class="font-mono text-xs font-bold tracking-wider text-foreground">RAMÓN_MENOR // AI_STUDIO_v3.5</span>
        <span class="px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-mono text-[10px] animate-pulse">
          ● ONLINE
        </span>
      </div>

      <div class="flex items-center gap-2 font-mono text-xs text-muted-foreground">
        <span class="px-2 py-1 rounded-md bg-white/5 border border-border/40">Gemini 1.5 Pro</span>
        <span class="px-2 py-1 rounded-md bg-white/5 border border-border/40">Claude Sonnet 3.5</span>
        <span class="px-2 py-1 rounded-md bg-white/5 border border-border/40">Ollama Local</span>
      </div>
    </div>

    {/* Mode Selector Tabs */}
    <div class="mt-6 flex flex-wrap items-center gap-2 font-mono text-xs" id="modeTabs">
      <button
        data-mode="agent"
        type="button"
        class="mode-tab active-tab px-4 py-2 rounded-xl bg-cyan-500/15 text-cyan-400 border border-cyan-500/40 font-bold transition-all shadow-md shadow-cyan-500/10"
      >
        🤖 Simulador de Agente Multi-Paso
      </button>
      <button
        data-mode="arch"
        type="button"
        class="mode-tab px-4 py-2 rounded-xl bg-white/5 text-muted-foreground hover:text-foreground border border-border/40 transition-all"
      >
        🏗️ Generador de Arquitectura & Prompt
      </button>
      <button
        data-mode="chat"
        type="button"
        class="mode-tab px-4 py-2 rounded-xl bg-white/5 text-muted-foreground hover:text-foreground border border-border/40 transition-all"
      >
        💬 Preguntas a Ramón AI
      </button>
    </div>

    {/* Quick Presets */}
    <div class="mt-4 flex flex-wrap gap-2">
      <span class="font-mono text-[11px] text-muted-foreground py-1">Sugerencias:</span>
      <button type="button" class="preset-chip px-3 py-1 rounded-lg bg-white/5 hover:bg-cyan-500/10 hover:text-cyan-400 border border-border/40 text-xs font-mono transition-all" data-query="E-commerce con RAG y búsqueda semántica en Turso DB">
        🛒 E-commerce con RAG
      </button>
      <button type="button" class="preset-chip px-3 py-1 rounded-lg bg-white/5 hover:bg-cyan-500/10 hover:text-cyan-400 border border-border/40 text-xs font-mono transition-all" data-query="Agente autónomo para scraping y automatización de APIs">
        🤖 Agente de Automatización API
      </button>
      <button type="button" class="preset-chip px-3 py-1 rounded-lg bg-white/5 hover:bg-cyan-500/10 hover:text-cyan-400 border border-border/40 text-xs font-mono transition-all" data-query="¿Cómo integra Ramón la Inteligencia Artificial en proyectos Astro y PHP?">
        ⚙️ ¿Cómo integra Ramón la IA?
      </button>
      <button type="button" class="preset-chip px-3 py-1 rounded-lg bg-white/5 hover:bg-cyan-500/10 hover:text-cyan-400 border border-border/40 text-xs font-mono transition-all" data-query="¿Está Ramón disponible para desarrollar un producto web completo?">
        📩 Disponibilidad & Tarifas
      </button>
    </div>

    {/* Input Area */}
    <div class="mt-5 relative">
      <input
        type="text"
        id="terminalInput"
        placeholder="Escribe una consulta o idea de proyecto (Ej: Quiero un SaaS con agentes de IA y base de datos SQL)..."
        class="w-full pl-4 pr-32 py-3.5 rounded-2xl bg-black/40 border border-border/60 text-sm text-foreground placeholder:text-muted-foreground/60 focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 font-mono transition-all shadow-inner"
      />
      <button
        id="terminalSubmitBtn"
        type="button"
        class="absolute right-2 top-2 px-4 py-2 rounded-xl bg-gradient-to-r from-cyan-500 to-indigo-600 text-white font-mono text-xs font-bold hover:opacity-90 transition-opacity flex items-center gap-1.5 shadow-md shadow-cyan-500/20"
      >
        <span>Ejecutar IA ↵</span>
      </button>
    </div>

    {/* Console Output Screen */}
    <div class="mt-4 rounded-2xl border border-border/60 bg-black/70 overflow-hidden shadow-inner font-mono text-xs">
      <div class="flex items-center justify-between px-4 py-2 border-b border-border/40 bg-white/[0.02] text-muted-foreground text-[11px]">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
          <span id="outputModeLabel">MODO: AGENTE MULTI-PASO</span>
        </div>
        <button id="copyTerminalOutput" type="button" class="hover:text-cyan-400 transition-colors flex items-center gap-1">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
          <span>Copiar Resultado</span>
        </button>
      </div>

      <div id="outputDisplay" class="p-4 sm:p-5 min-h-[220px] max-h-[380px] overflow-y-auto leading-relaxed space-y-3">
        <!-- Initial Welcome State -->
        <div class="text-cyan-400 font-bold">$ rm-ai-studio --init</div>
        <p class="text-muted-foreground">
          Bienvenido al estudio interactivo de Inteligencia Artificial de Ramón Menor. Selecciona un modo arriba o introduce cualquier idea para simular la arquitectura, el flujo de agentes o consultar sobre el perfil.
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  let activeMode = 'agent';
  const terminalInput = document.getElementById('terminalInput') as HTMLInputElement;
  const terminalSubmitBtn = document.getElementById('terminalSubmitBtn');
  const outputDisplay = document.getElementById('outputDisplay');
  const outputModeLabel = document.getElementById('outputModeLabel');
  const modeTabs = document.querySelectorAll('.mode-tab');
  const presetChips = document.querySelectorAll('.preset-chip');
  const copyTerminalOutput = document.getElementById('copyTerminalOutput');

  const modeData = {
    agent: {
      label: 'MODO: AGENTE MULTI-PASO',
      response: (query: string) => `
<div class="text-cyan-400 font-bold">$ rm-agent-runner --task "${query || 'Ejecución de Agente Autónomo'}"</div>
<div class="text-emerald-400">✔ [PASO 1/4] Análisis de Requerimiento: Sintetizando objetivo y definiendo esquema JSON de entrada.</div>
<div class="text-emerald-400">✔ [PASO 2/4] Function Calling / MCP: Ejecutando consulta de embeddings en base vectorial.</div>
<div class="text-purple-400">⚡ [PASO 3/4] Orquestación LLM (Gemini 1.5 Pro / Claude Sonnet): Procesando razonamiento con plantilla de seguridad.</div>
<div class="text-cyan-400">✔ [PASO 4/4] Salida Estructurada: Retornando datos validados e integración en interfaz web Astro.</div>
<div class="mt-3 p-3 rounded-xl bg-white/5 border border-white/10 text-foreground">
  <div class="font-bold text-emerald-400 mb-1">💡 Resultado de Ejecución:</div>
  <p class="text-muted-foreground leading-relaxed">
    Ramón Menor diseña este tipo de agentes autónomos para automatizar flujos complejos en aplicaciones web: desde scraping semántico y consultas SQL hasta envío de alertas inteligentes y agentes conversacionales sin latencia.
  </p>
</div>`
    },
    arch: {
      label: 'MODO: ARQUITECTURA & PROMPT ENGINE',
      response: (query: string) => `
<div class="text-cyan-400 font-bold">$ rm-arch-synthesizer --query "${query || 'Arquitectura Web + IA'}"</div>
<div class="p-3 rounded-xl bg-white/5 border border-white/10 text-foreground space-y-2">
  <div><strong class="text-cyan-400">🏗️ Stack Frontend & API:</strong> Astro 5 + TypeScript + Tailwind CSS + APIs REST / Server-Sent Events (SSE).</div>
  <div><strong class="text-emerald-400">🧠 Capa de Inteligencia Artificial:</strong> Gemini API / Claude Sonnet 3.5 + Vector DB (Turso / LibSQL) + Ollama Local.</div>
  <div><strong class="text-purple-400">⚙️ Backend & DB:</strong> PHP (Yii2) / Node.js + MySQL / PostgreSQL + Docker en Debian Linux.</div>
</div>
<div class="mt-3">
  <div class="text-amber-400 font-bold mb-1">📝 System Prompt Recomendado de Producción:</div>
  <pre class="bg-black/60 p-3 rounded-lg border border-border/40 text-cyan-300 font-mono text-[11px] whitespace-pre-wrap">Actúa como un arquitecto senior de IA y software web. Diseña un sistema escalable y seguro para: "${query || 'Aplicación Web con IA'}", aplicando buenas prácticas de baja latencia y separación de capas.</pre>
</div>`
    },
    chat: {
      label: 'MODO: ASISTENTE RAMÓN AI',
      response: (query: string) => `
<div class="text-cyan-400 font-bold">$ ramon-ai-assistant --prompt "${query || 'Información de Ramón Menor'}"</div>
<div class="p-3.5 rounded-xl bg-white/5 border border-white/10 text-foreground space-y-2">
  <p><strong>Ramón Menor</strong> es un Desarrollador Web Full Stack con más de 15 años de experiencia acumulada en ingeniería de software (PHP, Yii2, Astro, JavaScript, MySQL, Docker, Linux Debian) y especialización directa en <strong>Inteligencia Artificial</strong> (Gemini, Claude, OpenAI, Ollama, RAG y Agentes autónomos).</p>
  <div class="text-emerald-400 font-mono text-[11px] pt-1">
    ✓ Disponible para proyectos web integrales, asesoría en IA e integración de sistemas.
  </div>
</div>`
    }
  };

  function switchMode(mode: string) {
    activeMode = mode;
    modeTabs.forEach(tab => {
      if (tab.getAttribute('data-mode') === mode) {
        tab.className = 'mode-tab active-tab px-4 py-2 rounded-xl bg-cyan-500/15 text-cyan-400 border border-cyan-500/40 font-bold transition-all shadow-md shadow-cyan-500/10';
      } else {
        tab.className = 'mode-tab px-4 py-2 rounded-xl bg-white/5 text-muted-foreground hover:text-foreground border border-border/40 transition-all';
      }
    });
    if (outputModeLabel) {
      outputModeLabel.textContent = modeData[mode as keyof typeof modeData].label;
    }
  }

  function runSimulation(query: string) {
    if (!outputDisplay) return;
    outputDisplay.innerHTML = `<div class="text-amber-400 animate-pulse">$ procesando solicitud con IA...</div>`;
    setTimeout(() => {
      const modeObj = modeData[activeMode as keyof typeof modeData];
      outputDisplay.innerHTML = modeObj.response(query);
    }, 350);
  }

  modeTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const mode = tab.getAttribute('data-mode');
      if (mode) {
        switchMode(mode);
        runSimulation(terminalInput.value.trim());
      }
    });
  });

  presetChips.forEach(chip => {
    chip.addEventListener('click', () => {
      const query = chip.getAttribute('data-query') || '';
      terminalInput.value = query;
      runSimulation(query);
    });
  });

  terminalSubmitBtn?.addEventListener('click', () => {
    runSimulation(terminalInput.value.trim());
  });

  terminalInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      runSimulation(terminalInput.value.trim());
    }
  });

  copyTerminalOutput?.addEventListener('click', () => {
    const text = outputDisplay?.innerText || '';
    navigator.clipboard.writeText(text).then(() => {
      const span = copyTerminalOutput.querySelector('span');
      if (span) {
        const orig = span.textContent;
        span.textContent = '¡Copiado!';
        setTimeout(() => { span.textContent = orig; }, 1500);
      }
    });
  });
</script>
