---
interface Props {
  name: string;
  category: string;
  description: string;
}

const { name, category, description } = Astro.props;

const categoryColors: Record<string, string> = {
  "IDE & Editor": "from-blue-500 to-cyan-500",
  "Workflow & Version Control": "from-gray-500 to-gray-700",
  "AI LLM": "from-purple-500 to-pink-500",
  "AI Coding Assistant": "from-indigo-500 to-blue-600",
  "AI Studio & Platform": "from-orange-500 to-red-500",
  "Automation": "from-green-500 to-emerald-600",
  "Generative UI": "from-pink-500 to-rose-500"
};

const gradient = categoryColors[category] || "from-indigo-500 to-purple-500";
const initial = name.charAt(0).toUpperCase();
---

<div class="group relative bg-white dark:bg-white/5 border border-gray-200 dark:border-white/10 rounded-2xl p-6 hover:border-gray-300 dark:hover:bg-white/10 shadow-sm dark:shadow-lg dark:shadow-black/50 hover:shadow-lg transition-all duration-300 overflow-hidden">

  <div class="absolute inset-0 bg-gradient-to-br from-gray-50 to-transparent dark:from-white/5 opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"></div>

  <div class="flex items-start gap-5 relative z-10">
    <div class={`flex-shrink-0 w-16 h-16 rounded-2xl bg-gradient-to-br ${gradient} flex items-center justify-center text-2xl font-bold text-white shadow-inner`}>
      {initial}
    </div>

    <div>
      <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-1 group-hover:text-indigo-600 dark:group-hover:text-indigo-300 transition-colors">{name}</h3>
      <span class="inline-block px-2 py-1 bg-gray-100 dark:bg-white/10 text-gray-600 dark:text-gray-300 text-xs rounded-md mb-3 font-medium tracking-wide">
        {category}
      </span>
      <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
        {description}
      </p>
    </div>
  </div>
</div>
