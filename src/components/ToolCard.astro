---
interface Props {
  name: string;
  category: string;
  description: string;
}

const { name, category, description } = Astro.props;

const categoryColors: Record<string, string> = {
  "IDE & Editor": "from-neon-cyan to-blue-700",
  "Workflow & Version Control": "from-slate-500 to-slate-800",
  "AI LLM": "from-neon-magenta to-fuchsia-800",
  "AI Coding Assistant": "from-neon-cyan to-blue-700",
  "AI Studio & Platform": "from-neon-amber to-orange-700",
  "Automation": "from-neon-green to-emerald-700",
  "Generative UI": "from-neon-magenta to-rose-700"
};

const gradient = categoryColors[category] || "from-neon-cyan to-neon-magenta";
const initial = name.charAt(0).toUpperCase();
---

<div class="group relative bg-card border border-border rounded-2xl p-6 hover:border-neon-cyan/50 dark:hover:bg-white/5 transition-all duration-300 overflow-hidden">

  <div class="absolute inset-0 bg-gradient-to-br from-neon-cyan/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"></div>

  <div class="flex items-start gap-5 relative z-10">
    <div class={`flex-shrink-0 w-16 h-16 rounded-2xl bg-gradient-to-br ${gradient} flex items-center justify-center text-2xl font-bold text-foreground shadow-inner`}>
      {initial}
    </div>

    <div>
      <h3 class="text-xl font-bold text-foreground mb-1 group-hover:text-neon-cyan transition-colors">{name}</h3>
      <span class="inline-block px-2 py-1 bg-secondary text-secondary-foreground text-xs rounded-md mb-3 font-medium tracking-wide">
        {category}
      </span>
      <p class="text-sm text-muted-foreground leading-relaxed">
        {description}
      </p>
    </div>
  </div>
</div>
