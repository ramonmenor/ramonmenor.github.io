---
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "@fortawesome/fontawesome-free/css/all.min.css";
import { SITE_TITLE } from "../consts";

type Props = CollectionEntry<"misperlas">["data"];

const { title } = Astro.props;
---

<html lang="es">
  <head>
    <BaseHead title={`${title} | ${SITE_TITLE}`} />
  </head>

  <body class="bg-background text-foreground min-h-screen flex flex-col">
    <Header title={SITE_TITLE} currentPath="/misperlas" />
    <main class="flex-1 w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <article class="max-w-3xl mx-auto">
        <div class="flex items-center justify-between mb-6">
          <a href="/misperlas" class="inline-flex items-center gap-2 text-sm font-mono text-muted-foreground hover:text-neon-magenta transition-colors">
            <i class="fa-solid fa-arrow-left"></i>
            <span class="hidden sm:inline">Volver</span>
          </a>
          <a href="/misperlas" class="inline-flex items-center gap-2 text-sm font-mono text-muted-foreground hover:text-neon-magenta transition-colors">
            <span class="hidden sm:inline">Índice</span>
            <i class="fa-solid fa-arrow-right"></i>
          </a>
        </div>
        <div class="text-center mb-8">
          <h3 class="text-2xl font-bold text-foreground">{title}</h3>
          <div class="w-16 h-1 bg-neon-magenta rounded-full mx-auto mt-3"></div>
        </div>
        <div class="prose prose-lg max-w-none text-red-600 dark:text-red-300">
          <slot />
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
