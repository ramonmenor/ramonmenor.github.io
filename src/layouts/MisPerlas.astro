---
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "@fortawesome/fontawesome-free/css/all.min.css";
import { SITE_TITLE } from "../consts";

type Props = CollectionEntry<"misperlas">["data"];

const { title } = Astro.props;
---

<html lang="es">
  <head>
    <BaseHead title={`${title} | ${SITE_TITLE}`} />
  </head>

  <body class="bg-white text-gray-900 dark:bg-[#0a0a0a] dark:text-gray-100 min-h-screen flex flex-col">
    <Header title={SITE_TITLE} currentPath="/misperlas" />
    <main class="flex-1 w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <article>
        <div class="flex items-center justify-between mb-6">
          <a href="/misperlas" class="text-indigo-600 dark:text-indigo-400 hover:text-indigo-500 dark:hover:text-indigo-300 transition-colors">
            <i class="fa-solid fa-arrow-left"></i>
          </a>
          <a href="/misperlas" class="text-indigo-600 dark:text-indigo-400 hover:text-indigo-500 dark:hover:text-indigo-300 transition-colors">
            <i class="fa-solid fa-arrow-right"></i>
          </a>
        </div>
        <div class="text-center mb-8">
          <h3 class="text-2xl font-bold text-gray-900 dark:text-white ">{title}</h3>
          <div class="w-16 h-1 bg-indigo-500 rounded-full mx-auto mt-3"></div>
        </div>
        <div class="prose prose-lg max-w-none text-[#d31c1c]">
          <slot />
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
